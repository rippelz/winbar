# night light: click cycles the steps, right-click jumps to Off.
# Temperature steps run hyprsunset; the last two steps are Hyprland
# screen shaders — luminance-to-red, then a pure red channel.
# Shaders are applied via night-shader.conf + hyprctl reload, because
# hyprctl keyword doesn't work with lua configs (Hyprland 0.56+).
NIGHT_STATE = os.path.join(CONFIG_DIR, 'night-step')
NIGHT_SHADER = os.path.join(CONFIG_DIR, 'night-red.glsl')
NIGHT_SHADER_REDONLY = os.path.join(CONFIG_DIR, 'night-redonly.glsl')
NIGHT_SHADER_CONF = os.path.expanduser('~/.config/hypr/night-shader.conf')
NIGHT_STEPS = [
    ('Off', None),
    ('Warm', 4200),
    ('Warmer', 3000),
    ('Toasty', 2200),
    ('Ember', 1200),
    ('Red', 'red'),
    ('Red only', 'redonly'),
]
NIGHT_SHADER_SRC = """#version 300 es
precision highp float;
in vec2 v_texcoord;
out vec4 fragColor;
uniform sampler2D tex;
void main() {
    vec4 c = texture(tex, v_texcoord);
    float lum = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));
    fragColor = vec4(lum, 0.0, 0.0, c.a);
}
"""
NIGHT_SHADER_REDONLY_SRC = """#version 300 es
precision highp float;
in vec2 v_texcoord;
out vec4 fragColor;
uniform sampler2D tex;
void main() {
    vec4 c = texture(tex, v_texcoord);
    fragColor = vec4(c.r, 0.0, 0.0, c.a);
}
"""
