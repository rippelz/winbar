def wx_location():
    """User-picked place for wttr.in ('' = locate by IP)."""
    try:
        with open(WX_LOC_FILE) as f:
            return f.read().strip()
    except OSError:
        return ''


def wx_url(loc):
    return f'https://wttr.in/{urllib.parse.quote(loc)}?format=j1'
