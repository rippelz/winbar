#!/usr/bin/env python3
# ============================================================
# winbar-dock — Windows-style grouped taskbar for Hyprland.
#
# Sits on top of the winmode waybar (which reserves the space
# and draws the background) and provides the app area:
#   - pinned + running apps merged (no duplicates)
#   - indicator underline: none = pinned only, grey = running,
#     blue = focused; count badge when multiple windows
#   - left click:  launch / focus / window picker
#   - hover:       thumbnail preview popup, centered above icon
#   - right click: pin / unpin / new window / add to desktop / close
#   - hold + drag icons left/right to reorder (icons shuffle
#     live under the cursor; pinned order persists)
#   - hides while a window is fullscreen on its monitor
#
# Also owns the popups that hang off the bar: alt-tab switcher,
# task view, quick settings, tray overflow, and the Windows 11
# style start menu (search / pinned grid / recommended / all apps
# / power), which replaced the old rofi combi menu.
#
# Thumbnails: whenever a window gains focus it is snapshotted
# with grim (scaled jpeg, atomic rename) into
# ~/.cache/winbar/thumbs so previews show real window content.
#
# Pinned apps:   ~/.config/winbar/pinned.json       (.desktop ids)
# Start menu:    ~/.config/winbar/start-pinned.json (.desktop ids)
# ============================================================

import ctypes
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import urllib.request

# name the process so pgrep/pkill -x winbar-dock works
try:
    libc = ctypes.CDLL('libc.so.6')
    libc.prctl(15, b'winbar-dock', 0, 0, 0)  # PR_SET_NAME
except Exception:
    pass

# ---- AppImage env hygiene ----
# We're often restarted from a terminal that is itself an AppImage (T3-Code
# and friends). Those runtimes export ELECTRON_RUN_AS_NODE=1 and point
# LD_LIBRARY_PATH/PATH at their own /tmp/.mount_* tree. Gio.AppInfo.launch()
# hands our environment to everything we start, so that leakage silently
# breaks any Electron app launched from the bar or start menu: it runs as a
# bare node process and exits without ever drawing a window.
for _var in ('ELECTRON_RUN_AS_NODE', 'APPDIR', 'APPIMAGE', 'ARGV0', 'OWD'):
    os.environ.pop(_var, None)
for _var in ('LD_LIBRARY_PATH', 'LD_PRELOAD', 'PATH',
             'XDG_DATA_DIRS', 'GSETTINGS_SCHEMA_DIR'):
    _val = os.environ.get(_var)
    if not _val:
        continue
    _kept = [p for p in _val.split(':') if p and not p.startswith('/tmp/.mount_')]
    if _kept:
        os.environ[_var] = ':'.join(_kept)
    else:
        os.environ.pop(_var, None)

import warnings
warnings.filterwarnings('ignore', category=DeprecationWarning)

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import (Gtk, Gdk, GLib, Gio, GdkPixbuf,  # noqa: E402
                           GtkLayerShell, Pango)


# ---- theme.css hot-reload (SIGHUP / SIGUSR1 from `theme apply`) ----
# Atomic provider swap so taskbar icons don't vanish for a frame.
_THEME_PROVIDER = None
_THEME_CSS = os.path.expanduser('~/.config/winbar/theme.css')

WALLACCENT_CSS = os.path.expanduser('~/.config/waybar/accent.css')
WALLACCENT_RASI = os.path.expanduser('~/.config/rofi/accent.rasi')


def wallpaper_accent():
    """The accent wallaccent derived from the current wallpaper, if any.

    wallaccent doesn't target winbar, so we just read the files it
    generates for waybar / rofi (both are rewritten on every wallpaper
    change) instead of adding another consumer to it."""
    for path, pat in ((WALLACCENT_CSS,
                       r'@define-color\s+accent\s+(#[0-9a-fA-F]{6})'),
                      (WALLACCENT_RASI,
                       r'accent:\s*(#[0-9a-fA-F]{6})')):
        try:
            with open(path) as f:
                m = re.search(pat, f.read())
            if m:
                return m.group(1)
        except OSError:
            continue
    return None


def accent_css(theme_css):
    """Start-menu accents: wallpaper accent first, else the theme's own.

    theme.css only overrides a handful of classes, so rather than teach
    every theme snapshot about the start menu we fall back to the accent
    it already sets on `.ind.active` (the focused-app underline)."""
    hexcol = wallpaper_accent()
    if not hexcol:
        m = re.search(r'\.ind\.active\s*\{[^}]*background:\s*(#[0-9a-fA-F]{6})',
                      theme_css or '')
        hexcol = m.group(1) if m else '#6cb8ff'
    r, g, b = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
    return f"""
list.stlist row:selected {{ background: rgba({r},{g},{b},0.32); }}
button.stpower:hover {{ background: rgba({r},{g},{b},0.50); }}
.stsearch:focus-within {{ border: 1px solid rgba({r},{g},{b},0.70); }}
.stcat:hover {{ border: 1px solid rgba({r},{g},{b},0.45); }}
.stuser image {{ color: rgba({r},{g},{b},1.0); }}
"""


def load_theme_css():
    """Load/replace ~/.config/winbar/theme.css without restarting the dock."""
    global _THEME_PROVIDER
    screen = Gdk.Screen.get_default()
    if screen is None:
        return False
    nxt = Gtk.CssProvider()
    try:
        css = ''
        if os.path.exists(_THEME_CSS):
            with open(_THEME_CSS) as f:
                css = f.read()
        nxt.load_from_data((css + accent_css(css)).encode())
    except Exception as e:
        print(f'winbar-dock: theme.css load failed: {e}', file=sys.stderr)
        return False
    # add new first, then remove old — no gap with bare styles
    Gtk.StyleContext.add_provider_for_screen(
        screen, nxt, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    if _THEME_PROVIDER is not None:
        try:
            Gtk.StyleContext.remove_provider_for_screen(screen, _THEME_PROVIDER)
        except Exception:
            pass
    _THEME_PROVIDER = nxt
    return True

def _theme_signal(_signum, _frame):
    # GTK is not signal-safe; bounce to main loop
    GLib.idle_add(load_theme_css)

def install_theme_signal_handlers():
    import signal
    signal.signal(signal.SIGHUP, _theme_signal)
    signal.signal(signal.SIGUSR1, _theme_signal)


