# ---- theme.css hot-reload (SIGHUP / SIGUSR1 from `theme apply`) ----
# Atomic provider swap so taskbar icons don't vanish for a frame.
_THEME_PROVIDER = None
_THEME_CSS = os.path.expanduser('~/.config/winbar/theme.css')

WALLACCENT_CSS = os.path.expanduser('~/.config/waybar/accent.css')
WALLACCENT_RASI = os.path.expanduser('~/.config/rofi/accent.rasi')


def wallpaper_accent():
    """The accent wallaccent derived from the current wallpaper, if any.

    wallaccent doesn't target winbar, so we just read the files it
    generates for waybar / rofi (both are rewritten on every wallpaper
    change) instead of adding another consumer to it."""
    for path, pat in ((WALLACCENT_CSS,
                       r'@define-color\s+accent\s+(#[0-9a-fA-F]{6})'),
                      (WALLACCENT_RASI,
                       r'accent:\s*(#[0-9a-fA-F]{6})')):
        try:
            with open(path) as f:
                m = re.search(pat, f.read())
            if m:
                return m.group(1)
        except OSError:
            continue
    return None


def accent_css(theme_css):
    """Start-menu accents: wallpaper accent first, else the theme's own.

    theme.css only overrides a handful of classes, so rather than teach
    every theme snapshot about the start menu we fall back to the accent
    it already sets on `.ind.active` (the focused-app underline)."""
    hexcol = wallpaper_accent()
    if not hexcol:
        m = re.search(r'\.ind\.active\s*\{[^}]*background:\s*(#[0-9a-fA-F]{6})',
                      theme_css or '')
        hexcol = m.group(1) if m else '#6cb8ff'
    r, g, b = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
    # panel tint: mix the accent into the neutral acrylic base (30,30,32);
    # alpha stays at 0.72 so hyprland's ignore_alpha blur still applies
    t = 0.18
    tr, tg, tb = (round(c0 * (1 - t) + c * t)
                  for c0, c in ((30, r), (30, g), (32, b)))
    return f"""
.startcard {{
    background: rgba({tr},{tg},{tb},0.72);
    border: 1px solid rgba({r},{g},{b},0.28);
}}
.stfooter {{
    background: rgba({r},{g},{b},0.08);
    border-top: 1px solid rgba({r},{g},{b},0.18);
}}
list.stlist row:selected {{ background: rgba({r},{g},{b},0.32); }}
button.stpower:hover {{ background: rgba({r},{g},{b},0.50); }}
.stsearch:focus-within {{ border: 1px solid rgba({r},{g},{b},0.70); }}
.stcat:hover {{ border: 1px solid rgba({r},{g},{b},0.45); }}
.stuser image {{ color: rgba({r},{g},{b},1.0); }}
.wxcard {{
    background: rgba({tr},{tg},{tb},0.72);
    border: 1px solid rgba({r},{g},{b},0.28);
}}
.wxfooter {{
    background: rgba({r},{g},{b},0.08);
    border-top: 1px solid rgba({r},{g},{b},0.18);
}}
.wxhour.now {{ background: rgba({r},{g},{b},0.22); }}
.wxpin {{ color: rgba({r},{g},{b},1.0); }}
.wxsearch {{ border: 1px solid rgba({r},{g},{b},0.70); }}
.wxcard .clkday.clktoday {{
    background: rgb({r},{g},{b}); color: #101216; font-weight: 700;
}}
.netglyph.online {{
    color: rgb({r},{g},{b}); background: rgba({r},{g},{b},0.16);
}}
.netwglyph.online {{ color: rgb({r},{g},{b}); }}
.wxcard .netrate.down {{ color: rgb({r},{g},{b}); }}
button.wxtoggle.on {{ background: rgb({r},{g},{b}); }}
button.wxtoggle.on:hover {{ background: rgba({r},{g},{b},0.85); }}
.qscard {{
    background: rgba({tr},{tg},{tb},0.72);
    border: 1px solid rgba({r},{g},{b},0.28);
}}
menu, .menu {{
    background: rgba({tr},{tg},{tb},0.98);
    border: 1px solid rgba({r},{g},{b},0.28);
    border-radius: 8px; padding: 4px; color: #f3f3f3;
}}
menu label, .menu label {{ font-family: "Noto Sans", sans-serif; font-size: 12.5px; }}
menu menuitem {{ padding: 5px 12px; border-radius: 5px; }}
menu menuitem:hover, .menu menuitem:hover {{
    background: rgba({r},{g},{b},0.22);
}}
menu menuitem:disabled label {{ color: rgba(255,255,255,0.40); }}
menu separator {{
    background: rgba({r},{g},{b},0.22); min-height: 1px; margin: 4px 6px;
}}
"""


def load_theme_css():
    """Load/replace ~/.config/winbar/theme.css without restarting the dock."""
    global _THEME_PROVIDER
    screen = Gdk.Screen.get_default()
    if screen is None:
        return False
    nxt = Gtk.CssProvider()
    try:
        css = ''
        if os.path.exists(_THEME_CSS):
            with open(_THEME_CSS) as f:
                css = f.read()
        nxt.load_from_data((css + accent_css(css)).encode())
    except Exception as e:
        print(f'winbar-dock: theme.css load failed: {e}', file=sys.stderr)
        return False
    # add new first, then remove old — no gap with bare styles
    Gtk.StyleContext.add_provider_for_screen(
        screen, nxt, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    if _THEME_PROVIDER is not None:
        try:
            Gtk.StyleContext.remove_provider_for_screen(screen, _THEME_PROVIDER)
        except Exception:
            pass
    _THEME_PROVIDER = nxt
    return True

def _theme_signal(_signum, _frame):
    # GTK is not signal-safe; bounce to main loop
    GLib.idle_add(load_theme_css)

def install_theme_signal_handlers():
    import signal
    signal.signal(signal.SIGHUP, _theme_signal)
    signal.signal(signal.SIGUSR1, _theme_signal)


_THEME_MONITORS = []
_theme_reload_pending = False

def install_theme_file_monitors():
    """Reload when wallaccent / theme apply rewrite their files.

    wallaccent is a binary that never signals us, so watch the files it
    writes. Monitor the parent dirs: atomic rename-writes swap the inode
    out from under a per-file monitor."""
    watched = {}
    for path in (_THEME_CSS, WALLACCENT_CSS, WALLACCENT_RASI):
        watched.setdefault(os.path.dirname(path), set()).add(
            os.path.basename(path))

    def debounced():
        global _theme_reload_pending
        _theme_reload_pending = False
        load_theme_css()
        return False

    def changed(_mon, f, other, _event, names):
        global _theme_reload_pending
        # rename-writes report the temp file as `f`, the target as `other`
        hit = any(x and x.get_basename() in names for x in (f, other))
        if hit and not _theme_reload_pending:
            _theme_reload_pending = True
            GLib.timeout_add(150, debounced)

    for d, names in watched.items():
        try:
            mon = Gio.File.new_for_path(d).monitor_directory(
                Gio.FileMonitorFlags.WATCH_MOVES, None)
        except GLib.Error as e:
            print(f'winbar-dock: cannot watch {d}: {e}', file=sys.stderr)
            continue
        mon.connect('changed', changed, names)
        _THEME_MONITORS.append(mon)  # keep alive


