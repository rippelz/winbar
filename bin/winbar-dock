def hyprctl(*args, want_json=False):
    cmd = ['hyprctl'] + (['-j'] if want_json else []) + list(args)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
        return json.loads(out) if want_json else out
    except Exception:
        return [] if want_json else ''


def _lua_str(s):
    """Quote a string for embedding in a hyprctl Lua dispatch expression."""
    return '"' + str(s).replace('\\', '\\\\').replace('"', '\\"') + '"'


def dispatch(*args):
    """Send a dispatcher. Accepts legacy names (focuswindow, …) or raw Lua
    (hl.dsp.…). Legacy forms are translated for Hyprland 0.56+ Lua configs,
    where `hyprctl dispatch focuswindow …` is no longer valid syntax.
    """
    if not args:
        return
    first = str(args[0])
    if first.startswith('hl.') or first.startswith('return '):
        hyprctl('dispatch', first if len(args) == 1 else ' '.join(str(a) for a in args))
        return

    cmd = first
    arg = args[1] if len(args) > 1 else ''
    if len(args) > 2:
        arg = ','.join(str(a) for a in args[1:])
    arg = str(arg).strip()

    def win_sel(s):
        s = s.strip()
        if not s:
            return None
        # "address:0x…", "class:foo", or bare address
        if s.startswith('address:') or s.startswith('class:') or s.startswith('title:'):
            return s
        if s.startswith('0x') or s.startswith('0X'):
            return f'address:{s}'
        return s

    lua = None
    if cmd == 'focuswindow':
        w = win_sel(arg)
        if w:
            lua = f'hl.dsp.focus({{window = {_lua_str(w)}}})'
    elif cmd == 'closewindow':
        w = win_sel(arg)
        if w:
            lua = f'hl.dsp.window.close({{window = {_lua_str(w)}}})'
        else:
            lua = 'hl.dsp.window.close()'
    elif cmd in ('movetoworkspacesilent', 'movetoworkspace'):
        # "WS,address:0x…" or "WS,class:…"
        parts = [p.strip() for p in arg.split(',', 1)]
        ws = parts[0] if parts else ''
        w = win_sel(parts[1]) if len(parts) > 1 else None
        silent = cmd.endswith('silent')
        # numeric workspaces as numbers, special: names as strings
        try:
            ws_lit = str(int(ws))
        except (TypeError, ValueError):
            ws_lit = _lua_str(ws)
        bits = [f'workspace = {ws_lit}']
        if w:
            bits.append(f'window = {_lua_str(w)}')
        if silent:
            bits.append('silent = true')
        lua = f'hl.dsp.window.move({{{", ".join(bits)}}})'
    elif cmd == 'workspace':
        try:
            lua = f'hl.dsp.focus({{workspace = {int(arg)}}})'
        except (TypeError, ValueError):
            lua = f'hl.dsp.focus({{workspace = {_lua_str(arg)}}})'
    elif cmd == 'alterzorder':
        # "top,address:0x…"
        parts = [p.strip() for p in arg.split(',', 1)]
        mode = parts[0] if parts else 'top'
        w = win_sel(parts[1]) if len(parts) > 1 else None
        if w:
            lua = f'hl.dsp.window.bring_to_top({{window = {_lua_str(w)}}})'
        else:
            lua = 'hl.dsp.window.bring_to_top()'
    elif cmd == 'setfloating':
        w = win_sel(arg.replace('address:', '') if arg.startswith('address:') else arg)
        # arg is often "address:0x…"
        w = win_sel(arg)
        if w:
            lua = f'hl.dsp.window.float({{action = "set", window = {_lua_str(w)}}})'
    elif cmd == 'settiled':
        w = win_sel(arg)
        if w:
            lua = f'hl.dsp.window.float({{action = "unset", window = {_lua_str(w)}}})'
    elif cmd == 'fullscreen':
        # "1,address:0x…" or "0,address:…"
        parts = [p.strip() for p in arg.split(',', 1)]
        mode = parts[0] if parts else '0'
        w = win_sel(parts[1]) if len(parts) > 1 else None
        action = 'set' if mode not in ('0', 'toggle') else ('toggle' if mode == 'toggle' else 'unset')
        bits = [f'action = {_lua_str(action)}']
        if w:
            bits.append(f'window = {_lua_str(w)}')
        lua = f'hl.dsp.window.fullscreen({{{", ".join(bits)}}})'
    elif cmd == 'fullscreenstate':
        # "0 0,address:0x…"
        left, _, right = arg.partition(',')
        nums = left.split()
        internal = int(nums[0]) if nums else 0
        client = int(nums[1]) if len(nums) > 1 else 0
        w = win_sel(right) if right else None
        bits = [f'internal = {internal}', f'client = {client}', 'action = "set"']
        if w:
            bits.append(f'window = {_lua_str(w)}')
        lua = f'hl.dsp.window.fullscreen_state({{{", ".join(bits)}}})'
    elif cmd == 'killactive':
        lua = 'hl.dsp.window.close()'
    elif cmd == 'cyclenext':
        # prev as optional arg
        if arg == 'prev':
            lua = 'hl.dsp.window.cycle_next({prev = true})'
        else:
            lua = 'hl.dsp.window.cycle_next()'

    if lua:
        hyprctl('dispatch', lua)
    else:
        # last resort: join as legacy (may fail on Lua-only configs)
        hyprctl('dispatch', *args)


def desktop_info(desktop_id):
    """Gio.DesktopAppInfo.new that returns None instead of raising."""
    try:
        return Gio.DesktopAppInfo.new(desktop_id)
    except TypeError:
        return None


def all_apps():
    """Every launchable app, sorted by display name."""
    apps = [a for a in Gio.AppInfo.get_all()
            if a.should_show() and a.get_display_name()]
    apps.sort(key=lambda a: a.get_display_name().lower())
    return apps


_ICON_OK = {}


def has_real_icon(app):
    """True if the app's icon actually resolves in the icon theme.

    Category previews look broken when a third of the tiles are the
    generic "missing image" glyph, so those apps get sorted to the back."""
    key = app.get_id() or app.get_display_name() or ''
    if key in _ICON_OK:
        return _ICON_OK[key]
    icon = app.get_icon()
    ok = False
    try:
        if isinstance(icon, Gio.ThemedIcon):
            theme = Gtk.IconTheme.get_default()
            ok = any(theme.has_icon(n) for n in icon.get_names())
        elif isinstance(icon, Gio.FileIcon):
            ok = os.path.exists(icon.get_file().get_path() or '')
        else:
            ok = icon is not None
    except Exception:
        ok = False
    _ICON_OK[key] = ok
    return ok


def recency_table():
    """{desktop-id: last-used epoch} from the app-recency daemon."""
    try:
        with open(os.path.expanduser(
                '~/.local/state/app-recency.json')) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    out = {}
    for k, v in (data.items() if isinstance(data, dict) else []):
        if isinstance(v, dict):
            v = v.get('last') or v.get('ts') or 0
        try:
            out[k] = float(v)
        except (TypeError, ValueError):
            continue
    return out


def match_score(app, needle, recency):
    """Rank a search hit: prefix > word start > substring, then recency."""
    name = (app.get_display_name() or '').lower()
    if name.startswith(needle):
        base = 0
    elif any(w.startswith(needle) for w in name.split()):
        base = 1
    elif needle in name:
        base = 2
    elif needle in (app.get_executable() or '').lower():
        base = 3
    else:
        return None
    return (base, -recency.get(app.get_id() or '', 0), name)


def recent_files(limit):
    """Recently-opened files/folders, newest first.

    Reads GTK's recently-used.xbel and KDE's RecentDocuments — same two
    sources the old rofi `recent` script mode used."""
    import datetime
    import glob
    import urllib.parse
    import xml.etree.ElementTree as ET

    items = {}
    if os.path.exists(RECENT_XBEL):
        try:
            for b in ET.parse(RECENT_XBEL).getroot().findall('bookmark'):
                href = b.get('href', '')
                if not href.startswith('file://'):
                    continue
                path = urllib.parse.unquote(href[7:])
                if os.path.exists(path):
                    items[path] = max(items.get(path, ''), b.get('modified', ''))
        except Exception:
            pass

    for d in glob.glob(os.path.join(RECENT_KDE, '*.desktop')):
        try:
            target = None
            for line in open(d, errors='ignore'):
                if line.startswith('URL') and '=' in line:
                    url = line.split('=', 1)[1].strip()
                    url = url.replace('$HOME', os.path.expanduser('~'))
                    if url.startswith('file://'):
                        url = urllib.parse.unquote(url[7:])
                    target = url
                    break
            if target and os.path.exists(target):
                m = datetime.datetime.fromtimestamp(
                    os.path.getmtime(d)).isoformat()
                items[target] = max(items.get(target, ''), m)
        except Exception:
            continue

    ordered = sorted(items.items(), key=lambda kv: kv[1], reverse=True)
    return [p for p, _ in ordered[:limit]]


def file_gicon(path):
    try:
        return Gio.File.new_for_path(path).query_info(
            'standard::icon', Gio.FileQueryInfoFlags.NONE, None).get_icon()
    except Exception:
        return Gio.ThemedIcon.new('text-x-generic')


def pretty_path(path):
    home = os.path.expanduser('~')
    d = os.path.dirname(path) or '/'
    return d.replace(home, '~', 1) if d.startswith(home) else d


def desktop_shortcut_path(info):
    """Where this app's shortcut would live on the desktop (or None)."""
    src = info.get_filename() if info else None
    if not src:
        return None
    return os.path.join(DESKTOP_DIR, os.path.basename(src))


def add_to_desktop(info):
    """Copy an app's .desktop onto ~/Desktop as a launcher shortcut."""
    src = info.get_filename() if info else None
    dest = desktop_shortcut_path(info)
    if not dest:
        return False
    try:
        os.makedirs(DESKTOP_DIR, exist_ok=True)
        shutil.copyfile(src, dest)
        os.chmod(dest, 0o755)      # file managers only trust +x launchers
        return True
    except OSError as e:
        print(f'winbar-dock: add to desktop failed: {e}', file=sys.stderr)
        return False


def link_to_desktop(path):
    """Put a file/folder on the desktop as a symlink (no copy: recents
    can be multi-GB videos)."""
    dest = os.path.join(DESKTOP_DIR, os.path.basename(path.rstrip('/')))
    try:
        os.makedirs(DESKTOP_DIR, exist_ok=True)
        if not os.path.lexists(dest):
            os.symlink(path, dest)
        return True
    except OSError as e:
        print(f'winbar-dock: link to desktop failed: {e}', file=sys.stderr)
        return False


def thumb_path(addr):
    return os.path.join(THUMB_DIR, addr.replace('0x', '') + '.jpg')


def norm_addr(addr):
    """Normalize hyprland window addresses to 0x... form."""
    if not addr:
        return None
    a = str(addr).strip()
    if a.startswith('0x') or a.startswith('0X'):
        return '0x' + a[2:]
    return '0x' + a


def is_minimized_ws(ws):
    if not isinstance(ws, dict):
        return False
    name = ws.get('name') or ''
    return name == MINIMIZED_WS or name.endswith(':minimized')


class AppResolver:
    """window class -> Gio.DesktopAppInfo, plus an icon of last resort.

    Plain class/StartupWMClass/exec matching misses a lot: Steam games
    (class steam_app_<id>), Wine/Proton apps (class foo.exe, launched via
    "env WINEPREFIX=... wine ...foo.exe"), flatpaks and anything whose
    binary name differs from its class. Those fall through to the
    process (SteamAppId / FLATPAK_ID / argv[0]) and finally to the
    window's own X11 _NET_WM_ICON, cached as a png."""

    def __init__(self):
        self.cache = {}
        self.icon_cache = {}
        self.icon_miss = {}
        self.by_wmclass = {}
        self.by_exec = {}
        self.by_exe = {}        # wine: "foo.exe" -> info
        self.by_steam = {}      # "252950" -> info
        self.by_name = {}
        for info in Gio.DesktopAppInfo.get_all():
            wmc = info.get_startup_wm_class()
            if wmc:
                self.by_wmclass.setdefault(wmc.lower(), info)
            exe = info.get_executable()
            if exe:
                self.by_exec.setdefault(os.path.basename(exe).lower(), info)
            cmd = info.get_commandline() or ''
            m = re.search(r'rungameid/(\d+)', cmd)
            if m:
                self.by_steam.setdefault(m.group(1), info)
            icon = info.get_string('Icon') or ''
            m = re.fullmatch(r'steam_icon_(\d+)', icon)
            if m:
                self.by_steam.setdefault(m.group(1), info)
            for m in re.finditer(r'([^\\/"\' ]+\.exe)\b', cmd, re.I):
                self.by_exe.setdefault(m.group(1).lower(), info)
            name = re.sub(r'[^a-z0-9]', '', (info.get_name() or '').lower())
            if name:
                self.by_name.setdefault(name, info)

    def resolve(self, cls, pid=None):
        if cls in self.cache:
            return self.cache[cls]
        info = None
        for cand in (cls, cls.lower(), cls.capitalize()):
            info = desktop_info(cand + '.desktop')
            if info:
                break
        low = cls.lower()
        if not info:
            info = self.by_wmclass.get(low)
        if not info:
            info = self.by_exec.get(low)
        if not info:
            m = re.fullmatch(r'steam_app_(\d+)', low)
            if m:
                info = self.by_steam.get(m.group(1))
        if not info and low.endswith('.exe'):
            info = (self.by_exe.get(low)
                    or self.by_name.get(re.sub(r'[^a-z0-9]', '', low[:-4])))
        if not info and pid:
            info = self._from_proc(pid, wine=low.endswith('.exe'))
        if not info and not low.endswith('.exe'):
            info = self.by_name.get(re.sub(r'[^a-z0-9]', '', low))
        self.cache[cls] = info
        return info

    def _from_proc(self, pid, wine=False):
        try:
            with open(f'/proc/{pid}/environ', 'rb') as f:
                env = dict(kv.split(b'=', 1) for kv in f.read().split(b'\0')
                           if b'=' in kv)
        except OSError:
            env = {}
        sid = (env.get(b'SteamAppId') or env.get(b'SteamGameId') or b'').decode()
        if sid and sid != '0' and sid in self.by_steam:
            return self.by_steam[sid]
        if wine:
            return None   # the flatpak/runner (Vinegar, Bottles) isn't the app
        fid = env.get(b'FLATPAK_ID', b'').decode()
        if fid:
            info = desktop_info(fid + '.desktop')
            if info:
                return info
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                argv0 = f.read().split(b'\0')[0].decode(errors='ignore')
            return self.by_exec.get(os.path.basename(argv0).lower())
        except OSError:
            return None

    def fallback_icon(self, cls):
        """GIcon for a class with no .desktop: steam_icon_<id>, the class as
        a theme icon, or the window's own X11 icon. None if nothing real."""
        if cls in self.icon_cache:
            return self.icon_cache[cls]
        if time.time() - self.icon_miss.get(cls, 0) < 5:
            return None
        icon = None
        theme = Gtk.IconTheme.get_default()
        m = re.fullmatch(r'steam_app_(\d+)', cls.lower())
        names = ([f'steam_icon_{m.group(1)}'] if m else []) + [cls, cls.lower()]
        for n in names:
            if n and theme.has_icon(n):
                icon = Gio.ThemedIcon.new(n)
                break
        if icon is None:
            path = x11_icon_png(cls)
            if path:
                icon = Gio.FileIcon.new(Gio.File.new_for_path(path))
        if icon is not None:
            self.icon_cache[cls] = icon
        else:   # X windows may not have set an icon yet: retry later
            self.icon_miss[cls] = time.time()
        return icon


X_ICON_DIR = os.path.expanduser('~/.cache/winbar/icons')


def x11_icon_png(cls):
    """Pull _NET_WM_ICON off an Xwayland window of this class and cache the
    biggest non-blank image as a png. Wine sets it from the .exe's icon."""
    out = os.path.join(X_ICON_DIR, re.sub(r'[^\w.-]', '_', cls) + '.png')
    try:
        if os.path.getsize(out) > 0:
            return out
    except OSError:
        pass
    try:
        lst = subprocess.run(['xprop', '-root', '_NET_CLIENT_LIST'],
                             capture_output=True, text=True, timeout=1).stdout
    except Exception:
        return None
    best = None
    for wid in re.findall(r'0x[0-9a-f]+', lst):
        try:
            r = subprocess.run(['xprop', '-id', wid, '-notype', 'WM_CLASS',
                                '32c', '_NET_WM_ICON'],
                               capture_output=True, text=True, timeout=1).stdout
        except Exception:
            continue
        mc = re.search(r'WM_CLASS\s*=\s*(.*)', r)
        if not mc or cls.lower() not in [x.lower() for x in
                                          re.findall(r'"([^"]*)"', mc.group(1))]:
            continue
        mi = re.search(r'_NET_WM_ICON\s*=\s*([\d,\s]+)', r)
        if not mi:
            continue
        nums = [int(x) for x in re.findall(r'\d+', mi.group(1))]
        i = 0
        while i + 2 <= len(nums):
            w, h = nums[i], nums[i + 1]
            px = nums[i + 2:i + 2 + w * h]
            i += 2 + w * h
            if not w or len(px) != w * h or not any(p >> 24 for p in px):
                continue
            if best is None or w * h > best[0] * best[1]:
                best = (w, h, px)
    if not best:
        return None
    w, h, px = best
    data = bytearray()
    for p in px:   # ARGB cardinal -> RGBA bytes
        data += bytes(((p >> 16) & 255, (p >> 8) & 255, p & 255, (p >> 24) & 255))
    try:
        pb = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(data)),
                                             GdkPixbuf.Colorspace.RGB, True,
                                             8, w, h, w * 4)
        os.makedirs(X_ICON_DIR, exist_ok=True)
        pb.savev(out + '.tmp', 'png', [], [])
        os.replace(out + '.tmp', out)
        return out
    except Exception:
        return None


class MirrorStrip(Gtk.Window):
    """The app strip on a secondary monitor: same groups and order as the
    main dock, its own buttons. All interaction is handled by the Dock."""

    def __init__(self, mon):
        super().__init__(title='winbar-dock')
        self.mon_name = mon.get('name')
        self.mon_id = mon.get('id')
        self.mon_x = mon.get('x', 0)
        self.mon_y = mon.get('y', 0)
        self.mon_w = mon.get('width', 1920)
        self.mon_h = mon.get('height', 1080)
        self.buttons = {}
        LS = GtkLayerShell
        LS.init_for_window(self)
        LS.set_layer(self, LS.Layer.OVERLAY)
        LS.set_anchor(self, LS.Edge.LEFT, True)
        LS.set_anchor(self, LS.Edge.BOTTOM, True)
        LS.set_margin(self, LS.Edge.LEFT, MARGIN_LEFT)
        LS.set_exclusive_zone(self, -1)
        LS.set_namespace(self, 'winbar-dock')
        self.gdk_mon = Gdk.Display.get_default().get_monitor_at_point(
            self.mon_x + 1, self.mon_y + 1)
        if self.gdk_mon:
            LS.set_monitor(self, self.gdk_mon)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.box.set_size_request(-1, BAR_HEIGHT)
        self.add(self.box)
        self.show_all()


class Dock(Gtk.Window):
    def __init__(self):
        super().__init__(title='winbar-dock')
        self.resolver = AppResolver()
        self.active_addr = None
        self.pinned = self.load_pinned()
        self.order = []            # display order of group keys
        self.buttons = {}          # key -> Gtk.Button
        self.groups = {}
        self.clients_by_addr = {}

        # preview window (single, managed)
        self.preview = None
        self.preview_box = None
        self.pop_key = None
        self.fill_sig = None
        self.over_button = False
        self.over_pop = False
        self.hover_timer = None
        self.hide_timer = None
        self.thumb_cache = {}      # addr -> (mtime, scaled pixbuf)

        # manual drag-reorder state
        self.press_key = None
        self.press_x = 0
        self.drag_active = False

        self.thumb_timer = None
        self.capture_proc = None
        self.capture_addr = None
        self.refresh_pending = False

        # alt-tab switcher state
        self.att_win = None
        self.att_box = None
        self.att_list = []
        self.att_cards = []
        self.att_sel = 0

        # tray overflow (hide-to-tray apps)
        self.tray_apps = self.load_tray()
        self.tray_groups = {}
        self.tray_pop = None
        self.tray_menus = []       # DbusmenuGtk3 menus alive with the popup

        self.popup_focus = None    # focused window when a popup opened

        # internet + clock flyouts
        self.net_win = None
        self.net_timer = None
        self.net = {}
        self.net_public = None      # cached for the session
        # throughput is sampled all session (one /proc read a second) so the
        # flyout graph already has history when it opens
        self.nstat = dict(live=[], buckets=[], span=1, cur=[0, 0, 0.0],
                          last=None, start=time.time(), rx=0, tx=0)
        self.net_view = 'session'
        self._nstat_sample()
        GLib.timeout_add_seconds(1, self._nstat_sample)
        self.clk_win = None
        self.clk_timer = None
        self.clk = {}

        # weather flyout
        self.wx_win = None
        self.wx_body = None
        self.wx_fetching = False
        self.wx_editing = False
        self.wx_error = None

        # quick settings panel
        self.qs_win = None
        self.qs_panel = None
        self.qs_timer = None
        self.qs_setting = False   # guard: slider updated by code, not user
        self.md = {}
        self.md_pick = None       # chosen MPRIS player (sticky)
        self.md_info = {}         # player -> identity / caps cache
        self.md_timer = None
        self.md_css = None
        self.qs_widgets = {}
        self.art_cache = {}       # url -> pixbuf
        self.rgb_busy = False
        self.rgb_error = ''
        self.night_step = self._night_load()

        # start menu (in-process, click-off backdrop)
        self.start_win = None
        self.start_pinned = []
        self.st = {}            # transient start-menu widget refs

        # task view overlay
        self.tv_win = None
        self.tv_box = None

        # minimized windows: addr -> {workspace, ws_name}
        self.minimized = self.load_minimized()

        if START_ONLY:
            self._start_only_init()
            return

        os.makedirs(THUMB_DIR, exist_ok=True)
        os.makedirs(os.path.dirname(MINIMIZED_FILE), exist_ok=True)
        for f in os.listdir(THUMB_DIR):   # stale thumbs from last session
            try:
                os.unlink(os.path.join(THUMB_DIR, f))
            except OSError:
                pass

        # dock's monitor (leftmost/primary) geometry
        self.mon_id = 0
        self.mon_x = 0
        self.mon_y = 0
        self.mon_w = 2560
        self.mon_h = 1440
        # addr -> {dir: 'min'|'rest', timers: [id...], meta: dict, focus: bool}
        self._anim = {}
        self._last_anim_addr = None  # Super+M spam reverses this mid-flight
        # nestable guard: freeze cursor warps while windows fly to the bar
        self._warp_guard = 0
        for m in hyprctl('monitors', want_json=True) or []:
            if m.get('x') == 0 and m.get('y') == 0:
                self.mon_id = m.get('id', 0)
                self.mon_x = m.get('x', 0)
                self.mon_y = m.get('y', 0)
                self.mon_w = m.get('width', 2560)
                self.mon_h = m.get('height', 1440)
                break

        # --- layer shell setup ---
        # OVERLAY (same as winmode waybar): icons must paint above the
        # bar strip. Mapped after waybar so within-layer z-order wins.
        LS = GtkLayerShell
        LS.init_for_window(self)
        LS.set_layer(self, LS.Layer.OVERLAY)
        LS.set_anchor(self, LS.Edge.LEFT, True)
        LS.set_anchor(self, LS.Edge.BOTTOM, True)
        LS.set_margin(self, LS.Edge.LEFT, MARGIN_LEFT)
        LS.set_exclusive_zone(self, -1)  # overlap the waybar strip
        LS.set_namespace(self, 'winbar-dock')
        display = Gdk.Display.get_default()
        self.gdk_mon = display.get_monitor_at_point(0, 0)
        if self.gdk_mon:
            LS.set_monitor(self, self.gdk_mon)

        # --- transparency ---
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # per-theme color overrides — hot-swapped on SIGHUP (no process kill)
        load_theme_css()

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.box.set_size_request(-1, BAR_HEIGHT)
        self.add(self.box)

        self.connect('destroy', Gtk.main_quit)
        self.strips = [self]       # this dock + one MirrorStrip per extra monitor
        self.preview_strip = None
        self.sync_mirrors()
        self.listen_events()
        self.listen_ctrl()
        self.refresh()
        self.show_all()
        GLib.timeout_add(600, self._capture_active_thumb)  # first snapshot

    def _start_only_init(self):
        """winbar-start: no strip, no events, just the menu. A second
        Super+R reaches us over START_SOCK and closes it; closing exits."""
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        load_theme_css()
        try:
            os.unlink(START_SOCK)
        except OSError:
            pass
        self.ctrl_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.ctrl_sock.bind(START_SOCK)
        self.ctrl_sock.setblocking(False)
        GLib.io_add_watch(self.ctrl_sock.fileno(), GLib.IO_IN, self.on_ctrl)
        self.start_toggle()

    # ---------- pinned persistence ----------
    def load_pinned(self):
        try:
            with open(PINNED_FILE) as f:
                return json.load(f)
        except Exception:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            pins = [p for p in DEFAULT_PINNED if desktop_info(p)]
            with open(PINNED_FILE, 'w') as f:
                json.dump(pins, f, indent=2)
            return pins

    def load_minimized(self):
        try:
            with open(MINIMIZED_FILE) as f:
                raw = json.load(f)
            return {norm_addr(k): v for k, v in raw.items() if norm_addr(k)}
        except Exception:
            return {}

    def save_minimized(self):
        try:
            os.makedirs(os.path.dirname(MINIMIZED_FILE), exist_ok=True)
            with open(MINIMIZED_FILE, 'w') as f:
                json.dump(self.minimized, f, indent=2)
        except Exception:
            pass

    def save_pinned(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(PINNED_FILE, 'w') as f:
            json.dump(self.pinned, f, indent=2)

    def load_tray(self):
        try:
            with open(TRAY_FILE) as f:
                return json.load(f)
        except Exception:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(TRAY_FILE, 'w') as f:
                json.dump(DEFAULT_TRAY, f, indent=2)
            return list(DEFAULT_TRAY)

    def save_tray(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(TRAY_FILE, 'w') as f:
            json.dump(self.tray_apps, f, indent=2)

    # ---------- hyprland events ----------
    def sync_mirrors(self):
        """One app strip per non-primary monitor (hotplug-aware)."""
        mons = {m.get('name'): m for m in hyprctl('monitors', want_json=True) or []
                if m.get('id') != self.mon_id and not m.get('disabled')}
        for s in list(self.strips[1:]):
            m = mons.pop(s.mon_name, None)
            if m and (m.get('id'), m.get('x'), m.get('y'), m.get('width'),
                      m.get('height')) == (s.mon_id, s.mon_x, s.mon_y,
                                           s.mon_w, s.mon_h):
                continue
            if m:
                mons[s.mon_name] = m       # geometry changed: rebuild it
            if self.preview_strip is s:
                self.close_preview()
                self.preview_strip = None
            self.strips.remove(s)
            s.destroy()
        for m in mons.values():
            self.strips.append(MirrorStrip(m))

    def listen_events(self):
        sig = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE')
        run = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        path = f'{run}/hypr/{sig}/.socket2.sock'
        self.evsock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.evsock.connect(path)
        self.evsock.setblocking(False)
        self.evbuf = b''
        GLib.io_add_watch(self.evsock.fileno(),
                          GLib.IO_IN | GLib.IO_HUP, self.on_event)

    def on_event(self, fd, cond):
        if cond & GLib.IO_HUP:
            Gtk.main_quit()
            return False
        try:
            self.evbuf += self.evsock.recv(8192)
        except BlockingIOError:
            return True
        while b'\n' in self.evbuf:
            line, self.evbuf = self.evbuf.split(b'\n', 1)
            ev = line.decode(errors='ignore')
            kind = ev.split('>>')[0]
            if kind in ('monitoradded', 'monitorremoved',
                        'monitoraddedv2', 'monitorremovedv2'):
                GLib.timeout_add(500, lambda: (self.sync_mirrors(),
                                               self.refresh(), False)[-1])
            elif kind == 'activewindowv2':
                addr = ev.split('>>', 1)[1].strip()
                self.active_addr = ('0x' + addr) if addr and addr != ',' else None
                if self.active_addr and self.active_addr != self.popup_focus:
                    self.close_bar_popups()
                self.schedule_thumb()
                self.schedule_refresh()
            elif kind == 'closewindow':
                addr = '0x' + ev.split('>>', 1)[1].strip()
                self.thumb_cache.pop(addr, None)
                self.minimized.pop(addr, None)
                self.save_minimized()
                try:
                    os.unlink(thumb_path(addr))
                except OSError:
                    pass
                self.schedule_refresh()
            elif kind == 'minimized':
                # titlebar minimize (via hypr-minimize plugin) or foreign-toplevel
                # payload: "addr,1" or "addr,0"
                # Games (Geometry Dash etc.) request minimize on focus-out —
                # only honor when the window is still focused (real titlebar
                # click). Super+M uses the control socket, not this path.
                payload = ev.split('>>', 1)[1].strip()
                parts = payload.split(',')
                if len(parts) >= 2:
                    addr = norm_addr(parts[0])
                    if parts[1].strip() in ('1', 'true'):
                        active = norm_addr(self.active_addr)
                        if not active:
                            aw = hyprctl('activewindow', want_json=True) or {}
                            active = norm_addr(aw.get('address'))
                        if active and addr != active:
                            continue
                        # Games (Rocket League) also fire minimize while still
                        # focused (on ball/shot reset). Never honor those for
                        # Steam games or fullscreen windows (no titlebar anyway).
                        c = self._client(addr) or {}
                        if ((c.get('class') or '').startswith('steam_app_')
                                or int(c.get('fullscreen') or 0)):
                            continue
                        self.minimize_window(addr)
                    else:
                        self.restore_window(addr)
            elif kind in ('openwindow', 'movewindow', 'movewindowv2',
                          'fullscreen',
                          'windowtitle', 'windowtitlev2',
                          'workspace', 'workspacev2',
                          'focusedmon', 'activespecial'):
                self.schedule_refresh()
        return True

    # ---------- control socket (commands from ~/.local/bin/winbar-alttab) ----
    def listen_ctrl(self):
        try:
            os.unlink(CTRL_SOCK)
        except OSError:
            pass
        self.ctrl_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.ctrl_sock.bind(CTRL_SOCK)
        self.ctrl_sock.setblocking(False)
        GLib.io_add_watch(self.ctrl_sock.fileno(), GLib.IO_IN, self.on_ctrl)

    def on_ctrl(self, fd, cond):
        try:
            cmd = self.ctrl_sock.recv(64).decode(errors='ignore').strip()
        except BlockingIOError:
            return True
        if cmd == 'next':
            self.alttab_step(1)
        elif cmd == 'prev':
            self.alttab_step(-1)
        elif cmd == 'commit':
            self.alttab_commit()
        elif cmd == 'cancel':
            self.alttab_cancel()
        elif cmd == 'tray':
            self.tray_toggle()
        elif cmd == 'quick':
            self.quick_toggle()
        elif cmd == 'weather':
            self.wx_toggle()
        elif cmd == 'net':
            self.net_toggle()
        elif cmd == 'clock':
            self.clk_toggle()
        elif cmd == 'weather-location':
            if not self.wx_win:
                self.wx_toggle()
            self.wx_start_edit()
        elif cmd == 'taskview':
            self.taskview_toggle()
        elif cmd == 'start':
            self.start_toggle()
        elif cmd == 'minimize':
            # Super+M: toggle / reverse mid-animation if spammed
            addr = self.active_addr
            if not addr:
                aw = hyprctl('activewindow', want_json=True) or {}
                addr = aw.get('address')
            self.toggle_minimize(addr)
        return True

    # ---------- ALT+TAB switcher (overlay layer, above fullscreen) ----------
    def ensure_alttab(self):
        if self.att_win:
            return
        LS = GtkLayerShell
        w = Gtk.Window(title='winbar-alttab')
        LS.init_for_window(w)
        LS.set_layer(w, LS.Layer.OVERLAY)
        LS.set_namespace(w, 'winbar-alttab')
        # no anchors -> compositor centers it on the monitor

        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        w.set_app_paintable(True)

        outer = Gtk.Box()
        outer.get_style_context().add_class('previewcard')
        self.att_box = Gtk.FlowBox()
        self.att_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.att_box.set_homogeneous(True)
        self.att_box.set_column_spacing(8)
        self.att_box.set_row_spacing(8)
        for m in ('top', 'bottom', 'start', 'end'):
            getattr(self.att_box, f'set_margin_{m}')(12)
        outer.add(self.att_box)
        w.add(outer)
        self.att_win = w

    def alttab_step(self, step):
        # session already open: just move the selection
        if self.att_win and self.att_win.get_visible():
            if self.att_list:
                self.att_sel = (self.att_sel + step) % len(self.att_list)
                self.alttab_update_sel()
            return

        # start a new session: only windows on the workspaces currently
        # visible on the monitors, most-recently-used first
        visible_ws = set()
        for m in hyprctl('monitors', want_json=True) or []:
            visible_ws.add(m.get('activeWorkspace', {}).get('id'))
            sp = m.get('specialWorkspace', {}).get('id', 0)
            if sp:   # a scratchpad is showing on this monitor
                visible_ws.add(sp)
        visible_ws.discard(None)
        clients = [c for c in (hyprctl('clients', want_json=True) or [])
                   if c.get('mapped', True) and c.get('class')
                   and c.get('workspace', {}).get('id') in visible_ws]
        clients.sort(key=lambda c: c.get('focusHistoryID', 9999))
        if not clients:
            return
        self.ensure_alttab()
        n = len(clients)
        self.att_list = clients
        self.att_sel = (1 if step > 0 else n - 1) % n
        self.att_cards = []

        for ch in self.att_box.get_children():
            self.att_box.remove(ch)
        per_line = max(1, min(n, (self.mon_w - 120) // (THUMB_W + 44)))
        self.att_box.set_max_children_per_line(per_line)
        self.att_box.set_min_children_per_line(min(n, per_line))
        for i, c in enumerate(clients):
            card = self.win_card(c, lambda _b, i=i: self.alttab_pick(i))
            self.att_cards.append(card)
            self.att_box.add(card)

        # show on the currently focused monitor
        for m in hyprctl('monitors', want_json=True) or []:
            if m.get('focused'):
                gm = Gdk.Display.get_default().get_monitor_at_point(
                    m.get('x', 0) + m.get('width', 0) // 2,
                    m.get('y', 0) + m.get('height', 0) // 2)
                if gm:
                    GtkLayerShell.set_monitor(self.att_win, gm)
                break
        self.alttab_update_sel()
        self.att_win.show_all()

    def win_card(self, c, on_click):
        """Preview card for one window (used by alt-tab and task view)."""
        cls = c.get('class') or ''
        g = {'info': self.resolver.resolve(cls), 'cls': cls}
        card = Gtk.Button()
        card.get_style_context().add_class('wincard')
        card.set_relief(Gtk.ReliefStyle.NONE)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        header.pack_start(self.icon_image(g, 16), False, False, 0)
        title = c.get('title') or cls
        if len(title) > 26:
            title = title[:24] + '…'
        lbl = Gtk.Label(label=title)
        lbl.get_style_context().add_class('cardtitle')
        lbl.set_halign(Gtk.Align.START)
        header.pack_start(lbl, True, True, 0)
        vbox.pack_start(header, False, False, 0)

        frame = Gtk.Box()
        frame.get_style_context().add_class('thumbframe')
        pix = self.thumb_pixbuf(c.get('address'))
        if pix is not None:
            img = Gtk.Image.new_from_pixbuf(pix)
        else:
            img = self.icon_image(g, 48)
            img.set_size_request(THUMB_W, THUMB_H)
        img.set_halign(Gtk.Align.CENTER)
        img.set_valign(Gtk.Align.CENTER)
        frame.set_size_request(THUMB_W, THUMB_H)
        frame.pack_start(img, True, True, 0)
        vbox.pack_start(frame, False, False, 0)

        card.add(vbox)
        card.connect('clicked', on_click)
        return card

    def alttab_pick(self, idx):
        self.att_sel = idx
        self.alttab_commit()

    def alttab_update_sel(self):
        for i, card in enumerate(self.att_cards):
            sc = card.get_style_context()
            if i == self.att_sel:
                sc.add_class('altsel')
            else:
                sc.remove_class('altsel')

    def alttab_commit(self):
        if not (self.att_win and self.att_win.get_visible()):
            return
        addr = None
        if 0 <= self.att_sel < len(self.att_list):
            addr = self.att_list[self.att_sel].get('address')
        self.alttab_cancel()
        if addr:
            dispatch('focuswindow', f'address:{addr}')
            dispatch('alterzorder', f'top,address:{addr}')

    def alttab_cancel(self):
        if self.att_win and self.att_win.get_visible():
            self.att_win.hide()
        self.att_list = []
        self.att_cards = []
        self.att_sel = 0

    # ---------- shared: fullscreen click-away backdrop ----------
    def _cursor_gdk_mon(self):
        try:
            x, y = [int(v.strip()) for v in hyprctl('cursorpos').split(',')]
            return Gdk.Display.get_default().get_monitor_at_point(x, y)
        except Exception:
            return None

    def _focused_gdk_mon(self):
        for m in hyprctl('monitors', want_json=True) or []:
            if m.get('focused'):
                return Gdk.Display.get_default().get_monitor_at_point(
                    m.get('x', 0) + m.get('width', 0) // 2,
                    m.get('y', 0) + m.get('height', 0) // 2)
        return None

    def _backdrop(self, name, on_close, dim=False, layer=None,
                  spare_bar=False, on_escape=None):
        """Fullscreen overlay window: clicking empty space or pressing
        Esc closes it. Content decides its own alignment.

        spare_bar stops the backdrop above the taskbar strip, so bar
        clicks reach waybar / the dock instead of only closing the popup.
        Content anchored to the bottom then sits flush on the bar."""
        LS = GtkLayerShell
        w = Gtk.Window(title=name)
        LS.init_for_window(w)
        LS.set_layer(w, LS.Layer.OVERLAY if layer is None else layer)
        for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(w, e, True)
        LS.set_exclusive_zone(w, -1)   # cover the whole screen, bar included
        if spare_bar:
            LS.set_margin(w, LS.Edge.BOTTOM, BAR_HEIGHT)
        LS.set_namespace(w, name)
        if hasattr(LS, 'set_keyboard_mode'):
            LS.set_keyboard_mode(w, LS.KeyboardMode.ON_DEMAND)
        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        w.set_app_paintable(True)
        if dim:
            w.get_style_context().add_class('tvbackdrop')
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                     | Gdk.EventMask.KEY_PRESS_MASK)
        w.connect('button-press-event', lambda _w, _e: (on_close(), True)[1])
        w.connect('key-press-event',
                  lambda _w, e: (((on_escape or on_close)(), True)[1]
                                 if e.keyval == Gdk.KEY_Escape else False))
        return w

    def close_bar_popups(self):
        """Bar popups no longer cover the bar, so a bar click can land
        while one is open: close them all before opening another, on dock
        clicks, and when focus moves to a different window (e.g. a tray
        icon raising its app)."""
        if self.tray_pop:
            self.tray_close()
        if self.start_win:
            self.start_close()
        if self.qs_win:
            self.quick_close()
        if self.wx_win:
            self.wx_close()
        if self.net_win:
            self.net_close()
        if self.clk_win:
            self.clk_close()
        self.popup_focus = self.active_addr

    @staticmethod
    def _swallow_clicks(widget):
        """Wrap in an input-only EventBox so clicks on the panel don't
        bubble to the backdrop and close it. The box must adopt the
        panel's alignment: as the window's direct child it would
        otherwise fill the whole screen and swallow every click,
        so the backdrop never sees a click-off."""
        eb = Gtk.EventBox()
        eb.set_visible_window(False)
        eb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        eb.connect('button-press-event', lambda *_: True)
        eb.set_halign(widget.get_halign())
        eb.set_valign(widget.get_valign())
        eb.add(widget)
        return eb

    # ---------- tray overflow (hide-to-tray apps) ----------
    def tray_tag(self, app_id):
        if app_id and app_id not in self.tray_apps:
            self.tray_apps.append(app_id)
            self.save_tray()
            self.refresh()

    def tray_untag(self, app_id):
        if app_id in self.tray_apps:
            self.tray_apps.remove(app_id)
            self.save_tray()
            self.tray_close()
            self.refresh()

    def tray_close(self):
        if self.tray_pop:
            self.tray_pop.destroy()
            self.tray_pop = None
        for m in self.tray_menus:
            m.destroy()
        self.tray_menus = []

    # -- collapsed status-notifier icons (waybar tray → overflow) --
    @staticmethod
    def sni_hidden():
        try:
            with open(SNI_HIDDEN_FILE) as f:
                ids = json.load(f)
            return [i for i in ids if isinstance(i, str)]
        except Exception:
            return []

    def sni_set_hidden(self, sni_id, hidden):
        ids = self.sni_hidden()
        if hidden == (sni_id in ids):
            return
        ids = ids + [sni_id] if hidden else [i for i in ids if i != sni_id]
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = SNI_HIDDEN_FILE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(sorted(ids), f, indent=2)
        os.replace(tmp, SNI_HIDDEN_FILE)   # waybar's file monitor picks it up

    def sni_items(self):
        """Collapsed tray items that are currently registered, in tray
        order: dicts with id, title, bus, path, menu, is_menu, pixbuf."""
        hidden = set(self.sni_hidden())
        if not hidden:
            return []
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            reg = bus.call_sync(
                'org.kde.StatusNotifierWatcher', '/StatusNotifierWatcher',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.kde.StatusNotifierWatcher',
                                      'RegisteredStatusNotifierItems')),
                None, Gio.DBusCallFlags.NONE, 300, None).unpack()[0]
        except GLib.Error:
            return []
        items = []
        for entry in reg:
            # "service/path", or a bare service on the default path
            slash = entry.find('/')
            busname, path = ((entry[:slash], entry[slash:]) if slash > 0
                             else (entry, '/StatusNotifierItem'))
            try:
                props = bus.call_sync(
                    busname, path, 'org.freedesktop.DBus.Properties',
                    'GetAll', GLib.Variant('(s)', ('org.kde.StatusNotifierItem',)),
                    None, Gio.DBusCallFlags.NONE, 300, None).unpack()[0]
            except GLib.Error:
                continue
            sid = props.get('Id') or ''
            if sid not in hidden or props.get('Status', '').lower() == 'passive':
                continue
            tip = props.get('ToolTip')
            title = (props.get('Title') or (tip[2] if tip else '') or sid)
            items.append(dict(
                id=sid, title=title, bus=busname, path=path,
                menu=props.get('Menu') or '',
                # libappindicator has no ItemIsMenu and only does menus
                is_menu=props.get('ItemIsMenu', True),
                pixbuf=self.sni_pixbuf(props, 24)))
        return items

    @staticmethod
    def sni_pixbuf(props, size):
        scale = 2   # crisp on HiDPI, downscaled by GtkImage otherwise fine
        name = props.get('IconName') or ''
        if name:
            if name.startswith('/') and os.path.exists(name):
                try:
                    return GdkPixbuf.Pixbuf.new_from_file_at_size(name, size, size)
                except GLib.Error:
                    pass
            theme = Gtk.IconTheme.get_default()
            tpath = props.get('IconThemePath') or ''
            if tpath:
                theme = Gtk.IconTheme.new()
                theme.prepend_search_path(tpath)
            for t in (theme, Gtk.IconTheme.get_default()):
                try:
                    pb = t.load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
                    if pb:
                        return pb
                except GLib.Error:
                    pass
        pixmaps = props.get('IconPixmap') or []
        if pixmaps:
            # closest to the wanted size, preferring bigger
            w, h, data = min(pixmaps, key=lambda p: (
                p[0] < size * scale, abs(p[0] - size * scale)))
            if w > 0 and h > 0 and len(data) >= w * h * 4:
                argb = bytes(data[:w * h * 4])
                rgba = bytearray(len(argb))   # network-order ARGB → RGBA
                rgba[0::4], rgba[1::4] = argb[1::4], argb[2::4]
                rgba[2::4], rgba[3::4] = argb[3::4], argb[0::4]
                pb = GdkPixbuf.Pixbuf.new_from_bytes(
                    GLib.Bytes.new(bytes(rgba)), GdkPixbuf.Colorspace.RGB,
                    True, 8, w, h, w * 4)
                return pb.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
        return None

    def sni_call(self, it, method, event):
        x, y = (int(event.x_root), int(event.y_root)) if event else (0, 0)
        Gio.bus_get_sync(Gio.BusType.SESSION, None).call(
            it['bus'], it['path'], 'org.kde.StatusNotifierItem', method,
            GLib.Variant('(ii)', (x, y)), None, Gio.DBusCallFlags.NONE,
            -1, None, None)

    def tray_toggle(self):
        if self.tray_pop:
            self.tray_close()
            return
        self.close_bar_popups()
        self.groups = self.build_groups()   # freshen tray_groups
        w = self._backdrop('winbar-tray', self.tray_close,
                           spare_bar=True)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class('wxcard')
        card.set_halign(Gtk.Align.END)
        card.set_valign(Gtk.Align.END)
        card.set_margin_bottom(8)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        for m in ('top', 'bottom', 'start', 'end'):
            getattr(body, f'set_margin_{m}')(6)

        # one grid: collapsed tray icons first, then hide-to-tray apps
        tiles = []
        for it in self.sni_items():
            img = (Gtk.Image.new_from_pixbuf(it['pixbuf']) if it['pixbuf']
                   else Gtk.Image.new_from_icon_name(
                       'application-x-executable', Gtk.IconSize.LARGE_TOOLBAR))
            if it['menu'] and DbusmenuGtk3:
                # built now so the async layout is in by the time it's opened
                m = DbusmenuGtk3.Menu.new(it['bus'], it['menu'])
                self.tray_menus.append(m)
                it['gtkmenu'] = m
            tiles.append((img, it['title'], ('sni', it)))
        for k, g in self.tray_groups.items():
            name = (g['info'].get_display_name() if g['info']
                    else (g['cls'] or '?'))
            n = len(g['windows'])
            tiles.append((self.icon_image(g, 24),
                          f"{name} — {n} window{'s' if n > 1 else ''}",
                          ('app', (k, g))))

        if tiles:
            fb = Gtk.FlowBox()
            fb.set_selection_mode(Gtk.SelectionMode.NONE)
            fb.set_homogeneous(True)
            fb.set_column_spacing(2)
            fb.set_row_spacing(2)
            cols = min(4, len(tiles))
            fb.set_max_children_per_line(cols)
            fb.set_min_children_per_line(cols)
            for img, tip, (kind, ref) in tiles:
                b = Gtk.Button()
                b.get_style_context().add_class('traybtn')
                b.set_relief(Gtk.ReliefStyle.NONE)
                b.set_focus_on_click(False)
                img.set_pixel_size(24)
                b.add(img)
                b.set_tooltip_text(tip)
                b.connect('button-press-event',
                          self.on_sni_press if kind == 'sni'
                          else self.on_tray_press, ref)
                fb.add(b)
            body.pack_start(fb, False, False, 0)
        else:
            lbl = self._lbl('No hidden icons', 'traylabel', 0.5)
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            body.pack_start(lbl, False, False, 0)
        card.pack_start(body, False, False, 0)

        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        card.set_margin_end(self._tray_margin(card, gm))
        self.tray_pop = w
        w.show_all()

    def _tray_margin(self, card, gm):
        """Centre the card over the chevron: the popup is opened by clicking
        it, so the cursor is there. Waybar's tray width varies with how many
        icons are showing, so a fixed offset drifts."""
        try:
            x, y = [int(v.strip()) for v in hyprctl('cursorpos').split(',')]
            geo = gm.get_geometry()
            if y < geo.y + geo.height - BAR_HEIGHT - 4:
                raise ValueError('not opened from the bar')
            card.show_all()
            width = max(card.get_preferred_width()[1], 1)
            right = geo.x + geo.width - x - width // 2
            return max(8, min(right, geo.width - width - 8))
        except Exception:
            return 150

    def _menu_extra(self, menu, label, cb):
        """Append our own entry to an app's (dbus) menu for one popup,
        then take it back out — the menu is reused for left clicks."""
        extra = []
        if menu.get_children():
            extra.append(Gtk.SeparatorMenuItem())
        mi = Gtk.MenuItem(label=label)
        mi.connect('activate',
                   lambda *_: GLib.idle_add(lambda: (cb(), False)[1]))
        extra.append(mi)
        for e in extra:
            menu.append(e)
            e.show()

        def done(*_):
            menu.disconnect(sig)
            # idle: GTK hides the menu before it emits the item's activate
            GLib.idle_add(lambda: [menu.remove(e) for e in extra
                                   if e.get_parent() is menu] and False)
        sig = menu.connect('hide', done)

    def on_sni_press(self, btn, event, it):
        menu = it.get('gtkmenu')
        if event.button == 1 and not it['is_menu']:
            self.sni_call(it, 'Activate', event)
            self.tray_close()
            return True
        if event.button == 2:
            self.sni_call(it, 'SecondaryActivate', event)
            self.tray_close()
            return True
        if event.button in (1, 3):
            if event.button == 3:
                if menu is None:
                    menu = Gtk.Menu()
                    self.tray_menus.append(menu)
                    mi = Gtk.MenuItem(label='App menu')
                    mi.connect('activate',
                               lambda *_: self.sni_call(it, 'ContextMenu', None))
                    menu.append(mi)
                    it['gtkmenu'] = menu
                self._menu_extra(menu, 'Show in taskbar', lambda: (
                    self.sni_set_hidden(it['id'], False), self.tray_close()))
            if menu is None:
                self.sni_call(it, 'ContextMenu', event)
                self.tray_close()
                return True
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    def on_tray_press(self, btn, event, ref):
        key, g = ref
        if event.button == 1:
            self.tray_close()
            # Anki lives on special:anki — open it on the *current* workspace
            # (same as rofi / Super+A show) instead of just focusing the pad.
            if g.get('id') == 'anki.desktop':
                subprocess.Popen(
                    [os.path.expanduser('~/.local/bin/anki-toggle'), 'show'],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif g['windows']:
                self.focus(g['windows'][0]['address'])
            return True
        if event.button == 3:
            menu = Gtk.Menu()
            mi = Gtk.MenuItem(label='Show in taskbar')
            mi.connect('activate', lambda _m, k=key: self.tray_untag(k))
            menu.append(mi)
            if g['info']:
                mi = Gtk.MenuItem(label='Open new window')
                mi.connect('activate', lambda _m: self.launch(g))
                menu.append(mi)
            if g['windows']:
                mi = Gtk.MenuItem(
                    label=('Close window' if len(g['windows']) == 1
                           else f"Close all {len(g['windows'])} windows"))
                mi.connect('activate', lambda _m: self.close_all(g))
                menu.append(mi)
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    # ---------- start menu (Windows 11 style, in-process) ----------
    def load_start_pinned(self):
        """Start-menu pins. Seeded from the taskbar pins on first run."""
        try:
            with open(START_PINNED_FILE) as f:
                data = json.load(f)
            if isinstance(data, list):
                return [str(x) for x in data]
        except (OSError, ValueError):
            pass
        seed = list(self.pinned)
        for app_id in DEFAULT_PINNED:
            if app_id not in seed and desktop_info(app_id):
                seed.append(app_id)
        return seed

    def save_start_pinned(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = START_PINNED_FILE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(self.start_pinned, f, indent=2)
        os.replace(tmp, START_PINNED_FILE)

    def start_pin(self, app_id, on=True):
        if on and app_id not in self.start_pinned:
            self.start_pinned.append(app_id)
        elif not on and app_id in self.start_pinned:
            self.start_pinned.remove(app_id)
        else:
            return
        self.save_start_pinned()
        if self.start_win:
            self.st_show_home()

    def start_close(self):
        if self.start_win:
            self.start_win.destroy()
            self.start_win = None
        self.st = {}
        if START_ONLY:
            # give a just-launched app a moment to detach before we go
            self._quit_id = GLib.timeout_add(1500, Gtk.main_quit)

    def start_toggle(self):
        if self.start_win:
            self.start_close()
            return
        if START_ONLY and getattr(self, '_quit_id', None):
            GLib.source_remove(self._quit_id)   # reopened before exiting
            self._quit_id = None
        self.close_bar_popups()
        self.st = {}
        self.start_pinned = self.load_start_pinned()
        w = self._backdrop('winbar-start', self.start_close,
                           spare_bar=not START_ONLY)
        # EXCLUSIVE (not ON_DEMAND): the menu opens from a taskbar click,
        # so it has to take the keyboard itself or search can't be typed.
        if hasattr(GtkLayerShell, 'set_keyboard_mode'):
            GtkLayerShell.set_keyboard_mode(
                w, GtkLayerShell.KeyboardMode.EXCLUSIVE)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.get_style_context().add_class('startcard')
        card.set_halign(Gtk.Align.START)
        card.set_valign(Gtk.Align.END)
        card.set_margin_start(10)
        card.set_margin_bottom(8)
        # fixed size, like the real thing: the body scrolls instead of the
        # menu resizing itself as you type
        card.set_size_request(START_W, START_H)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        for m in ('top', 'start', 'end'):
            getattr(body, f'set_margin_{m}')(24)
        body.set_margin_bottom(10)
        body.pack_start(self.st_search_bar(), False, False, 0)

        content = Gtk.Stack()
        content.set_transition_duration(200)
        content.set_homogeneous(True)
        self.st['content'] = content
        body.pack_start(content, True, True, 0)

        card.pack_start(body, True, True, 0)
        card.pack_start(self.st_footer(), False, False, 0)

        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        self.start_win = w
        self.st_show_home()
        w.show_all()
        self.st['entry'].grab_focus()

    # ----- chrome -----
    def st_search_bar(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        row.get_style_context().add_class('stsearch')
        glyph = Gtk.Label(label='')
        glyph.get_style_context().add_class('stglyph')
        row.pack_start(glyph, False, False, 0)

        entry = Gtk.Entry()
        entry.get_style_context().add_class('stentry')
        entry.set_has_frame(False)
        entry.set_placeholder_text(
            'Search for apps, settings, and documents')
        entry.connect('changed', lambda _e: self.st_on_search())
        entry.connect('activate', lambda _e: self.st_activate_selected())
        entry.connect('key-press-event', self.st_on_entry_key)
        self.st['entry'] = entry
        row.pack_start(entry, True, True, 0)
        return row

    def st_footer(self):
        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        foot.get_style_context().add_class('stfooter')
        for m in ('start', 'end'):
            getattr(foot, f'set_margin_{m}')(20)
        for m in ('top', 'bottom'):
            getattr(foot, f'set_margin_{m}')(12)

        user = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        avatar = Gtk.Image.new_from_gicon(
            Gio.ThemedIcon.new('avatar-default'), Gtk.IconSize.INVALID)
        avatar.set_pixel_size(26)
        user.pack_start(avatar, False, False, 0)
        name = Gtk.Label(label=os.environ.get('USER', 'user'))
        name.get_style_context().add_class('stuser')
        user.pack_start(name, False, False, 0)
        foot.pack_start(user, False, False, 0)

        power = Gtk.Button(label='')
        power.get_style_context().add_class('stpower')
        power.set_relief(Gtk.ReliefStyle.NONE)
        power.set_tooltip_text('Power')
        power.connect('clicked', self.st_power_menu)
        foot.pack_end(power, False, False, 0)

        # pack_end in reverse so they read left-to-right before Power
        for glyph, label, path in reversed(START_FOLDERS):
            if not os.path.isdir(path):
                continue
            b = Gtk.Button(label=glyph)
            b.get_style_context().add_class('stfoot')
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_tooltip_text(label)
            b.connect('clicked', lambda _b, p=path: self.st_open_path(p))
            foot.pack_end(b, False, False, 0)
        return foot

    def st_power_menu(self, btn):
        menu = Gtk.Menu()
        for label, cmd in START_POWER:
            mi = Gtk.MenuItem(label=label)
            mi.connect('activate', lambda _m, c=cmd: self.st_power(c))
            menu.append(mi)
        mi = Gtk.MenuItem(label='Log out')
        mi.connect('activate', lambda _m: self.st_logout())
        menu.append(mi)
        menu.show_all()
        menu.popup_at_widget(btn, Gdk.Gravity.NORTH_EAST,
                             Gdk.Gravity.SOUTH_EAST, None)

    def st_power(self, cmd):
        self.start_close()
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)

    def st_logout(self):
        self.start_close()
        sid = os.environ.get('XDG_SESSION_ID')
        cmd = ['loginctl', 'terminate-session'] + ([sid] if sid else [])
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)

    # ----- data (cached for the lifetime of one menu open) -----
    def st_apps(self):
        if 'apps' not in self.st:
            self.st['apps'] = all_apps()
        return self.st['apps']

    def st_recency(self):
        if 'recency' not in self.st:
            self.st['recency'] = recency_table()
        return self.st['recency']

    # ----- views -----
    def st_set_content(self, widget, motion='fade'):
        """Swap the visible view, animating in the given direction.

        Deeper (Pinned -> a category) slides left, Back slides right, and
        search results cross-fade in place."""
        stack = self.st.get('content')
        if stack is None:
            return
        T = Gtk.StackTransitionType
        first = not stack.get_children()
        stack.set_transition_type(
            T.NONE if first else
            {'left': T.SLIDE_LEFT, 'right': T.SLIDE_RIGHT}.get(
                motion, T.CROSSFADE))

        self.st['vn'] = self.st.get('vn', 0) + 1
        name = f'view{self.st["vn"]}'
        stack.add_named(widget, name)
        widget.show_all()
        stack.set_visible_child_name(name)
        # drop the outgoing view once it has finished sliding out
        GLib.timeout_add(stack.get_transition_duration() + 80,
                         self.st_prune_views)

    def st_prune_views(self):
        """Keep whatever is on screen *now*, not whatever was current when
        this was scheduled: typing queues several of these, and a stale
        name would prune the view the user is actually looking at."""
        stack = self.st.get('content')
        if stack is not None:
            current = stack.get_visible_child()
            for child in stack.get_children():
                if child is not current:
                    stack.remove(child)
        return False

    def st_header(self, text, link=None, on_link=None):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class('sthdr')
        lbl.set_halign(Gtk.Align.START)
        row.pack_start(lbl, True, True, 0)
        if link:
            b = Gtk.Button(label=link)
            b.get_style_context().add_class('stlink')
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.connect('clicked', lambda _b: on_link())
            row.pack_end(b, False, False, 0)
        return row

    def st_new_view(self):
        """Forget the previous view's widgets before building the next.

        These have to be cleared here rather than in st_set_content: the
        view is fully built (and has already stashed its list/scroller)
        by the time it is handed over, so clearing there dropped exactly
        the refs Enter and the arrow keys need."""
        self.st.pop('list', None)
        self.st.pop('scroll', None)

    def st_show_home(self):
        """Pinned grid + the All-apps category grid, in one scrolling body
        (Recommended sits below the fold, like Win11 with it turned off)."""
        self.st_new_view()
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22)

        body.pack_start(
            self.st_header('Pinned', 'Show all  \uf078', self.st_show_all_apps),
            False, False, 0)
        grid = Gtk.FlowBox()
        grid.set_selection_mode(Gtk.SelectionMode.NONE)
        grid.set_max_children_per_line(START_COLS)
        grid.set_min_children_per_line(START_COLS)
        grid.set_homogeneous(True)
        grid.set_row_spacing(6)
        for app_id in self.start_pinned:
            info = desktop_info(app_id)
            if info:
                grid.add(self.st_tile(info))
        body.pack_start(grid, False, False, 0)

        view = self.st.get('allview', 'category')
        body.pack_start(
            self.st_header(
                'All',
                'View: %s  \uf078' % ('Category' if view == 'category'
                                       else 'Name'),
                self.st_toggle_allview),
            False, False, 0)
        if view == 'category':
            cats = Gtk.FlowBox()
            cats.set_selection_mode(Gtk.SelectionMode.NONE)
            cats.set_max_children_per_line(START_CAT_COLS)
            cats.set_min_children_per_line(START_CAT_COLS)
            cats.set_homogeneous(True)
            cats.set_row_spacing(10)
            cats.set_column_spacing(10)
            for name, apps in self.st_categories():
                cats.add(self.st_category_tile(name, apps))
            body.pack_start(cats, False, False, 0)
        else:
            lb = self.st_listbox()
            for app in self.st_apps():
                lb.add(self.st_app_row(app))
            body.pack_start(lb, False, False, 0)

        files = recent_files(START_RECENT)
        if files:
            body.pack_start(self.st_header('Recommended'), False, False, 0)
            rec = Gtk.FlowBox()
            rec.set_selection_mode(Gtk.SelectionMode.NONE)
            rec.set_max_children_per_line(2)
            rec.set_min_children_per_line(2)
            rec.set_homogeneous(True)
            rec.set_column_spacing(4)
            for path in files:
                rec.add(self.st_file_card(path))
            body.pack_start(rec, False, False, 0)

        self.st_set_content(self.st_scroller(body),
                            self.st.pop('motion', 'fade'))

    def st_toggle_allview(self):
        self.st['allview'] = ('name' if self.st.get('allview', 'category')
                              == 'category' else 'category')
        self.st['motion'] = 'fade'
        self.st_show_home()

    def st_back_home(self):
        self.st['motion'] = 'right'
        self.st_show_home()

    def st_categories(self):
        """[(category, [app, ...])] in START_CATEGORIES order, non-empty."""
        if 'cats' in self.st:
            return self.st['cats']
        buckets = {name: [] for name, _ in START_CATEGORIES}
        buckets['Other'] = []
        for app in self.st_apps():
            cats = set((app.get_categories() or '').split(';'))
            for name, keys in START_CATEGORIES:
                if cats.intersection(keys):
                    buckets[name].append(app)
                    break
            else:
                buckets['Other'].append(app)
        out = [(n, buckets[n]) for n, _ in START_CATEGORIES if buckets[n]]
        if buckets['Other']:
            out.append(('Other', buckets['Other']))
        self.st['cats'] = out
        return out

    def st_show_category(self, name, apps):
        self.st_new_view()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self.st_header(name, '\uf053  Back', self.st_back_home),
                       False, False, 0)
        lb = self.st_listbox()
        for app in apps:
            lb.add(self.st_app_row(app))
        box.pack_start(lb, False, False, 0)
        self.st_set_content(self.st_scroller(box), 'left')

    def st_show_all_apps(self):
        self.st_new_view()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(
            self.st_header('All apps', '\uf053  Back', self.st_back_home),
            False, False, 0)
        lb = self.st_listbox()
        for app in self.st_apps():
            lb.add(self.st_app_row(app))
        box.pack_start(lb, False, False, 0)
        self.st_set_content(self.st_scroller(box), 'left')

    def st_scroller(self, child):
        scroll = Gtk.ScrolledWindow()
        scroll.get_style_context().add_class('stscroll')
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(child)
        self.st['scroll'] = scroll
        return scroll

    def st_on_search(self):
        self.st_new_view()
        text = self.st['entry'].get_text().strip().lower()
        if not text:
            self.st_show_home()
            return
        recency = self.st_recency()
        hits = []
        for app in self.st_apps():
            score = match_score(app, text, recency)
            if score is not None:
                hits.append((score, app))
        hits.sort(key=lambda h: h[0])

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(self.st_header('Best match' if hits else 'No results'),
                       False, False, 0)
        lb = self.st_listbox(selectable=True)
        for _score, app in hits[:START_RESULTS]:
            lb.add(self.st_app_row(app))
        box.pack_start(lb, False, False, 0)
        self.st['list'] = lb
        self.st_set_content(self.st_scroller(box), 'fade')
        first = lb.get_row_at_index(0)
        if first:
            lb.select_row(first)

    # ----- rows and tiles -----
    def st_category_tile(self, name, apps):
        """A rounded tile holding a 2x2 preview of the category's apps."""
        b = Gtk.Button()
        b.get_style_context().add_class('stcatbtn')
        b.set_relief(Gtk.ReliefStyle.NONE)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        square = Gtk.Grid()
        square.set_row_spacing(CAT_CELL_GAP)
        square.set_column_spacing(CAT_CELL_GAP)
        square.set_row_homogeneous(True)
        square.set_column_homogeneous(True)
        square.set_halign(Gtk.Align.CENTER)
        square.set_valign(Gtk.Align.CENTER)
        recency = self.st_recency()
        # most-recently-used first, but never lead with a broken icon
        ordered = sorted(apps, key=lambda a: (not has_real_icon(a),
                                              -recency.get(a.get_id() or '', 0),
                                              (a.get_display_name() or '').lower()))
        # one tile showing the same icon four times looks like a bug
        top, seen = [], set()
        for app in ordered:
            if not has_real_icon(app):
                continue
            icon = app.get_icon()
            key = (icon.to_string() if icon else None) or app.get_id()
            if key in seen:
                continue
            seen.add(key)
            top.append(app)
            if len(top) == 4:
                break
        if not top:
            top = ordered[:4]
        # Every cell is the same square regardless of the icon's aspect
        # ratio, or a tall/round icon shoves the others out of alignment.
        # Sparse categories centre what they have instead of hugging the
        # top-left corner.
        spans = {1: [(0, 0, 2, 2)],
                 2: [(0, 0, 1, 2), (1, 0, 1, 2)],
                 3: [(0, 0, 1, 1), (1, 0, 1, 1), (0, 1, 2, 1)]}.get(
                     len(top), [(i % 2, i // 2, 1, 1) for i in range(4)])
        for app, (col, row, cw, ch) in zip(top, spans):
            cell = Gtk.Box()
            cell.set_size_request(CAT_CELL, CAT_CELL)
            cell.set_halign(Gtk.Align.CENTER)
            cell.set_valign(Gtk.Align.CENTER)
            img = Gtk.Image.new_from_gicon(
                app.get_icon()
                or Gio.ThemedIcon.new('application-x-executable'),
                Gtk.IconSize.INVALID)
            img.set_pixel_size(CAT_ICON)
            img.set_halign(Gtk.Align.CENTER)
            img.set_valign(Gtk.Align.CENTER)
            cell.pack_start(img, True, True, 0)
            square.attach(cell, col, row, cw, ch)
        # the frame is a fixed square so a category with one app is the
        # same size as one with four
        frame = Gtk.Box()
        frame.get_style_context().add_class('stcat')
        frame.set_size_request(CAT_FRAME, CAT_FRAME)
        frame.set_halign(Gtk.Align.CENTER)
        frame.pack_start(square, True, True, 0)
        v.pack_start(frame, False, False, 0)

        lbl = Gtk.Label(label=name)
        lbl.get_style_context().add_class('stcatlabel')
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(18)
        v.pack_start(lbl, False, False, 0)

        b.add(v)
        b.set_size_request(CAT_TILE, -1)
        b.set_tooltip_text(f'{name} ({len(apps)} apps)')
        b.connect('clicked', lambda _b: self.st_show_category(name, apps))
        return b

    def st_tile(self, info):
        b = Gtk.Button()
        b.get_style_context().add_class('sttile')
        b.set_relief(Gtk.ReliefStyle.NONE)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        img = Gtk.Image.new_from_gicon(info.get_icon()
                                       or Gio.ThemedIcon.new(
                                           'application-x-executable'),
                                       Gtk.IconSize.INVALID)
        img.set_pixel_size(32)
        v.pack_start(img, False, False, 0)
        lbl = Gtk.Label(label=info.get_display_name())
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_line_wrap(True)
        lbl.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        lbl.set_lines(2)          # "Microsoft 365 Copilot" wraps, not clips
        lbl.set_justify(Gtk.Justification.CENTER)
        lbl.set_max_width_chars(10)
        lbl.set_width_chars(10)
        v.pack_start(lbl, False, False, 0)
        b.add(v)
        b.set_tooltip_text(info.get_display_name())
        b.connect('clicked', lambda _b: self.st_launch(info))
        b.connect('button-press-event',
                  lambda _b, ev: (self.st_app_press(ev, info)
                                  if ev.button == 3 else False))
        return b

    def st_listbox(self, selectable=False):
        """A menu list. Row press/activate is handled here rather than on
        the rows: a ListBoxRow has no event window of its own."""
        lb = Gtk.ListBox()
        lb.get_style_context().add_class('stlist')
        lb.set_selection_mode(Gtk.SelectionMode.BROWSE if selectable
                              else Gtk.SelectionMode.NONE)
        lb.connect('row-activated', lambda _lb, row: self.st_row_activate(row))
        lb.connect('button-press-event', self.st_list_press)
        return lb

    def st_list_press(self, lb, event):
        if event.button != 3:
            return False
        row = lb.get_row_at_y(int(event.y))
        if row is None:
            return False
        if getattr(row, '_app', None):
            return self.st_app_press(event, row._app)
        if getattr(row, '_path', None):
            return self.st_file_press(event, row._path)
        return False

    def st_app_row(self, info):
        row = Gtk.ListBoxRow()
        row._app = info
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.get_style_context().add_class('strow')
        img = Gtk.Image.new_from_gicon(info.get_icon()
                                       or Gio.ThemedIcon.new(
                                           'application-x-executable'),
                                       Gtk.IconSize.INVALID)
        img.set_pixel_size(24)
        box.pack_start(img, False, False, 0)
        lbl = Gtk.Label(label=info.get_display_name())
        lbl.set_halign(Gtk.Align.START)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(lbl, True, True, 0)
        row.add(box)
        return row

    def st_file_card(self, path):
        b = Gtk.Button()
        b.get_style_context().add_class('stcard')
        b.set_relief(Gtk.ReliefStyle.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.get_style_context().add_class('strow')
        img = Gtk.Image.new_from_gicon(file_gicon(path), Gtk.IconSize.INVALID)
        img.set_pixel_size(30)
        box.pack_start(img, False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        v.set_valign(Gtk.Align.CENTER)
        lbl = Gtk.Label(label=os.path.basename(path.rstrip('/')) or path)
        lbl.set_halign(Gtk.Align.START)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(24)
        v.pack_start(lbl, False, False, 0)
        sub = Gtk.Label(label=pretty_path(path))
        sub.get_style_context().add_class('strowsub')
        sub.set_halign(Gtk.Align.START)
        sub.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        sub.set_max_width_chars(24)
        v.pack_start(sub, False, False, 0)
        box.pack_start(v, True, True, 0)
        b.add(box)
        b.set_tooltip_text(path)
        b.connect('clicked', lambda _b: self.st_open_path(path))
        b.connect('button-press-event',
                  lambda _b, ev: (self.st_file_press(ev, path)
                                  if ev.button == 3 else False))
        return b

    # ----- actions -----
    def st_launch(self, info):
        self.start_close()
        self.launch({'info': info, 'id': info.get_id()})

    def st_open_path(self, path):
        self.start_close()
        try:
            Gio.AppInfo.launch_default_for_uri(
                Gio.File.new_for_path(path).get_uri(), None)
        except Exception as e:
            print(f'winbar-dock: open {path} failed: {e}', file=sys.stderr)

    def st_row_activate(self, row):
        if row is None:
            return
        if getattr(row, '_app', None):
            self.st_launch(row._app)
        elif getattr(row, '_path', None):
            self.st_open_path(row._path)

    def st_activate_selected(self):
        lb = self.st.get('list')
        if lb is not None:
            self.st_row_activate(lb.get_selected_row())

    def st_on_entry_key(self, _entry, event):
        """Arrows walk the results without taking focus off the entry."""
        lb = self.st.get('list')
        if lb is None or event.keyval not in (Gdk.KEY_Up, Gdk.KEY_Down):
            return False
        row = lb.get_selected_row()
        idx = row.get_index() if row else -1
        idx += 1 if event.keyval == Gdk.KEY_Down else -1
        nxt = lb.get_row_at_index(max(0, idx))
        if nxt:
            lb.select_row(nxt)
            self.st_scroll_to(nxt)
        return True

    def st_scroll_to(self, row):
        scroll = self.st.get('scroll')
        if scroll is None:
            return
        adj = scroll.get_vadjustment()
        alloc = row.get_allocation()
        top, bottom = adj.get_value(), adj.get_value() + adj.get_page_size()
        if alloc.y < top:
            adj.set_value(alloc.y)
        elif alloc.y + alloc.height > bottom:
            adj.set_value(alloc.y + alloc.height - adj.get_page_size())

    def st_app_press(self, event, info):
        menu = Gtk.Menu()
        app_id = info.get_id()

        mi = Gtk.MenuItem(label='Open')
        mi.connect('activate', lambda _m: self.st_launch(info))
        menu.append(mi)
        menu.append(Gtk.SeparatorMenuItem())

        pinned_start = app_id in self.start_pinned
        mi = Gtk.MenuItem(label='Unpin from Start' if pinned_start
                          else 'Pin to Start')
        mi.connect('activate',
                   lambda _m: self.start_pin(app_id, not pinned_start))
        menu.append(mi)

        on_bar = app_id in self.pinned
        mi = Gtk.MenuItem(label='Unpin from taskbar' if on_bar
                          else 'Pin to taskbar')
        mi.connect('activate',
                   lambda _m: (self.unpin(app_id) if on_bar
                               else self.pin(app_id)))
        menu.append(mi)

        shortcut = desktop_shortcut_path(info)
        mi = Gtk.MenuItem(label='Add to desktop')
        if shortcut is None or os.path.exists(shortcut):
            mi.set_sensitive(False)
        else:
            mi.connect('activate', lambda _m: add_to_desktop(info))
        menu.append(mi)

        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def st_file_press(self, event, path):
        menu = Gtk.Menu()
        mi = Gtk.MenuItem(label='Open')
        mi.connect('activate', lambda _m: self.st_open_path(path))
        menu.append(mi)
        mi = Gtk.MenuItem(label='Open containing folder')
        mi.connect('activate',
                   lambda _m: self.st_open_path(os.path.dirname(path)))
        menu.append(mi)
        menu.append(Gtk.SeparatorMenuItem())
        dest = os.path.join(DESKTOP_DIR, os.path.basename(path.rstrip('/')))
        mi = Gtk.MenuItem(label='Add to desktop')
        if os.path.lexists(dest):
            mi.set_sensitive(False)
        else:
            mi.connect('activate', lambda _m: link_to_desktop(path))
        menu.append(mi)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    # ---------- quick settings (volume / mic / media / night light) -----
    def quick_close(self):
        if self.qs_timer:
            GLib.source_remove(self.qs_timer)
            self.qs_timer = None
        if self.md_timer:
            GLib.source_remove(self.md_timer)
            self.md_timer = None
        if self.qs_win:
            self.qs_win.destroy()
            self.qs_win = None
        self.qs_widgets = {}

    def quick_toggle(self):
        if self.qs_win:
            self.quick_close()
            return
        self.close_bar_popups()
        w = self._backdrop('winbar-quick', self.quick_close,
                           spare_bar=True)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class('qscard')
        card.set_halign(Gtk.Align.END)
        card.set_valign(Gtk.Align.END)
        card.set_margin_end(10)
        card.set_margin_bottom(8)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        v.set_size_request(QS_W, -1)
        for m in ('top', 'bottom', 'start', 'end'):
            getattr(v, f'set_margin_{m}')(10)

        media = self.qs_media_section()
        if media:
            v.pack_start(media, False, False, 0)
            # album art backdrop spans the whole panel, under the CSS
            # background (made transparent while there is art)
            self.qs_widgets['qs_card'] = card
            card.connect('draw', self._md_draw_bg)
        ctl = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for m in ('start', 'end'):
            getattr(ctl, f'set_margin_{m}')(6)
        ctl.set_margin_bottom(4)
        ctl.set_margin_top(0 if media else 6)
        v.pack_start(ctl, False, False, 0)
        ctl.pack_start(self.qs_volume_row(), False, False, 0)
        ctl.pack_start(self.qs_toggle_row(), False, False, 0)

        card.add(v)
        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        self.qs_win = w
        w.show_all()
        self.qs_update()
        self.qs_timer = GLib.timeout_add(1200, self.qs_update)

    def _qsbtn(self, glyph, cb):
        b = Gtk.Button(label=glyph)
        b.get_style_context().add_class('qsbtn')
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.connect('clicked', cb)
        return b

    def _player(self):
        try:
            players = subprocess.run(
                ['playerctl', '-l'], capture_output=True,
                text=True, timeout=2).stdout.split()
        except Exception:
            return None
        for p in players:
            try:
                st = subprocess.run(['playerctl', '-p', p, 'status'],
                                    capture_output=True, text=True,
                                    timeout=2).stdout.strip()
            except Exception:
                continue
            if st == 'Playing':
                return p
        return players[0] if players else None

    # ----- media card (quick settings) -----
    # Album art drives the look: a blurred copy fills the card, and
    # the art's most vivid color tints the play button and seek bar.
    # The seek bar runs off a local clock between playerctl polls, so
    # it moves smoothly and stays drag-seekable.
    @staticmethod
    def _md_players():
        try:
            names = subprocess.run(['playerctl', '-l'], capture_output=True,
                                   text=True, timeout=2).stdout.split()
        except Exception:
            return []
        playing = []
        for p in names:
            try:
                st = subprocess.run(['playerctl', '-p', p, 'status'],
                                    capture_output=True, text=True,
                                    timeout=2).stdout.strip()
            except Exception:
                st = ''
            playing.append(st == 'Playing')
        return [p for _, p in sorted(zip(playing, names),
                                     key=lambda t: not t[0])]

    def _md_info(self, player):
        """(identity, desktop entry, can shuffle, can loop), cached."""
        if player in self.md_info:
            return self.md_info[player]
        ident, desk = '', ''
        try:
            out = subprocess.run(
                ['busctl', '--user', 'get-property',
                 f'org.mpris.MediaPlayer2.{player}', '/org/mpris/MediaPlayer2',
                 'org.mpris.MediaPlayer2', 'Identity', 'DesktopEntry'],
                capture_output=True, text=True, timeout=2).stdout
            vals = re.findall(r'^s "(.*)"$', out, re.M)
            ident = vals[0] if vals else ''
            desk = vals[1] if len(vals) > 1 else ''
        except Exception:
            pass

        def can(cmd):
            try:
                return subprocess.run(['playerctl', '-p', player, cmd],
                                      capture_output=True,
                                      timeout=2).returncode == 0
            except Exception:
                return False
        ident = re.sub(r'^Mozilla\s+', '', ident) or player.split('.')[0]
        info = (ident[:1].upper() + ident[1:], desk, can('shuffle'),
                can('loop'))
        self.md_info[player] = info
        return info

    def qs_media_section(self):
        players = self._md_players()
        if not players:
            return None
        if self.md_pick not in players:
            self.md_pick = players[0]
        self.md = {'players': players, 'pos': 0.0, 'len': 0.0,
                   'playing': False, 'sync': time.monotonic(),
                   'seek': None, 'hover': False, 'art_key': None,
                   'art': None, 'blur': None, 'color': self._md_default_rgb()}
        self.qs_widgets['player'] = self.md_pick
        W = self.qs_widgets

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class('mdcard')

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for m in ('top', 'bottom', 'start', 'end'):
            getattr(inner, f'set_margin_{m}')(14)
        card.pack_start(inner, True, True, 0)

        # source row: app · switcher · open
        src = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        icon = Gtk.Image()
        src.pack_start(icon, False, False, 0)
        name = Gtk.Label(label='')
        name.get_style_context().add_class('mdsrc')
        src.pack_start(name, False, False, 0)
        state = Gtk.Label(label='')
        state.get_style_context().add_class('mdstate')
        src.pack_start(state, False, False, 0)
        raise_b = self._md_btn('\U000F03CC', 'mdmini', self._md_raise)
        raise_b.set_tooltip_text('Show player')
        src.pack_end(raise_b, False, False, 0)
        if len(players) > 1:
            nxt = self._md_btn('\U000F0142', 'mdmini',
                               lambda *_: self._md_switch(1))
            cnt = Gtk.Label(label='')
            cnt.get_style_context().add_class('mdstate')
            prv = self._md_btn('\U000F0141', 'mdmini',
                               lambda *_: self._md_switch(-1))
            for b in (nxt, cnt, prv):
                src.pack_end(b, False, False, 0)
            W['md_count'] = cnt
        inner.pack_start(src, False, False, 0)

        # art + text
        mid = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        art = Gtk.DrawingArea()
        art.set_size_request(MD_ART, MD_ART)
        art.connect('draw', self._md_draw_art)
        mid.pack_start(art, False, False, 0)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        txt.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label(label='—')
        title.get_style_context().add_class('mdtitle')
        title.set_xalign(0)
        title.set_line_wrap(True)
        title.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        title.set_lines(2)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        title.set_max_width_chars(22)
        artist = Gtk.Label(label='')
        artist.get_style_context().add_class('mdartist')
        album = Gtk.Label(label='')
        album.get_style_context().add_class('mdalbum')
        for l in (artist, album):
            l.set_xalign(0)
            l.set_ellipsize(Pango.EllipsizeMode.END)
            l.set_max_width_chars(24)
        for l in (title, artist, album):
            txt.pack_start(l, False, False, 0)
        mid.pack_start(txt, True, True, 0)
        inner.pack_start(mid, False, False, 0)

        # seek bar + times
        seek = Gtk.DrawingArea()
        seek.set_size_request(-1, 16)
        seek.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.ENTER_NOTIFY_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        seek.connect('draw', self._md_draw_seek)
        seek.connect('button-press-event', self._md_seek_press)
        seek.connect('motion-notify-event', self._md_seek_motion)
        seek.connect('button-release-event', self._md_seek_release)
        seek.connect('enter-notify-event', lambda w, _e: (
            self.md.__setitem__('hover', True), w.queue_draw()))
        seek.connect('leave-notify-event', lambda w, _e: (
            self.md.__setitem__('hover', False), w.queue_draw()))
        times = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        times.set_margin_start(5)
        times.set_margin_end(5)
        t_el = Gtk.Label(label='0:00')
        t_rem = Gtk.Label(label='')
        for l in (t_el, t_rem):
            l.get_style_context().add_class('mdtime')
        times.pack_start(t_el, False, False, 0)
        times.pack_end(t_rem, False, False, 0)
        sk = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sk.pack_start(seek, False, False, 0)
        sk.pack_start(times, False, False, 0)
        inner.pack_start(sk, False, False, 0)

        # transport
        ctr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        ctr.set_halign(Gtk.Align.CENTER)
        shuf = self._md_btn('\U000F049D', 'mdside',
                            lambda *_: self._md_cmd('shuffle', 'Toggle'))
        shuf.set_tooltip_text('Shuffle')
        prev = self._md_btn('\U000F04AE', 'mdskip',
                            lambda *_: self._md_cmd('previous'))
        play = self._md_btn('\U000F040A', 'mdplay',
                            lambda *_: self._md_cmd('play-pause'))
        nxt = self._md_btn('\U000F04AD', 'mdskip',
                           lambda *_: self._md_cmd('next'))
        loop = self._md_btn('\U000F0456', 'mdside', self._md_cycle_loop)
        loop.set_tooltip_text('Repeat')
        for b in (shuf, prev, play, nxt, loop):
            b.set_valign(Gtk.Align.CENTER)
            ctr.pack_start(b, False, False, 0)
        inner.pack_start(ctr, False, False, 0)

        W.update(md_card=card, md_icon=icon, md_name=name, md_state=state,
                 md_art=art, title=title, artist=artist, album=album,
                 md_seek=seek, md_el=t_el, md_rem=t_rem, play=play,
                 md_shuf=shuf, md_loop=loop, md_prev=prev, md_next=nxt)
        self._md_apply_player()
        self.md_timer = GLib.timeout_add(200, self._md_tick)
        return card

    def _md_btn(self, glyph, cls, cb):
        b = Gtk.Button(label=glyph)
        b.get_style_context().add_class('mdbtn')
        b.get_style_context().add_class(cls)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.connect('clicked', cb)
        return b

    def _md_apply_player(self):
        W = self.qs_widgets
        p = self.md_pick
        ident, desk, can_shuf, can_loop = self._md_info(p)
        W['md_name'].set_label(ident)
        gicon = None
        if desk:
            info = desktop_info(desk + '.desktop')
            gicon = info.get_icon() if info else None
        if gicon:
            W['md_icon'].set_from_gicon(gicon, Gtk.IconSize.MENU)
            W['md_icon'].set_pixel_size(16)
            W['md_icon'].show()
        else:
            W['md_icon'].hide()
        W['md_shuf'].set_visible(can_shuf)
        W['md_loop'].set_visible(can_loop)
        W['md_shuf'].set_no_show_all(not can_shuf)
        W['md_loop'].set_no_show_all(not can_loop)
        if 'md_count' in W:
            pl = self.md['players']
            W['md_count'].set_label(f'{pl.index(p) + 1}/{len(pl)}')
        self.md.update(art_key=None, art=None, blur=None,
                       color=self._md_default_rgb())
        self._md_restyle()
        self._md_redraw()

    def _md_switch(self, step):
        pl = self.md['players']
        self.md_pick = pl[(pl.index(self.md_pick) + step) % len(pl)]
        self.qs_widgets['player'] = self.md_pick
        self._md_apply_player()
        self.qs_update()

    def _md_cmd(self, *args):
        p = self.md_pick
        if not p:
            return
        subprocess.Popen(['playerctl', '-p', p, *args])
        if args[0] == 'play-pause':   # feel instant; the poll confirms
            self.md['playing'] = not self.md['playing']
            self.md['sync'] = time.monotonic()
            self._md_paint_state()
        GLib.timeout_add(250, self.qs_update)

    def _md_cycle_loop(self, *_):
        nxt = {'None': 'Playlist', 'Playlist': 'Track'}.get(
            self.md.get('loop', 'None'), 'None')
        self._md_cmd('loop', nxt)

    def _md_raise(self, *_):
        _, desk, _, _ = self._md_info(self.md_pick)
        want = {x.lower() for x in (desk, self.md_pick.split('.')[0]) if x}
        for c in hyprctl('clients', want_json=True) or []:
            cls = {(c.get('class') or '').lower(),
                   (c.get('initialClass') or '').lower()}
            if want & cls:
                addr = c['address']
                if is_minimized_ws(c.get('workspace')):
                    self.toggle_minimize(addr)
                dispatch('focuswindow', f'address:{addr}')
                dispatch('alterzorder', f'top,address:{addr}')
                break
        self.quick_close()

    def _md_update(self):
        W = self.qs_widgets
        p = self.md_pick
        if not p or 'md_card' not in W:
            return
        fmt = '\x1f'.join(('{{status}}', '{{title}}', '{{artist}}',
                           '{{album}}', '{{mpris:artUrl}}', '{{xesam:url}}',
                           '{{position}}', '{{mpris:length}}',
                           '{{shuffle}}', '{{loop}}'))
        try:
            out = subprocess.run(
                ['playerctl', '-p', p, 'metadata', '--format', fmt],
                capture_output=True, text=True, timeout=2).stdout.rstrip('\n')
        except Exception:
            return
        f = (out.split('\x1f') + [''] * 10)[:10]
        status, title, artist, album, art_url, url, pos, length, shuf, loop = f
        if not out:
            W['md_state'].set_label('·  Nothing playing')
            return
        W['title'].set_label(title or 'Unknown title')
        W['title'].set_tooltip_text(title or None)
        artist = re.sub(r'\s+-\s+Topic$', '', artist)
        W['artist'].set_label(artist)
        W['artist'].set_visible(bool(artist))
        W['album'].set_label(album)
        W['album'].set_visible(bool(album) and album != title)

        md = self.md
        md['playing'] = status == 'Playing'
        md['status'] = status
        try:
            md['len'] = int(length) / 1e6 if length else 0.0
        except ValueError:
            md['len'] = 0.0
        if md['seek'] is None:
            try:
                md['pos'] = int(pos) / 1e6
            except ValueError:
                md['pos'] = 0.0
            md['sync'] = time.monotonic()
        md['shuffle'] = shuf == 'true'
        md['loop'] = loop or 'None'
        self._md_paint_state()

        if not art_url:
            m = re.search(r'(?:youtube\.com/watch\?(?:.*&)?v=|youtu\.be/)'
                          r'([\w-]{11})', url or '')
            if m:
                art_url = f'https://i.ytimg.com/vi/{m.group(1)}/mqdefault.jpg'
        self.qs_set_art(art_url)

    def _md_paint_state(self):
        W, md = self.qs_widgets, self.md
        W['play'].set_label('\U000F03E4' if md['playing'] else '\U000F040A')
        W['md_state'].set_label(
            '' if md['playing'] else
            '·  ' + (md.get('status') or 'Paused'))
        for key, on in (('md_shuf', md.get('shuffle')),
                        ('md_loop', md.get('loop', 'None') != 'None')):
            ctx = W[key].get_style_context()
            ctx.add_class('on') if on else ctx.remove_class('on')
        W['md_loop'].set_label('\U000F0458' if md.get('loop') == 'Track'
                               else '\U000F0456')
        self._md_paint_time()
        W['md_seek'].queue_draw()

    def _md_now(self):
        md = self.md
        if md['seek'] is not None:
            return md['seek'] * md['len']
        pos = md['pos']
        if md['playing']:
            pos += time.monotonic() - md['sync']
        return min(pos, md['len']) if md['len'] else pos

    @staticmethod
    def _md_fmt(sec):
        sec = max(0, int(sec))
        h, rem = divmod(sec, 3600)
        m, s = divmod(rem, 60)
        return f'{h}:{m:02d}:{s:02d}' if h else f'{m}:{s:02d}'

    def _md_paint_time(self):
        W = self.qs_widgets
        now, length = self._md_now(), self.md['len']
        W['md_el'].set_label(self._md_fmt(now))
        W['md_rem'].set_label('-' + self._md_fmt(length - now)
                              if length else '')

    def _md_tick(self):
        if not self.qs_win or 'md_seek' not in self.qs_widgets:
            self.md_timer = None
            return False
        if self.md['playing'] or self.md['seek'] is not None:
            self._md_paint_time()
            self.qs_widgets['md_seek'].queue_draw()
        return True

    # seek bar
    def _md_frac(self, w, x):
        pad = 7
        return min(1.0, max(0.0, (x - pad) / max(1, w.get_allocated_width()
                                                 - 2 * pad)))

    def _md_seek_press(self, w, ev):
        if ev.button != 1 or not self.md['len']:
            return False
        self.md['seek'] = self._md_frac(w, ev.x)
        w.queue_draw()
        self._md_paint_time()
        return True

    def _md_seek_motion(self, w, ev):
        if self.md['seek'] is not None:
            self.md['seek'] = self._md_frac(w, ev.x)
            w.queue_draw()
            self._md_paint_time()
        return True

    def _md_seek_release(self, w, ev):
        md = self.md
        if md['seek'] is None:
            return False
        target = md['seek'] * md['len']
        md.update(seek=None, pos=target, sync=time.monotonic())
        subprocess.Popen(['playerctl', '-p', self.md_pick, 'position',
                          f'{target:.2f}'])
        w.queue_draw()
        self._md_paint_time()
        return True

    @staticmethod
    def _md_rrect(cr, x, y, w, h, r):
        import math
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def _md_draw_seek(self, w, cr):
        import math
        W, H = w.get_allocated_width(), w.get_allocated_height()
        pad, th = 7, 4
        active = self.md['hover'] or self.md['seek'] is not None
        if active:
            th = 6
        y = (H - th) / 2
        length = self.md['len']
        frac = (self._md_now() / length) if length else 0
        r, g, b = self.md['color']
        self._md_rrect(cr, pad, y, W - 2 * pad, th, th / 2)
        cr.set_source_rgba(1, 1, 1, 0.18)
        cr.fill()
        fw = (W - 2 * pad) * frac
        if fw > 0.5:
            self._md_rrect(cr, pad, y, max(fw, th), th, th / 2)
            cr.set_source_rgb(r, g, b)
            cr.fill()
        if active and length:
            cr.arc(pad + fw, H / 2, 7, 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.fill()
        return False

    def _md_draw_art(self, w, cr):
        import cairo
        S = MD_ART
        self._md_rrect(cr, 0, 0, S, S, 10)
        art = self.md.get('art')
        if art:
            cr.save()
            cr.clip()
            sw, sh = art.get_width(), art.get_height()
            sc = S / min(sw, sh)
            cr.scale(sc, sc)
            Gdk.cairo_set_source_pixbuf(cr, art, (S / sc - sw) / 2,
                                        (S / sc - sh) / 2)
            cr.get_source().set_filter(cairo.FILTER_BEST)
            cr.paint()
            cr.restore()
        else:
            r, g, b = self.md['color']
            grad = cairo.LinearGradient(0, 0, S, S)
            grad.add_color_stop_rgba(0, r, g, b, 0.85)
            grad.add_color_stop_rgba(1, r * 0.35, g * 0.35, b * 0.35, 0.95)
            cr.set_source(grad)
            cr.fill()
            cr.select_font_face('Commit Mono Nerd Font')
            cr.set_font_size(38)
            glyph = '\U000F075A'
            ext = cr.text_extents(glyph)
            cr.move_to((S - ext.width) / 2 - ext.x_bearing,
                       (S - ext.height) / 2 - ext.y_bearing)
            cr.set_source_rgba(1, 1, 1, 0.9)
            cr.show_text(glyph)
        # hairline edge so dark covers don't melt into the card
        self._md_rrect(cr, 0.5, 0.5, S - 1, S - 1, 10)
        cr.set_source_rgba(1, 1, 1, 0.10)
        cr.set_line_width(1)
        cr.stroke()
        return False

    def _md_draw_bg(self, w, cr):
        import cairo
        W, H = w.get_allocated_width(), w.get_allocated_height()
        R = 14
        self._md_rrect(cr, 0, 0, W, H, R)
        cr.save()
        cr.clip_preserve()
        blur = self.md.get('blur')
        r, g, b = self.md['color']
        if not blur:      # plain acrylic (CSS) with a faint accent wash
            cr.restore()
            cr.new_path()
            return False
        if blur:
            bw, bh = blur.get_width(), blur.get_height()
            sc = max(W / bw, H / bh)
            cr.save()
            cr.scale(sc, sc)
            Gdk.cairo_set_source_pixbuf(cr, blur, (W / sc - bw) / 2,
                                        (H / sc - bh) / 2)
            cr.get_source().set_filter(cairo.FILTER_BILINEAR)
            cr.paint()
            cr.restore()
            shade = cairo.LinearGradient(0, 0, 0, H)
            # bright covers need more shade to keep white text legible
            px = blur.scale_simple(1, 1, GdkPixbuf.InterpType.BILINEAR)
            lum = sum(px.get_pixels()[:3]) / 765
            base = 0.38 + 0.30 * lum
            shade.add_color_stop_rgba(0, 0.04, 0.04, 0.06, base)
            shade.add_color_stop_rgba(0.55, 0.04, 0.04, 0.06, base + 0.12)
            shade.add_color_stop_rgba(1, 0.04, 0.04, 0.06, base + 0.26)
            cr.set_source(shade)
            cr.paint()
        else:
            grad = cairo.LinearGradient(0, 0, W, H)
            grad.add_color_stop_rgba(0, r, g, b, 0.30)
            grad.add_color_stop_rgba(1, r, g, b, 0.06)
            cr.set_source(grad)
            cr.paint()
        cr.restore()
        cr.new_path()
        return False

    # colors
    @staticmethod
    def _md_default_rgb():
        hexcol = wallpaper_accent() or '#6cb8ff'
        return tuple(int(hexcol[i:i + 2], 16) / 255 for i in (1, 3, 5))

    def _md_restyle(self):
        """Tint play button + toggles with the current art color."""
        import colorsys
        r, g, b = self.md['color']
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        fg = '#101216' if l > 0.55 else '#ffffff'
        R, G, B = (round(c * 255) for c in (r, g, b))
        css = f"""
button.mdplay {{ background: rgb({R},{G},{B}); color: {fg}; }}
button.mdplay:hover {{ background: rgba({R},{G},{B},0.85); }}
button.mdside.on {{ color: rgb({R},{G},{B}); }}
.qscard.hasart {{ background: transparent; }}
.qscard.hasart scale highlight {{ background: rgb({R},{G},{B}); }}
.qscard.hasart .qsbtn.on {{ background: rgb({R},{G},{B}); color: {fg}; }}
""".encode()
        if self.md_css is None:
            self.md_css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), self.md_css,
                Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.md_css.load_from_data(css)

    @staticmethod
    def _md_vivid(pix):
        """Most vivid color in a tiny thumbnail, lifted to read on dark."""
        import colorsys
        t = pix.scale_simple(12, 12, GdkPixbuf.InterpType.BILINEAR)
        data, n, rs = t.get_pixels(), t.get_n_channels(), t.get_rowstride()
        best, best_score = (0.6, 0.7, 1.0), -1
        for y in range(12):
            for x in range(12):
                i = y * rs + x * n
                r, g, b = (data[i + k] / 255 for k in range(3))
                h, s, v = colorsys.rgb_to_hsv(r, g, b)
                score = s * v * (0.4 + v)
                if score > best_score:
                    best_score, best = score, (h, s, v)
        h, s, v = best
        if s < 0.12:          # greyscale cover: stay neutral but bright
            return (0.88, 0.88, 0.90)
        return colorsys.hsv_to_rgb(h, min(max(s, 0.45), 0.75),
                                   max(v, 0.85))

    def qs_set_art(self, url):
        if self.md.get('art_key') == (self.md_pick, url):
            return
        self.md['art_key'] = (self.md_pick, url)
        if not url:
            self.md.update(art=None, blur=None, color=self._md_default_rgb())
            self._md_restyle()
            self._md_redraw()
            return
        if url.startswith('file://'):
            try:
                self._apply_art(GLib.filename_from_uri(url)[0], url)
            except Exception:
                pass
        elif url.startswith('http'):
            os.makedirs(ART_DIR, exist_ok=True)
            dest = os.path.join(
                ART_DIR, hashlib.sha1(url.encode()).hexdigest())
            if os.path.exists(dest):
                self._apply_art(dest, url)
            else:
                def dl():
                    try:
                        tmp = dest + '.part'
                        urllib.request.urlretrieve(url, tmp)
                        os.replace(tmp, dest)
                        GLib.idle_add(self._apply_art, dest, url)
                    except Exception:
                        pass
                threading.Thread(target=dl, daemon=True).start()

    def _apply_art(self, path, url=None):
        if not self.qs_win or 'md_art' not in self.qs_widgets:
            return False
        if url is not None and self.md.get('art_key') != (self.md_pick, url):
            return False      # track changed while downloading
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file(path)
        except Exception:
            return False
        side = min(pix.get_width(), pix.get_height())
        sq = pix.new_subpixbuf((pix.get_width() - side) // 2,
                               (pix.get_height() - side) // 2, side, side)
        art = sq.scale_simple(MD_ART * 2, MD_ART * 2,
                              GdkPixbuf.InterpType.HYPER)
        # cheap, soft blur: crush to a few pixels then smooth back up
        tiny = sq.scale_simple(8, 8, GdkPixbuf.InterpType.HYPER)
        blur = tiny.scale_simple(40, 40, GdkPixbuf.InterpType.BILINEAR)
        self.md.update(art=art, blur=blur, color=self._md_vivid(sq))
        self._md_restyle()
        self._md_redraw()
        return False

    def _md_redraw(self):
        card = self.qs_widgets.get('qs_card')
        if card:
            ctx = card.get_style_context()
            ctx.add_class('hasart') if self.md.get('blur') \
                else ctx.remove_class('hasart')
        for k in ('qs_card', 'md_art', 'md_seek'):
            if k in self.qs_widgets:
                self.qs_widgets[k].queue_draw()

    def qs_volume_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        mute = self._qsbtn('󰕾', lambda _b: self._toggle_mute(
            '@DEFAULT_AUDIO_SINK@'))
        scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_draw_value(False)
        scale.set_hexpand(True)
        scale.connect('value-changed', self.on_vol_changed)
        pct = Gtk.Label(label='—')
        pct.get_style_context().add_class('qstitle')
        pct.set_width_chars(4)
        row.pack_start(mute, False, False, 0)
        row.pack_start(scale, True, True, 0)
        row.pack_start(pct, False, False, 0)
        self.qs_widgets.update(mute=mute, scale=scale, pct=pct)
        return row

    def on_vol_changed(self, scale):
        if self.qs_setting:
            return
        v = int(scale.get_value())
        subprocess.Popen(['wpctl', 'set-volume',
                          '@DEFAULT_AUDIO_SINK@', f'{v}%'])
        self.qs_widgets['pct'].set_label(f'{v}%')

    def _toggle_mute(self, target):
        subprocess.run(['wpctl', 'set-mute', target, 'toggle'],
                       capture_output=True)
        self.qs_update()

    def qs_toggle_row(self):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        mic = self._qsbtn('󰍬', lambda _b: self._toggle_mute(
            '@DEFAULT_AUDIO_SOURCE@'))
        row.pack_start(mic, False, False, 0)
        lbl = Gtk.Label(label='Mic')
        lbl.get_style_context().add_class('qsdim')
        row.pack_start(lbl, False, False, 0)
        self.qs_widgets['mic'] = mic

        rgb = self._qsbtn('󰌵', self._toggle_rgb)
        rgb.get_accessible().set_name('Toggle RGB lights')
        row.pack_start(rgb, False, False, 0)
        rgb_label = Gtk.Label(label='RGB')
        rgb_label.get_style_context().add_class('qsdim')
        row.pack_start(rgb_label, False, False, 0)
        self.qs_widgets['rgb'] = rgb
        self._rgb_update()

        if shutil.which('hyprsunset'):
            night = self._qsbtn('󰖔', lambda _b: self._cycle_night())
            night.set_tooltip_text('Click: next intensity · '
                                   'right-click: off')
            night.connect('button-press-event', self._night_press)
            row.pack_end(Gtk.Label(label=''), False, False, 0)
            nlbl = Gtk.Label(label='Night light')
            nlbl.get_style_context().add_class('qsdim')
            row.pack_end(nlbl, False, False, 0)
            row.pack_end(night, False, False, 4)
            self.qs_widgets['night'] = night
            self.qs_widgets['nightlbl'] = nlbl
        return row

    def _rgb_update(self):
        button = self.qs_widgets.get('rgb')
        if button is None:
            return
        state_path = os.path.join(
            os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'),
            'rgb-lights.state')
        try:
            with open(state_path) as f:
                state = f.read().strip()
        except OSError:
            state = 'unknown'
        button.set_sensitive(not self.rgb_busy)
        button.set_label('…' if self.rgb_busy else
                         '󰌵' if state == 'on' else '󰹐')
        ctx = button.get_style_context()
        ctx.add_class('on') if state == 'on' else ctx.remove_class('on')
        button.set_tooltip_text('Changing lights…' if self.rgb_busy else
            self.rgb_error or
            (('RGB lights: off · click to turn on' if state == 'off' else
              'RGB lights: on · click to turn off' if state == 'on' else
              'Click to turn RGB lights off') +
             '\nPC, keyboard and mouse · restored at login'))

    def _toggle_rgb(self, _button):
        if self.rgb_busy:
            return
        self.rgb_busy = True
        self.rgb_error = ''
        self._rgb_update()

        def run():
            error = ''
            try:
                result = subprocess.run(
                    [os.path.expanduser('~/.local/bin/rgb'), 'toggle'],
                    capture_output=True, text=True, timeout=75)
                if result.returncode:
                    error = result.stderr.strip() or 'RGB control failed'
            except Exception as exc:
                error = str(exc)
            GLib.idle_add(self._rgb_finished, error)

        threading.Thread(target=run, daemon=True).start()

    def _rgb_finished(self, error):
        self.rgb_busy = False
        self.rgb_error = error
        self._rgb_update()
        if error:
            subprocess.Popen(['notify-send', '-u', 'normal',
                              'RGB lights', error[:240]])
        return False

    # ---------- night light: Off → warm steps → red shaders ----------
    def _night_load(self):
        try:
            with open(NIGHT_STATE) as f:
                return max(0, min(int(f.read().strip()),
                                  len(NIGHT_STEPS) - 1))
        except Exception:
            return 0

    def _night_save(self):
        try:
            with open(NIGHT_STATE, 'w') as f:
                f.write(str(self.night_step))
        except OSError:
            pass

    @staticmethod
    def _night_running():
        return subprocess.run(['pgrep', '-x', 'hyprsunset'],
                              capture_output=True).returncode == 0

    @staticmethod
    def _night_shader_on():
        """Which night shader file is active: 'red', 'redonly', or None."""
        try:
            out = subprocess.run(
                ['hyprctl', 'getoption', 'decoration:screen_shader', '-j'],
                capture_output=True, text=True, timeout=2).stdout
        except Exception:
            return None
        if os.path.basename(NIGHT_SHADER_REDONLY) in out:
            return 'redonly'
        if os.path.basename(NIGHT_SHADER) in out:
            return 'red'
        return None

    def _night_reconcile(self):
        """Drop back to reality if hyprsunset/the shaders were toggled
        behind our back (killed manually, hyprctl reload, …)."""
        _, val = NIGHT_STEPS[self.night_step]
        if val in ('red', 'redonly'):
            if self._night_shader_on() != val:
                self.night_step = 0
        elif val is not None:
            if not self._night_running():
                self.night_step = 0
        else:
            shader = self._night_shader_on()
            if shader:
                self.night_step = next(i for i, (_, v) in
                                       enumerate(NIGHT_STEPS) if v == shader)
            elif self._night_running():
                self.night_step = 1

    @staticmethod
    def _night_shader_set(path):
        """Point decoration:screen_shader at `path` (or clear it).
        hyprctl keyword is rejected by the non-legacy (lua) parser, so
        write the path to night-shader.conf — read natively by
        hyprland.lua — and hyprctl reload, same trick as the theme CLI.
        Skips the reload when nothing changed."""
        want = path or ''
        try:
            with open(NIGHT_SHADER_CONF) as f:
                if f.read().strip() == want:
                    return
        except OSError:
            pass
        try:
            with open(NIGHT_SHADER_CONF, 'w') as f:
                f.write(want + '\n' if want else '')
        except OSError:
            return
        subprocess.run(['hyprctl', 'reload'], capture_output=True)

    def _night_apply(self):
        _, val = NIGHT_STEPS[self.night_step]
        if val in ('red', 'redonly'):
            subprocess.run(['pkill', '-x', 'hyprsunset'],
                           capture_output=True)
            path, src = ((NIGHT_SHADER, NIGHT_SHADER_SRC) if val == 'red'
                         else (NIGHT_SHADER_REDONLY,
                               NIGHT_SHADER_REDONLY_SRC))
            if not os.path.exists(path):
                with open(path, 'w') as f:
                    f.write(src)
            self._night_shader_set(path)
            return
        self._night_shader_set('')
        if val is None:
            subprocess.run(['pkill', '-x', 'hyprsunset'],
                           capture_output=True)
        elif self._night_running():
            # live instance: retune over IPC, no restart flicker
            subprocess.run(['hyprctl', 'hyprsunset',
                            'temperature', str(val)],
                           capture_output=True)
        else:
            subprocess.Popen(['setsid', '-f', 'hyprsunset',
                              '-t', str(val)])

    def _cycle_night(self):
        self._night_reconcile()
        self.night_step = (self.night_step + 1) % len(NIGHT_STEPS)
        self._night_save()
        self._night_apply()
        GLib.timeout_add(300, self.qs_update)

    def _night_press(self, _btn, event):
        if event.button == 3:   # right-click: straight to Off
            self.night_step = 0
            self._night_save()
            self._night_apply()
            GLib.timeout_add(300, self.qs_update)
            return True
        return False

    @staticmethod
    def _wpctl_vol(target):
        try:
            out = subprocess.run(['wpctl', 'get-volume', target],
                                 capture_output=True, text=True,
                                 timeout=2).stdout
            vol = int(float(out.split()[1]) * 100)
            return vol, '[MUTED]' in out
        except Exception:
            return None, False

    def qs_update(self):
        if not self.qs_win:
            self.qs_timer = None
            return False
        qw = self.qs_widgets
        self._rgb_update()
        vol, muted = self._wpctl_vol('@DEFAULT_AUDIO_SINK@')
        if vol is not None:
            self.qs_setting = True
            qw['scale'].set_value(vol)
            self.qs_setting = False
            qw['pct'].set_label(f'{vol}%')
            qw['mute'].set_label('󰝟' if muted else '󰕾')
        _, mic_muted = self._wpctl_vol('@DEFAULT_AUDIO_SOURCE@')
        qw['mic'].set_label('󰍭' if mic_muted else '󰍬')

        if 'night' in qw:
            self._night_reconcile()
            name, val = NIGHT_STEPS[self.night_step]
            ctx = qw['night'].get_style_context()
            ctx.add_class('on') if val else ctx.remove_class('on')
            qw['nightlbl'].set_label('Night light')

        if 'md_card' in qw:
            self._md_update()
        return True

    # ---------- task view (WIN+TAB): all workspaces + windows ----------
    # ---------- internet flyout (waybar network module) ----------
    # Status from nmcli + /sys, throughput from /proc/net/dev sampled
    # once a second into a sparkline, latency from a background ping.
    def net_close(self):
        if self.net_timer:
            GLib.source_remove(self.net_timer)
            self.net_timer = None
        if self.net_win:
            self.net_win.destroy()
            self.net_win = None
        self.net = {}

    def net_toggle(self):
        if self.net_win:
            self.net_close()
            return
        self.close_bar_popups()
        w = self._backdrop('winbar-net', self.net_close, spare_bar=True)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class('wxcard')
        card.set_halign(Gtk.Align.END)
        card.set_valign(Gtk.Align.END)
        card.set_margin_end(150)
        card.set_margin_bottom(8)
        card.set_size_request(NET_W, -1)
        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        self.net_win = w
        self.net = {'card': card, 'ping': None,
                    'public': None, 'pw_for': None, 'busy': None,
                    'msg': None, 'tick': 0}
        self.net_build()
        w.show_all()
        self.net_tick()
        self.net_timer = GLib.timeout_add(1000, self.net_tick)
        self._net_ping()
        self._net_public_ip()
        threading.Thread(target=lambda: subprocess.run(
            ['nmcli', 'dev', 'wifi', 'rescan'], capture_output=True,
            timeout=15), daemon=True).start()
        GLib.timeout_add(3500, lambda: (self.net_win and self.net_build(),
                                        False)[1])

    @staticmethod
    def _nm(*args):
        try:
            return subprocess.run(['nmcli', '-t', *args], capture_output=True,
                                  text=True, timeout=4).stdout
        except Exception:
            return ''

    @staticmethod
    def _nm_split(line):
        return [f.replace('\\:', ':') for f in re.split(r'(?<!\\):', line)]

    def _net_status(self):
        """Primary route device + what NetworkManager knows about it."""
        dev, src, gw = None, None, None
        try:
            out = subprocess.run(['ip', 'route', 'get', '1.1.1.1'],
                                 capture_output=True, text=True,
                                 timeout=2).stdout
            m = re.search(r'\bdev (\S+)', out)
            dev = m and m.group(1)
            m = re.search(r'\bsrc (\S+)', out)
            src = m and m.group(1)
            m = re.search(r'\bvia (\S+)', out)
            gw = m and m.group(1)
        except Exception:
            pass
        kind, conn = None, None
        for line in self._nm('-f', 'DEVICE,TYPE,STATE,CONNECTION',
                             'dev').splitlines():
            f = self._nm_split(line)
            if len(f) >= 4 and f[0] == dev:
                kind, conn = f[1], f[3]
        speed = None
        try:
            with open(f'/sys/class/net/{dev}/speed') as fh:
                v = int(fh.read().strip())
                if v > 0:
                    speed = f'{v / 1000:g} Gbps' if v >= 1000 else f'{v} Mbps'
        except Exception:
            pass
        ts = None
        try:
            out = subprocess.run(['ip', '-4', '-br', 'addr', 'show',
                                  'tailscale0'], capture_output=True,
                                 text=True, timeout=2).stdout.split()
            ts = out[2].split('/')[0] if len(out) > 2 else None
        except Exception:
            pass
        return dict(dev=dev, ip=src, gw=gw, kind=kind, conn=conn,
                    speed=speed, ts=ts)

    def _net_wifi(self):
        radio = self._nm('radio', 'wifi').strip() == 'enabled'
        nets = {}
        if radio:
            for line in self._nm('-f', 'IN-USE,SSID,SIGNAL,SECURITY', 'dev',
                                 'wifi', 'list', '--rescan', 'no'
                                 ).splitlines():
                f = self._nm_split(line)
                if len(f) < 4 or not f[1]:
                    continue
                use, ssid, sig, sec = f[0] == '*', f[1], int(f[2] or 0), f[3]
                old = nets.get(ssid)
                if not old or use or (sig > old['sig'] and not old['use']):
                    nets[ssid] = dict(ssid=ssid, sig=sig, sec=sec, use=use)
        known = {self._nm_split(l)[0] for l in
                 self._nm('-f', 'NAME,TYPE', 'con', 'show').splitlines()
                 if l.endswith('wireless')}
        lst = sorted(nets.values(), key=lambda n: (not n['use'], -n['sig']))
        return radio, lst[:NET_MAX_WIFI], known

    @staticmethod
    def _net_rate(bps):
        for unit in ('B/s', 'KB/s', 'MB/s', 'GB/s'):
            if bps < 1000 or unit == 'GB/s':
                return (f'{bps:.0f} {unit}' if bps < 10 or unit == 'B/s'
                        else f'{bps:.1f} {unit}' if bps < 100
                        else f'{bps:.0f} {unit}')
            bps /= 1000

    @staticmethod
    def _wifi_glyph(sig):
        return ('\U000F091F', '\U000F0922', '\U000F0925',
                '\U000F0928')[min(3, sig // 25)]

    def net_build(self):
        n = self.net
        n['sel'] = []
        card = n['card']
        for c in card.get_children():
            card.remove(c)
        st = self._net_status()
        n['st'] = st
        radio, nets, known = self._net_wifi()

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ('top', 'start', 'end'):
            getattr(body, f'set_margin_{m}')(20)
        body.set_margin_bottom(16)

        # hero
        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        online = bool(st['dev'])
        if not online:
            glyph, title, sub = '\U000F05AA', 'Not connected', 'No internet route'
        elif st['kind'] == 'wifi':
            cur = next((x for x in nets if x['use']), None)
            glyph = self._wifi_glyph(cur['sig'] if cur else 100)
            title = st['conn'] or 'Wi-Fi'
            sub = f"Wi-Fi  ·  {cur['sig']}% signal" if cur else 'Wi-Fi'
        else:
            glyph = '\U000F0200'
            title = 'Ethernet'
            sub = st['conn'] or st['dev']
            if st['speed']:
                sub += f"  ·  {st['speed']}"
        # drawn, not a Label: centred on the glyph's ink box, since nerd
        # font glyphs carry uneven side bearings
        g = Gtk.DrawingArea()
        g.set_size_request(56, 56)
        g.connect('draw', self._net_draw_glyph, glyph, online)
        hero.pack_start(g, False, False, 0)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        tb.set_valign(Gtk.Align.CENTER)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.pack_start(self._lbl(title, 'nettitle'), False, False, 0)
        pill = self._lbl('Connected' if online else 'Offline', 'netpill')
        pill.get_style_context().add_class('on' if online else 'off')
        pill.set_valign(Gtk.Align.CENTER)
        row.pack_start(pill, False, False, 0)
        tb.pack_start(row, False, False, 0)
        tb.pack_start(self._lbl(sub, 'wxsub'), False, False, 0)
        hero.pack_start(tb, True, True, 0)
        body.pack_start(hero, False, False, 0)

        # live throughput
        if online:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.get_style_context().add_class('netgraphbox')
            rates = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            down = self._lbl('\U000F01DA  —', 'netrate')
            down.get_style_context().add_class('down')
            up = self._lbl('\U000F0552  —', 'netrate')
            up.get_style_context().add_class('up')
            rates.pack_start(down, False, False, 0)
            rates.pack_start(up, False, False, 0)
            ping = self._lbl('', 'wxdim', 1.0)
            rates.pack_end(ping, False, False, 0)
            box.pack_start(rates, False, False, 0)
            graph = Gtk.DrawingArea()
            graph.set_size_request(-1, 58)
            graph.connect('draw', self._net_draw_graph)
            box.pack_start(graph, False, False, 0)
            foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            cap = self._lbl('', 'netcap')
            cap.set_ellipsize(Pango.EllipsizeMode.END)
            foot.pack_start(cap, True, True, 0)
            tabs = {}
            for key, label in (('session', 'Session'), ('live', 'Live')):
                t = Gtk.Button(label=label)
                t.get_style_context().add_class('nettab')
                t.set_can_focus(False)
                t.connect('clicked', lambda *_, k=key: self._net_set_view(k))
                foot.pack_end(t, False, False, 0)
                tabs[key] = t
            box.pack_start(foot, False, False, 0)
            body.pack_start(box, False, False, 0)
            n.update(w_down=down, w_up=up, w_ping=ping, w_graph=graph,
                     w_cap=cap, w_tabs=tabs)
            self._net_set_view(self.net_view)

            # details
            chips = Gtk.Grid()
            chips.set_column_spacing(8)
            chips.set_row_spacing(8)
            chips.set_column_homogeneous(True)
            items = [('\U000F0A5F', 'Local IP', st['ip'] or '—'),
                     ('\U000F01A7', 'Public IP', n['public'] or '…'),
                     ('\U000F0484', 'Gateway', st['gw'] or '—')]
            items.append(('\U000F0582', 'Tailscale', st['ts'])
                         if st['ts'] else
                         ('\U000F0FDA', 'Interface', st['dev']))
            for i, (gl, name, val) in enumerate(items):
                chip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                chip.get_style_context().add_class('wxchip')
                top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                              spacing=5)
                top.pack_start(self._lbl(gl, 'wxchipglyph'), False, False, 0)
                top.pack_start(self._lbl(name, 'wxdim'), False, False, 0)
                chip.pack_start(top, False, False, 0)
                vl = self._lbl(val, 'netval')
                vl.set_ellipsize(Pango.EllipsizeMode.END)
                vl.set_halign(Gtk.Align.START)   # spoiler pill hugs the text
                vl.set_can_focus(False)   # selectable, but don't open highlighted
                chip.pack_start(vl, False, False, 0)
                if name == 'Public IP':
                    n['w_public'] = vl
                if name in NET_SPOILERS:
                    # Discord-style spoiler: text painted out until
                    # clicked; n is rebuilt on every open, so it re-hides
                    eye = self._lbl('', 'netspoileye')
                    top.pack_end(eye, False, False, 0)
                    eb = Gtk.EventBox()
                    eb.add(chip)
                    eb.connect('button-press-event', lambda *_, k=name: (
                        self._net_spoil(k), True)[1])
                    n.setdefault('spoil_w', {})[name] = (chip, vl, eye)
                    self._net_spoil_paint(name)
                    chips.attach(eb, i % 2, i // 2, 1, 1)
                    continue
                vl.set_selectable(True)
                n.setdefault('sel', []).append(vl)
                chips.attach(chip, i % 2, i // 2, 1, 1)
            body.pack_start(chips, False, False, 0)

        # wi-fi
        wf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hdr.pack_start(self._lbl('Wi-Fi', 'wxhdr'), False, False, 0)
        if n['busy']:
            sp = Gtk.Spinner()
            sp.start()
            hdr.pack_start(sp, False, False, 0)
        # hand-drawn pill: Gtk.Switch's on/off icons are missing from
        # the icon theme and render as broken-image glyphs
        sw = Gtk.Button()
        sw.set_relief(Gtk.ReliefStyle.NONE)
        sw.set_can_focus(False)
        sw.set_valign(Gtk.Align.CENTER)
        sw.get_style_context().add_class('wxtoggle')
        if radio:
            sw.get_style_context().add_class('on')
        knob = Gtk.Box()
        knob.get_style_context().add_class('wxknob')
        knob.set_halign(Gtk.Align.END if radio else Gtk.Align.START)
        knob.set_valign(Gtk.Align.CENTER)
        sw.add(knob)
        sw.set_tooltip_text('Turn Wi-Fi ' + ('off' if radio else 'on'))
        sw.connect('clicked', lambda *_: self._net_radio(not radio))
        hdr.pack_end(sw, False, False, 0)
        if radio:
            rb = Gtk.Button(label='\U000F0450')
            rb.get_style_context().add_class('wxicon')
            rb.set_tooltip_text('Scan')
            rb.connect('clicked', self._net_rescan)
            hdr.pack_end(rb, False, False, 0)
        wf.pack_start(hdr, False, False, 0)
        if n['msg']:
            wf.pack_start(self._lbl(n['msg'], 'wxerr'), False, False, 0)
        if radio:
            lb = Gtk.ListBox()
            lb.get_style_context().add_class('netlist')
            lb.set_selection_mode(Gtk.SelectionMode.NONE)
            for net in nets:
                lb.add(self._net_row(net, known))
            if not nets:
                lb.add(self._lbl('No networks found', 'wxdim'))
            sc = Gtk.ScrolledWindow()
            sc.get_style_context().add_class('stscroll')
            sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sc.set_propagate_natural_height(True)
            sc.set_max_content_height(NET_LIST_H)
            sc.add(lb)
            wf.pack_start(sc, False, False, 0)
        else:
            wf.pack_start(self._lbl('Wi-Fi is off', 'wxdim'), False, False, 0)
        body.pack_start(wf, False, False, 0)
        card.pack_start(body, False, False, 0)

        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        foot.get_style_context().add_class('wxfooter')
        src = self._lbl(st['dev'] or 'offline', 'wxdim')
        src.set_margin_start(20)
        foot.pack_start(src, False, False, 0)
        fb = Gtk.Button(label='Network settings  \U000F03CC')
        fb.get_style_context().add_class('wxlink')
        fb.set_margin_end(12)
        fb.connect('clicked', self._net_settings)
        foot.pack_end(fb, False, False, 0)
        card.pack_start(foot, False, False, 0)
        card.show_all()
        # GTK selects a selectable label's text when the window takes focus
        GLib.idle_add(lambda: [l.select_region(0, 0)
                               for l in n.get('sel', [])] and False)
        self._net_paint()

    def _net_row(self, net, known):
        n = self.net
        row = Gtk.ListBoxRow()
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        g = self._lbl(self._wifi_glyph(net['sig']), 'netwglyph')
        if net['use']:
            g.get_style_context().add_class('online')
        h.pack_start(g, False, False, 0)
        tv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        tv.set_valign(Gtk.Align.CENTER)
        nm = self._lbl(net['ssid'], 'netval')
        nm.set_ellipsize(Pango.EllipsizeMode.END)
        tv.pack_start(nm, False, False, 0)
        secured = net['sec'] not in ('', '--')
        sub = ('Connected' if net['use'] else
               'Saved' if net['ssid'] in known else
               'Secured' if secured else 'Open')
        if n['busy'] == net['ssid']:
            sub = 'Connecting…'
        tv.pack_start(self._lbl(sub, 'wxdim'), False, False, 0)
        h.pack_start(tv, True, True, 0)
        if secured:
            h.pack_end(self._lbl('\U000F033E', 'netlock'), False, False, 0)
        if net['use']:
            b = Gtk.Button(label='Disconnect')
            b.get_style_context().add_class('wxlink')
            b.connect('clicked', lambda *_: self._net_run(
                ['nmcli', 'dev', 'disconnect', n['st']['dev'] or 'wlan0'],
                net['ssid']))
            h.pack_end(b, False, False, 0)
        v.pack_start(h, False, False, 0)

        if n['pw_for'] == net['ssid']:
            pr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            pr.get_style_context().add_class('wxsearch')
            e = Gtk.Entry()
            e.get_style_context().add_class('wxentry')
            e.set_visibility(False)
            e.set_placeholder_text('Password')
            e.set_hexpand(True)
            go = Gtk.Button(label='\U000F012C')
            go.get_style_context().add_class('wxicon')

            def submit(*_):
                self.net['pw_for'] = None
                self._net_run(['nmcli', 'dev', 'wifi', 'connect',
                               net['ssid'], 'password', e.get_text()],
                              net['ssid'])
            e.connect('activate', submit)
            go.connect('clicked', submit)
            pr.pack_start(e, True, True, 0)
            pr.pack_start(go, False, False, 0)
            v.pack_start(pr, False, False, 0)
            GLib.idle_add(lambda: (e.grab_focus(), False)[1])

        eb = Gtk.EventBox()
        eb.add(v)
        eb.connect('button-press-event',
                   lambda *_: (self._net_pick(net, known), True)[1]
                   if not net['use'] and n['pw_for'] != net['ssid']
                   else False)
        row.add(eb)
        return row

    def _net_spoil(self, name):
        shown = self.net.setdefault('shown', set())
        shown.symmetric_difference_update({name})
        self._net_spoil_paint(name)

    def _net_spoil_paint(self, name):
        chip, vl, eye = self.net['spoil_w'][name]
        shown = name in self.net.get('shown', ())
        ctx = vl.get_style_context()
        if shown:
            ctx.remove_class('spoiler')
        else:
            ctx.add_class('spoiler')
        vl.set_selectable(shown)
        if shown:
            GLib.idle_add(lambda: (vl.select_region(0, 0), False)[1])
        eye.set_label('\U000F0209' if shown else '\U000F0208')
        chip.set_tooltip_text('Click to hide' if shown else 'Click to reveal')

    def _net_pick(self, net, known):
        if self.net['busy']:
            return
        if net['ssid'] in known:
            self._net_run(['nmcli', 'con', 'up', 'id', net['ssid']],
                          net['ssid'])
        elif net['sec'] in ('', '--'):
            self._net_run(['nmcli', 'dev', 'wifi', 'connect', net['ssid']],
                          net['ssid'])
        else:
            self.net['pw_for'] = net['ssid']
            if hasattr(GtkLayerShell, 'set_keyboard_mode'):
                GtkLayerShell.set_keyboard_mode(
                    self.net_win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
            self.net_build()

    def _net_run(self, cmd, ssid):
        self.net.update(busy=ssid, msg=None)
        self.net_build()

        def run():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True,
                                   timeout=45)
                err = None if r.returncode == 0 else (
                    (r.stderr or r.stdout).strip().splitlines() or ['Failed']
                )[-1]
            except Exception as e:
                err = str(e)
            GLib.idle_add(self._net_ran, err)
        threading.Thread(target=run, daemon=True).start()

    def _net_ran(self, err):
        if self.net_win:
            if err:
                err = re.sub(r'^Error:\s*', '', err)
                if 'Secrets were required' in err or 'password' in err.lower():
                    err = 'Wrong password'
            self.net.update(busy=None, msg=err)
            self.net_build()
        return False

    def _net_radio(self, on):
        subprocess.Popen(['nmcli', 'radio', 'wifi', 'on' if on else 'off'])
        GLib.timeout_add(1500, lambda: (self.net_win and self.net_build(),
                                        False)[1])

    def _net_rescan(self, *_):
        self.net['busy'] = '…'
        self.net_build()

        def run():
            subprocess.run(['nmcli', 'dev', 'wifi', 'rescan'],
                           capture_output=True, timeout=15)
            time.sleep(2.5)
            GLib.idle_add(self._net_ran, None)
        threading.Thread(target=run, daemon=True).start()

    def _net_settings(self, *_):
        self.net_close()
        if shutil.which('nm-connection-editor'):
            cmd = ['nm-connection-editor']
        else:
            term = shutil.which('kitty') or shutil.which('alacritty')
            cmd = [term, '-e', 'nmtui'] if term else ['nmtui']
        subprocess.Popen(cmd, start_new_session=True)

    def _net_ping(self):
        def run():
            ms = None
            try:
                out = subprocess.run(['ping', '-c1', '-W1', '1.1.1.1'],
                                     capture_output=True, text=True,
                                     timeout=3).stdout
                m = re.search(r'time=([\d.]+)', out)
                ms = float(m.group(1)) if m else None
            except Exception:
                pass
            GLib.idle_add(self._net_set, 'ping', ms)
        threading.Thread(target=run, daemon=True).start()

    def _net_public_ip(self):
        if self.net_public:
            self.net['public'] = self.net_public
            return

        def run():
            ip = None
            try:
                with urllib.request.urlopen('https://api.ipify.org',
                                            timeout=6) as r:
                    ip = r.read().decode().strip()
            except Exception:
                pass
            GLib.idle_add(self._net_set, 'public', ip or 'unavailable')
        threading.Thread(target=run, daemon=True).start()

    def _net_set(self, key, val):
        if self.net_win:
            self.net[key] = val
            if key == 'public' and val != 'unavailable':
                self.net_public = val
            self._net_paint()
        return False

    @staticmethod
    def _net_counters():
        """rx/tx bytes summed over physical NICs (skips lo, docker, veth,
        bridges and tunnels, whose traffic also crosses a real NIC)."""
        rx = tx = 0
        with open('/proc/net/dev') as f:
            for line in f.readlines()[2:]:
                name, _, rest = line.partition(':')
                name = name.strip()
                if not os.path.exists(f'/sys/class/net/{name}/device'):
                    continue
                v = rest.split()
                rx += int(v[0])
                tx += int(v[8])
        return rx, tx

    def _nstat_sample(self):
        ns = self.nstat
        try:
            rx, tx = self._net_counters()
        except Exception:
            return True
        now = time.monotonic()
        if ns['last']:
            lrx, ltx, lt = ns['last']
            dt = max(0.001, now - lt)
            # counters reset when a NIC goes down/up: count that tick as 0
            drx, dtx = max(0, rx - lrx), max(0, tx - ltx)
            ns['rx'] += drx
            ns['tx'] += dtx
            ns['live'].append((drx / dt, dtx / dt))
            del ns['live'][:-NET_HIST]
            cur = ns['cur']
            cur[0] += drx
            cur[1] += dtx
            cur[2] += dt
            if cur[2] >= ns['span']:
                ns['buckets'].append(tuple(cur))
                ns['cur'] = [0, 0, 0.0]
                bk = ns['buckets']
                if len(bk) >= 2 * NET_SESS_N:
                    ns['buckets'] = [
                        tuple(x + y for x, y in zip(bk[i], bk[i + 1]))
                        for i in range(0, len(bk) - 1, 2)]
                    ns['span'] *= 2
        ns['last'] = (rx, tx, now)
        if self.net_win:
            self._net_paint()
        return True

    def _net_series(self):
        ns = self.nstat
        if self.net_view == 'live':
            return ns['live']
        pts = [(r / t, x / t) for r, x, t in ns['buckets'] if t > 0]
        r, x, t = ns['cur']
        if t >= 1:
            pts.append((r / t, x / t))
        return pts

    def _net_set_view(self, view):
        self.net_view = view
        for k, btn in self.net.get('w_tabs', {}).items():
            ctx = btn.get_style_context()
            ctx.add_class('on') if k == view else ctx.remove_class('on')
        self._net_paint()

    @staticmethod
    def _net_bytes(n):
        for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
            if n < 1000 or unit == 'TB':
                return f'{n:.0f} {unit}' if unit == 'B' or n >= 100 \
                    else f'{n:.1f} {unit}'
            n /= 1000

    def net_tick(self):
        """Panel-only work: ping every 3 s (sampling runs all session)."""
        if not self.net_win:
            self.net_timer = None
            return False
        n = self.net
        n['tick'] += 1
        if n['tick'] % 3 == 0:
            self._net_ping()
        return True

    def _net_paint(self):
        n = self.net
        if 'w_down' not in n:
            return
        ns = self.nstat
        if ns['live']:
            d, u = ns['live'][-1]
            n['w_down'].set_label('\U000F01DA  ' + self._net_rate(d))
            n['w_up'].set_label('\U000F0552  ' + self._net_rate(u))
        if self.net_view == 'live':
            cap = 'Last 60 seconds'
        else:
            since = time.strftime('%-I:%M %p', time.localtime(ns['start']))
            cap = (f"Since {since}   \U000F01DA {self._net_bytes(ns['rx'])}"
                   f"   \U000F0552 {self._net_bytes(ns['tx'])}")
        n['w_cap'].set_label(cap)
        p = n.get('ping')
        n['w_ping'].set_label(f'{p:.0f} ms ping' if p is not None else '')
        if n.get('w_public') and n.get('public'):
            n['w_public'].set_label(n['public'])
        n['w_graph'].queue_draw()

    def _net_draw_glyph(self, w, cr, glyph, online):
        S = 56
        r, g, b = self._md_default_rgb() if online else (1, 1, 1)
        self._md_rrect(cr, 0, 0, S, S, 14)
        cr.set_source_rgba(r, g, b, 0.16 if online else 0.07)
        cr.fill()
        gi.require_version('PangoCairo', '1.0')
        from gi.repository import PangoCairo
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(
            Pango.FontDescription('Commit Mono Nerd Font 22'))
        layout.set_text(glyph, -1)
        ink, _ = layout.get_pixel_extents()
        cr.move_to(round((S - ink.width) / 2 - ink.x),
                   round((S - ink.height) / 2 - ink.y))
        cr.set_source_rgba(r, g, b, 1 if online else 0.55)
        PangoCairo.show_layout(cr, layout)
        return False

    def _net_draw_graph(self, w, cr):
        import cairo
        W, H = w.get_allocated_width(), w.get_allocated_height()
        hist = self._net_series()
        r, g, b = self._md_default_rgb()
        peak = max([64e3] + [max(x) for x in hist])
        slots = NET_HIST if self.net_view == 'live' else len(hist)
        step = W / max(1, slots - 1)
        cr.set_source_rgba(1, 1, 1, 0.06)
        cr.set_line_width(1)
        for i in (1, 2, 3):
            y = round(H * i / 4) + 0.5
            cr.move_to(0, y)
            cr.line_to(W, y)
        cr.stroke()
        if len(hist) < 2:
            return False
        x0 = W - (len(hist) - 1) * step

        def path(idx):
            cr.move_to(x0, H - hist[0][idx] / peak * (H - 4))
            for i, s in enumerate(hist[1:], 1):
                cr.line_to(x0 + i * step, H - s[idx] / peak * (H - 4))

        path(0)
        cr.line_to(W, H)
        cr.line_to(x0, H)
        cr.close_path()
        grad = cairo.LinearGradient(0, 0, 0, H)
        grad.add_color_stop_rgba(0, r, g, b, 0.45)
        grad.add_color_stop_rgba(1, r, g, b, 0.02)
        cr.set_source(grad)
        cr.fill()
        path(0)
        cr.set_source_rgb(r, g, b)
        cr.set_line_width(1.6)
        cr.stroke()
        path(1)
        cr.set_source_rgba(1, 1, 1, 0.55)
        cr.set_line_width(1.2)
        cr.set_dash([3, 3])
        cr.stroke()
        return False

    # ---------- clock / calendar flyout (waybar clock) ----------
    def clk_close(self):
        if self.clk_timer:
            GLib.source_remove(self.clk_timer)
            self.clk_timer = None
        if self.clk_win:
            self.clk_win.destroy()
            self.clk_win = None
        self.clk = {}

    def clk_toggle(self):
        if self.clk_win:
            self.clk_close()
            return
        self.close_bar_popups()
        w = self._backdrop('winbar-clock', self.clk_close, spare_bar=True)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class('wxcard')
        card.set_halign(Gtk.Align.END)
        card.set_valign(Gtk.Align.END)
        card.set_margin_end(10)
        card.set_margin_bottom(8)
        card.set_size_request(CLK_W, -1)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        for m in ('top', 'start', 'end'):
            getattr(body, f'set_margin_{m}')(22)
        body.set_margin_bottom(18)

        # big time
        tr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        hm = self._lbl('', 'clkbig')
        sec = self._lbl('', 'clksec')
        sec.set_valign(Gtk.Align.END)
        sec.set_margin_bottom(11)
        ampm = self._lbl('', 'clkampm')
        ampm.set_valign(Gtk.Align.END)
        ampm.set_margin_bottom(12)
        ampm.set_margin_start(8)
        tr.pack_start(hm, False, False, 0)
        tr.pack_start(sec, False, False, 0)
        tr.pack_start(ampm, False, False, 0)
        body.pack_start(tr, False, False, 0)
        date = self._lbl('', 'clkdate')
        tv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        body.remove(tr)
        tv.pack_start(tr, False, False, 0)
        tv.pack_start(date, False, False, 0)
        body.pack_start(tv, False, False, 0)

        # calendar
        cal = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        cal.get_style_context().add_class('clkcal')
        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        month = Gtk.Button(label='')
        month.get_style_context().add_class('wxlink')
        month.get_style_context().add_class('clkmonth')
        month.set_tooltip_text('Back to today')
        month.connect('clicked', lambda *_: self._clk_month(None))
        nav.pack_start(month, False, False, 0)
        for glyph, step in (('\U000F0140', 1), ('\U000F0143', -1)):
            b = Gtk.Button(label=glyph)
            b.get_style_context().add_class('wxicon')
            b.connect('clicked', lambda *_, s=step: self._clk_month(s))
            nav.pack_end(b, False, False, 0)
        cal.pack_start(nav, False, False, 0)
        grid = Gtk.Grid()
        grid.set_column_homogeneous(True)
        grid.set_row_spacing(2)
        grid.set_column_spacing(2)
        cal.pack_start(grid, False, False, 0)
        ev = Gtk.EventBox()
        ev.add_events(Gdk.EventMask.SCROLL_MASK
                      | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        ev.connect('scroll-event', self._clk_scroll)
        ev.add(cal)
        body.pack_start(ev, False, False, 0)
        card.pack_start(body, False, False, 0)

        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        foot.get_style_context().add_class('wxfooter')
        info = self._lbl('', 'wxdim')
        info.set_margin_start(22)
        foot.pack_start(info, False, False, 0)
        tz = self._lbl('', 'wxdim', 1.0)
        tz.set_margin_end(22)
        foot.pack_end(tz, False, False, 0)
        card.pack_start(foot, False, False, 0)

        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        now = time.localtime()
        self.clk = dict(hm=hm, sec=sec, ampm=ampm, date=date, month=month,
                        grid=grid, info=info, tz=tz,
                        ym=(now.tm_year, now.tm_mon))
        self.clk_win = w
        self._clk_fill()
        self.clk_tick()
        w.show_all()
        # tick on the second boundary so seconds never skip
        GLib.timeout_add(1000 - int(time.time() * 1000) % 1000 + 5,
                         self._clk_start)

    def _clk_start(self):
        if self.clk_win:
            self.clk_tick()
            self.clk_timer = GLib.timeout_add(1000, self.clk_tick)
        return False

    def clk_tick(self):
        if not self.clk_win:
            self.clk_timer = None
            return False
        c = self.clk
        now = time.localtime()
        c['hm'].set_label(time.strftime('%-I:%M', now))
        c['sec'].set_label(time.strftime(':%S', now))
        c['ampm'].set_label(time.strftime('%p', now))
        c['date'].set_label(time.strftime('%A, %B %-d, %Y', now))
        days = 366 if (now.tm_year % 4 == 0 and (now.tm_year % 100 != 0
                                                  or now.tm_year % 400 == 0)
                       ) else 365
        c['info'].set_label(f"Week {time.strftime('%V', now).lstrip('0')}"
                            f"  ·  Day {now.tm_yday} of {days}")
        off = time.strftime('%z', now)
        c['tz'].set_label(f"{time.strftime('%Z', now)}  "
                          f"UTC{off[0]}{int(off[1:3])}"
                          + (f':{off[3:]}' if off[3:] != '00' else ''))
        if c.get('today') != now.tm_yday:     # midnight rollover
            if c.get('today') is not None:
                self._clk_fill()
            c['today'] = now.tm_yday
        return True

    def _clk_month(self, step):
        y, m = self.clk['ym']
        if step is None:
            now = time.localtime()
            y, m = now.tm_year, now.tm_mon
        else:
            m += step
            y, m = (y + (m - 1) // 12, (m - 1) % 12 + 1)
        self.clk['ym'] = (y, m)
        self._clk_fill()

    def _clk_scroll(self, _w, ev):
        d = ev.direction
        if d == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            if not ok or abs(dy) < 0.5:
                return True
            step = 1 if dy > 0 else -1
        else:
            step = {Gdk.ScrollDirection.DOWN: 1,
                    Gdk.ScrollDirection.UP: -1}.get(d)
        if step:
            self._clk_month(step)
        return True

    def _clk_fill(self):
        import calendar
        c = self.clk
        y, m = c['ym']
        now = time.localtime()
        c['month'].set_label(f'{calendar.month_name[m]} {y}')
        grid = c['grid']
        for ch in grid.get_children():
            grid.remove(ch)
        for i, wd in enumerate(('Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa')):
            grid.attach(self._lbl(wd, 'clkwd', 0.5), i, 0, 1, 1)
        cal = calendar.Calendar(firstweekday=6)
        weeks = cal.monthdatescalendar(y, m)
        while len(weeks) < 6:          # fixed height: no jumping
            last = weeks[-1][-1]
            import datetime
            weeks.append([last + datetime.timedelta(days=i)
                          for i in range(1, 8)])
        for r, week in enumerate(weeks, 1):
            for col, d in enumerate(week):
                lbl = self._lbl(str(d.day), 'clkday', 0.5)
                ctx = lbl.get_style_context()
                if d.month != m:
                    ctx.add_class('other')
                if (d.year, d.month, d.day) == (now.tm_year, now.tm_mon,
                                                now.tm_mday):
                    ctx.add_class('clktoday')
                if col in (0, 6):
                    ctx.add_class('weekend')
                lbl.set_size_request(36, 34)
                lbl.set_halign(Gtk.Align.CENTER)
                grid.attach(lbl, col, r, 1, 1)
        grid.show_all()

    # ---------- weather flyout (opened from the waybar weather module) ----
    # Data is wttr.in j1 JSON, shared with ~/.config/waybar/scripts/
    # weather.py through WX_CACHE: whoever fetches writes it, both read it.
    def wx_close(self):
        self.wx_editing = False
        self.wx_error = None
        if self.wx_win:
            self.wx_win.destroy()
            self.wx_win = None
        self.wx_body = None

    def wx_toggle(self):
        if self.wx_win:
            self.wx_close()
            return
        self.close_bar_popups()
        w = self._backdrop(
            'winbar-weather', self.wx_close, spare_bar=True,
            on_escape=lambda: (self.wx_cancel_edit() if self.wx_editing
                               else self.wx_close()))
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.get_style_context().add_class('wxcard')
        card.set_halign(Gtk.Align.END)
        card.set_valign(Gtk.Align.END)
        card.set_margin_end(96)
        card.set_margin_bottom(8)
        card.set_size_request(WX_W, -1)
        self.wx_body = card
        w.add(self._swallow_clicks(card))
        gm = self._cursor_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        self.wx_win = w

        data, age = self.wx_load()
        self.wx_render(data)
        w.show_all()
        if data is None or age > WX_MAX_AGE:
            self.wx_refresh()

    @staticmethod
    def wx_load():
        try:
            with open(WX_CACHE) as f:
                data = json.load(f)
            if data.get('_loc', '') != wx_location():
                return data, 1e9
            return data, time.time() - os.path.getmtime(WX_CACHE)
        except Exception:
            return None, 1e9

    def wx_refresh(self, *_, loc=None):
        """Fetch fresh data. With loc, try that place first and only
        save it as the new location if wttr.in recognises it."""
        if self.wx_fetching:
            return
        self.wx_fetching = True
        self.wx_error = None
        if self.wx_win and self.wx_body:
            self.wx_render(self.wx_load()[0])
        new_loc = loc is not None
        loc = wx_location() if loc is None else loc.strip()

        def run():
            data = None
            try:
                req = urllib.request.Request(
                    wx_url(loc), headers={'User-Agent': 'curl/8'})
                with urllib.request.urlopen(req, timeout=12) as r:
                    data = json.load(r)
                if not data.get('current_condition'):
                    raise ValueError('unknown location')
                data['_loc'] = loc
                if new_loc:
                    os.makedirs(os.path.dirname(WX_LOC_FILE), exist_ok=True)
                    with open(WX_LOC_FILE, 'w') as f:
                        f.write(loc + '\n')
                os.makedirs(os.path.dirname(WX_CACHE), exist_ok=True)
                tmp = WX_CACHE + '.tmp'
                with open(tmp, 'w') as f:
                    json.dump(data, f)
                os.replace(tmp, WX_CACHE)
                # nudge the bar module so it shows the same reading
                subprocess.Popen(['pkill', '-RTMIN+8', '-x', 'waybar'])
            except Exception as e:
                print(f'winbar-dock: weather fetch failed: {e}',
                      file=sys.stderr)
                if new_loc:
                    self.wx_error = f'Couldn\u2019t find \u201c{loc}\u201d'
            GLib.idle_add(self._wx_fetched, data)
        threading.Thread(target=run, daemon=True).start()

    def _wx_fetched(self, data):
        self.wx_fetching = False
        if data is not None:
            self.wx_editing = False
        if self.wx_win and self.wx_body:
            self.wx_render(data or self.wx_load()[0])
        return False

    def wx_start_edit(self, *_):
        self.wx_editing = True
        self.wx_error = None
        # the entry needs the keyboard; ON_DEMAND alone won't hand it over
        if hasattr(GtkLayerShell, 'set_keyboard_mode'):
            GtkLayerShell.set_keyboard_mode(
                self.wx_win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        self.wx_render(self.wx_load()[0])

    def wx_cancel_edit(self, *_):
        self.wx_editing = False
        self.wx_render(self.wx_load()[0])

    def wx_loc_editor(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        row.get_style_context().add_class('wxsearch')
        row.pack_start(self._lbl('\U000F034E', 'wxpin'), False, False, 0)
        entry = Gtk.Entry()
        entry.get_style_context().add_class('wxentry')
        entry.set_placeholder_text('City, ZIP code or airport')
        entry.set_text(wx_location())
        entry.set_hexpand(True)
        entry.set_sensitive(not self.wx_fetching)

        def submit(*_):
            self.wx_refresh(loc=entry.get_text())

        def key(_e, ev):
            if ev.keyval == Gdk.KEY_Escape:
                self.wx_cancel_edit()
                return True
            return False
        entry.connect('activate', submit)
        entry.connect('key-press-event', key)
        row.pack_start(entry, True, True, 0)
        ok = Gtk.Button(label='\U000F012C')
        ok.get_style_context().add_class('wxicon')
        ok.set_tooltip_text('Set location')
        ok.connect('clicked', submit)
        row.pack_start(ok, False, False, 0)
        box.pack_start(row, False, False, 0)
        hint = self._lbl('City, ZIP code or airport \u2014 e.g. Tokyo, '
                         '90210, LAX', 'wxdim')
        hint.set_margin_start(14)
        box.pack_start(hint, False, False, 0)

        acts = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        auto = Gtk.Button(label='\U000F01A4  Use my location')
        auto.get_style_context().add_class('wxlink')
        auto.set_tooltip_text('Locate automatically from your IP address')
        auto.connect('clicked', lambda *_: self.wx_refresh(loc=''))
        acts.pack_start(auto, False, False, 0)
        cancel = Gtk.Button(label='Cancel')
        cancel.get_style_context().add_class('wxlink')
        cancel.connect('clicked', self.wx_cancel_edit)
        acts.pack_end(cancel, False, False, 0)
        if self.wx_fetching:
            sp = Gtk.Spinner()
            sp.start()
            acts.pack_end(sp, False, False, 4)
        for b in (auto, cancel):
            b.set_sensitive(not self.wx_fetching)
        box.pack_start(acts, False, False, 0)
        GLib.idle_add(lambda: (entry.grab_focus(),
                               entry.set_position(-1), False)[2])
        return box

    @staticmethod
    def wx_kind(code, night=False):
        code = int(code)
        kind = next((k for k, codes in WX_GROUPS.items() if code in codes),
                    'clear')
        if night and kind in ('clear', 'partly'):
            kind = 'night' if kind == 'clear' else 'partly_n'
        return kind

    @staticmethod
    def wx_is_night(astro, hhmm):
        """hhmm: minutes since midnight."""
        try:
            def mins(s):
                t = time.strptime(s.strip(), '%I:%M %p')
                return t.tm_hour * 60 + t.tm_min
            return not (mins(astro['sunrise']) <= hhmm < mins(astro['sunset']))
        except Exception:
            return False

    def wx_glyph(self, kind, size_class):
        lbl = Gtk.Label(label=WX_ICONS[kind])
        ctx = lbl.get_style_context()
        ctx.add_class('wxglyph')
        ctx.add_class(size_class)
        ctx.add_class('wx-' + kind)
        return lbl

    @staticmethod
    def _lbl(text, cls, xalign=0.0):
        l = Gtk.Label(label=text)
        l.get_style_context().add_class(cls)
        l.set_xalign(xalign)
        return l

    def wx_render(self, data):
        card = self.wx_body
        for c in card.get_children():
            card.remove(c)

        if not data:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            box.set_size_request(-1, 220)
            box.set_valign(Gtk.Align.CENTER)
            if self.wx_fetching:
                sp = Gtk.Spinner()
                sp.start()
                sp.set_size_request(28, 28)
                box.pack_start(sp, True, False, 0)
                box.pack_start(self._lbl('Fetching weather…', 'wxdim', 0.5),
                               False, False, 0)
            else:
                box.pack_start(self._lbl('Weather unavailable', 'wxsub', 0.5),
                               True, False, 0)
                b = Gtk.Button(label='Try again')
                b.get_style_context().add_class('wxlink')
                b.set_halign(Gtk.Align.CENTER)
                b.connect('clicked', self.wx_refresh)
                box.pack_start(b, False, False, 0)
            card.pack_start(box, True, True, 0)
            card.show_all()
            return

        cur = data['current_condition'][0]
        days = data['weather']
        now = time.localtime()
        now_m = now.tm_hour * 60 + now.tm_min
        kind = self.wx_kind(cur['weatherCode'],
                            self.wx_is_night(days[0]['astronomy'][0], now_m))
        area = (data.get('nearest_area') or [{}])[0]
        place = ', '.join(x[0]['value'] for x in
                          (area.get('areaName'), area.get('region')) if x)
        # wttr.in reports its nearest station ("Tokyo" -> Shikinejima), so
        # a typed place name wins; ZIPs / airport codes keep the station
        loc = wx_location()
        if re.search(r'[^\W\d_]', loc) and len(loc) > 3:
            place = loc
        self.wx_place = place
        cur_t = int(cur['temp_F'])

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        for m in ('top', 'start', 'end'):
            getattr(body, f'set_margin_{m}')(20)
        body.set_margin_bottom(16)

        # header: place (click to change) · updated · refresh
        if self.wx_editing:
            body.pack_start(self.wx_loc_editor(), False, False, 0)
        else:
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            pb = Gtk.Button()
            pb.get_style_context().add_class('wxplacebtn')
            pb.set_relief(Gtk.ReliefStyle.NONE)
            pb.set_tooltip_text('Change location')
            pb.connect('clicked', self.wx_start_edit)
            pbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            pbox.pack_start(self._lbl('\U000F034E', 'wxpin'), False, False, 0)
            ht = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            pl = self._lbl(place or 'Weather', 'wxplace')
            pl.set_ellipsize(Pango.EllipsizeMode.END)
            prow.pack_start(pl, False, False, 0)
            prow.pack_start(self._lbl('\U000F0140', 'wxchev'), False, False, 0)
            ht.pack_start(prow, False, False, 0)
            try:
                upd = time.strftime('%-I:%M %p',
                                    time.localtime(os.path.getmtime(WX_CACHE)))
            except OSError:
                upd = '\u2014'
            sub = 'Updating\u2026' if self.wx_fetching else (
                f'Updated {upd}' + ('' if wx_location()
                                    else '  \u00b7  auto-located'))
            ht.pack_start(self._lbl(sub, 'wxdim'), False, False, 0)
            pbox.pack_start(ht, True, True, 0)
            pb.add(pbox)
            head.pack_start(pb, True, True, 0)
            rb = Gtk.Button(label='\U000F0450')
            rb.get_style_context().add_class('wxicon')
            rb.set_relief(Gtk.ReliefStyle.NONE)
            rb.set_valign(Gtk.Align.CENTER)
            rb.set_tooltip_text('Refresh')
            rb.set_sensitive(not self.wx_fetching)
            rb.connect('clicked', self.wx_refresh)
            head.pack_end(rb, False, False, 0)
            body.pack_start(head, False, False, 0)
        if self.wx_error:
            err = self._lbl('\U000F0026  ' + self.wx_error, 'wxerr')
            err.set_ellipsize(Pango.EllipsizeMode.END)
            body.pack_start(err, False, False, 0)

        # hero: big glyph + temperature + summary
        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        g = self.wx_glyph(kind, 'wxhero')
        hero.pack_start(g, False, False, 0)
        hero.pack_start(self._lbl(f'{cur_t}°', 'wxtemp'), False, False, 0)
        summ = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        summ.set_valign(Gtk.Align.CENTER)
        desc = self._lbl(cur['weatherDesc'][0]['value'].strip(), 'wxdesc', 1.0)
        desc.set_ellipsize(Pango.EllipsizeMode.END)
        summ.pack_start(desc, False, False, 0)
        summ.pack_start(self._lbl(f"Feels like {cur['FeelsLikeF']}°",
                                  'wxsub', 1.0), False, False, 0)
        summ.pack_start(self._lbl(
            f"H {days[0]['maxtempF']}°  ·  L {days[0]['mintempF']}°",
            'wxsub', 1.0), False, False, 0)
        hero.pack_end(summ, True, True, 0)
        body.pack_start(hero, False, False, 0)

        # stat chips
        astro = days[0]['astronomy'][0]
        if not self.wx_is_night(astro, now_m):
            sun_next = ('\U000F059B', 'Sunset', astro['sunset'])
        else:
            nxt = days[1] if now_m >= 720 and len(days) > 1 else days[0]
            sun_next = ('\U000F059C', 'Sunrise',
                        nxt['astronomy'][0]['sunrise'])
        chips = Gtk.Grid()
        chips.set_column_spacing(8)
        chips.set_column_homogeneous(True)
        for i, (glyph, name, val) in enumerate((
                ('\U000F058E', 'Humidity', f"{cur['humidity']}%"),
                ('\U000F059D', 'Wind',
                 f"{cur['windspeedMiles']} mph {cur['winddir16Point']}"),
                ('\U000F05A8', 'UV index', cur.get('uvIndex', '—')),
                (sun_next[0], sun_next[1],
                 sun_next[2].lstrip('0').replace(' ', ' ')))):
            chip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            chip.get_style_context().add_class('wxchip')
            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
            top.pack_start(self._lbl(glyph, 'wxchipglyph'), False, False, 0)
            top.pack_start(self._lbl(name, 'wxdim'), False, False, 0)
            chip.pack_start(top, False, False, 0)
            v = self._lbl(str(val), 'wxchipval')
            v.set_ellipsize(Pango.EllipsizeMode.END)
            chip.pack_start(v, False, False, 0)
            chips.attach(chip, i, 0, 1, 1)
        body.pack_start(chips, False, False, 0)

        # hourly strip: now + the next 3-hour slots
        slots = [('Now', kind, cur_t, None)]
        for di, d in enumerate(days):
            for h in d['hourly']:
                hm = int(h['time']) // 100 * 60
                if di == 0 and hm <= now_m:
                    continue
                night = self.wx_is_night(d['astronomy'][0], hm)
                lbl = time.strftime('%-I %p', time.strptime(
                    str(hm // 60), '%H'))
                slots.append((lbl, self.wx_kind(h['weatherCode'], night),
                              int(h['tempF']), int(h['chanceofrain'])))
        slots = slots[:WX_HOURS]
        sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sec.pack_start(self._lbl('Hourly', 'wxhdr'), False, False, 0)
        strip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        strip.set_homogeneous(True)
        strip.get_style_context().add_class('wxstrip')
        for i, (lbl, k, t, rain) in enumerate(slots):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.get_style_context().add_class('wxhour')
            if i == 0:
                col.get_style_context().add_class('now')
            col.pack_start(self._lbl(lbl, 'wxdim', 0.5), False, False, 0)
            col.pack_start(self.wx_glyph(k, 'wxsmall'), False, False, 0)
            col.pack_start(self._lbl(f'{t}°', 'wxval', 0.5), False, False, 0)
            r = self._lbl(f'\U000F058C{rain}%' if rain else ' ', 'wxrain', 0.5)
            col.pack_start(r, False, False, 0)
            strip.pack_start(col, True, True, 0)
        sec.pack_start(strip, False, False, 0)
        body.pack_start(sec, False, False, 0)

        # daily rows with a temperature range bar
        lo_all = min(int(d['mintempF']) for d in days)
        hi_all = max(int(d['maxtempF']) for d in days)
        sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sec.pack_start(self._lbl(f'{len(days)}-day forecast', 'wxhdr'),
                       False, False, 6)
        for di, d in enumerate(days):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.get_style_context().add_class('wxday')
            dt = time.strptime(d['date'], '%Y-%m-%d')
            name = ('Today', 'Tomorrow')[di] if di < 2 \
                else time.strftime('%A', dt)
            nl = self._lbl(name, 'wxval')
            nl.set_size_request(78, -1)
            row.pack_start(nl, False, False, 0)
            mid = d['hourly'][min(4, len(d['hourly']) - 1)]
            row.pack_start(self.wx_glyph(self.wx_kind(mid['weatherCode']),
                                         'wxsmall'), False, False, 0)
            rain = max(int(h['chanceofrain']) for h in d['hourly'])
            row.pack_start(self._lbl(f'\U000F058C{rain}%' if rain else '',
                                     'wxrain'), False, False, 0)
            lo, hi = int(d['mintempF']), int(d['maxtempF'])
            row.pack_end(self._lbl(f'{hi}°', 'wxval', 1.0), False, False, 0)
            bar = Gtk.DrawingArea()
            bar.set_size_request(WX_BAR_W, 6)
            bar.set_valign(Gtk.Align.CENTER)
            bar.connect('draw', self._wx_draw_bar, lo, hi, lo_all, hi_all,
                        cur_t if di == 0 else None)
            row.pack_end(bar, False, False, 0)
            lol = self._lbl(f'{lo}°', 'wxsub', 1.0)
            lol.set_size_request(30, -1)
            row.pack_end(lol, False, False, 0)
            sec.pack_start(row, False, False, 0)
        body.pack_start(sec, False, False, 0)
        card.pack_start(body, False, False, 0)

        # footer
        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        foot.get_style_context().add_class('wxfooter')
        src = self._lbl('wttr.in', 'wxdim')
        src.set_margin_start(20)
        foot.pack_start(src, False, False, 0)
        fb = Gtk.Button(label='Full forecast  \U000F03CC')
        fb.get_style_context().add_class('wxlink')
        fb.set_margin_end(12)
        fb.connect('clicked', self._wx_open_full)
        foot.pack_end(fb, False, False, 0)
        card.pack_start(foot, False, False, 0)
        card.show_all()

    def _wx_open_full(self, *_):
        q = urllib.parse.quote(wx_location() or (
            self.wx_place.split(',')[0] if getattr(self, 'wx_place', '')
            else ''))
        subprocess.Popen(['xdg-open', f'https://wttr.in/{q}'],
                         start_new_session=True)
        self.wx_close()

    @staticmethod
    def _wx_temp_rgb(t):
        """Cold blue → mild teal → warm amber → hot coral."""
        stops = ((20, (0.45, 0.62, 1.00)), (50, (0.42, 0.85, 0.85)),
                 (68, (0.55, 0.88, 0.55)), (82, (1.00, 0.80, 0.32)),
                 (100, (1.00, 0.45, 0.35)))
        if t <= stops[0][0]:
            return stops[0][1]
        for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
            if t <= t1:
                f = (t - t0) / (t1 - t0)
                return tuple(a + (b - a) * f for a, b in zip(c0, c1))
        return stops[-1][1]

    def _wx_draw_bar(self, area, cr, lo, hi, lo_all, hi_all, cur):
        import cairo
        import math
        w = area.get_allocated_width()
        h = area.get_allocated_height()
        r = h / 2
        span = max(1, hi_all - lo_all)

        def rrect(x0, x1):
            cr.new_sub_path()
            cr.arc(x0 + r, r, r, math.pi / 2, 3 * math.pi / 2)
            cr.arc(x1 - r, r, r, -math.pi / 2, math.pi / 2)
            cr.close_path()

        rrect(0, w)
        cr.set_source_rgba(1, 1, 1, 0.10)
        cr.fill()
        x0 = (lo - lo_all) / span * w
        x1 = max(x0 + h, (hi - lo_all) / span * w)
        grad = cairo.LinearGradient(x0, 0, x1, 0)
        grad.add_color_stop_rgb(0, *self._wx_temp_rgb(lo))
        grad.add_color_stop_rgb(1, *self._wx_temp_rgb(hi))
        rrect(x0, x1)
        cr.set_source(grad)
        cr.fill()
        if cur is not None:
            cx = min(max((cur - lo_all) / span * w, r + 1), w - r - 1)
            cr.arc(cx, r, r + 1, 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_line_width(1.5)
            cr.set_source_rgba(0, 0, 0, 0.45)
            cr.stroke()
        return False

    def taskview_close(self):
        if self.tv_win:
            self.tv_win.destroy()
            self.tv_win = None

    def taskview_toggle(self):
        if self.tv_win:
            self.taskview_close()
            return
        clients = [c for c in (hyprctl('clients', want_json=True) or [])
                   if c.get('mapped', True) and c.get('class')]
        by_ws = {}
        for c in clients:
            by_ws.setdefault(c.get('workspace', {}).get('id', 0),
                             []).append(c)
        if not by_ws:
            return
        ws_info = {w['id']: w
                   for w in hyprctl('workspaces', want_json=True) or []}

        w = self._backdrop('winbar-taskview', self.taskview_close)
        # dim layer: a real Box paints its CSS background reliably
        # (the app-paintable window itself doesn't)
        dimbox = Gtk.Box()
        dimbox.get_style_context().add_class('tvbackdrop')
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        v.set_halign(Gtk.Align.CENTER)
        v.set_valign(Gtk.Align.CENTER)

        for ws_id in sorted(by_ws, key=lambda i: (i < 0, abs(i))):
            wins = sorted(by_ws[ws_id],
                          key=lambda c: c.get('focusHistoryID', 9999))
            mon = ws_info.get(ws_id, {}).get('monitor', '')
            name = ('Scratchpad' if ws_id < 0 else f'Workspace {ws_id}')
            if mon:
                name += f'   ·   {mon}'
            hd = Gtk.Label(label=name)
            hd.get_style_context().add_class('tvheader')
            hd.set_halign(Gtk.Align.START)
            v.pack_start(hd, False, False, 0)

            fb = Gtk.FlowBox()
            fb.set_selection_mode(Gtk.SelectionMode.NONE)
            fb.set_homogeneous(True)
            fb.set_column_spacing(8)
            fb.set_row_spacing(8)
            per_line = max(1, min(len(wins),
                                  (self.mon_w - 300) // (THUMB_W + 44)))
            fb.set_max_children_per_line(per_line)
            fb.set_min_children_per_line(per_line)
            fb.set_halign(Gtk.Align.START)
            for c in wins:
                addr = c.get('address')
                fb.add(self.win_card(
                    c, lambda _b, a=addr: self.taskview_pick(a)))
            v.pack_start(fb, False, False, 0)

        eb = self._swallow_clicks(v)
        eb.set_hexpand(True)
        eb.set_vexpand(True)
        eb.set_halign(Gtk.Align.CENTER)
        eb.set_valign(Gtk.Align.CENTER)
        dimbox.pack_start(eb, True, True, 0)
        w.add(dimbox)
        gm = self._focused_gdk_mon()
        if gm:
            GtkLayerShell.set_monitor(w, gm)
        self.tv_win = w
        w.show_all()

    def taskview_pick(self, addr):
        self.taskview_close()
        if addr:
            dispatch('focuswindow', f'address:{addr}')
            dispatch('alterzorder', f'top,address:{addr}')

    def schedule_refresh(self):
        if not self.refresh_pending:
            self.refresh_pending = True
            GLib.timeout_add(120, self._do_refresh)

    def _do_refresh(self):
        self.refresh_pending = False
        self.refresh()
        return False

    # ---------- thumbnails ----------
    def schedule_thumb(self):
        if self.thumb_timer:
            GLib.source_remove(self.thumb_timer)
        self.thumb_timer = GLib.timeout_add(650, self._capture_active_thumb)

    def _capture_active_thumb(self):
        self.thumb_timer = None
        addr = self.active_addr
        c = self.clients_by_addr.get(addr)
        if not c or self.capture_proc is not None:
            return False
        x, y = c.get('at', (0, 0))
        w, h = c.get('size', (0, 0))
        # clamp to the monitor the window is mostly on
        for m in hyprctl('monitors', want_json=True) or []:
            mx, my = m.get('x', 0), m.get('y', 0)
            mw, mh = m.get('width', 0), m.get('height', 0)
            if mx <= x + w // 2 < mx + mw and my <= y + h // 2 < my + mh:
                nx, ny = max(x, mx), max(y, my)
                w = min(x + w, mx + mw) - nx
                h = min(y + h, my + mh) - ny
                x, y = nx, ny
                break
        if w < 60 or h < 40:
            return False
        try:
            # write to .tmp, rename when grim exits -> readers never
            # see a half-written file (that caused visual artifacts)
            self.capture_addr = addr
            self.capture_proc = subprocess.Popen(
                ['grim', '-g', f'{int(x)},{int(y)} {int(w)}x{int(h)}',
                 '-s', '0.4', '-t', 'jpeg', '-q', '75',
                 thumb_path(addr) + '.tmp'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            GLib.timeout_add(80, self._finish_capture)
        except Exception:
            self.capture_proc = None
        return False

    def _finish_capture(self):
        p = self.capture_proc
        if p is None:
            return False
        if p.poll() is None:
            return True     # still running, poll again
        self.capture_proc = None
        addr = self.capture_addr
        tmp = thumb_path(addr) + '.tmp'
        if p.returncode == 0 and os.path.exists(tmp):
            os.replace(tmp, thumb_path(addr))
            self.thumb_cache.pop(addr, None)
        else:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        return False

    def thumb_pixbuf(self, addr):
        tp = thumb_path(addr or '')
        try:
            mtime = os.path.getmtime(tp)
        except OSError:
            return None
        cached = self.thumb_cache.get(addr)
        if cached and cached[0] == mtime:
            return cached[1]
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                tp, THUMB_W, THUMB_H, True)
        except Exception:
            return None
        self.thumb_cache[addr] = (mtime, pix)
        return pix

    # ---------- model ----------
    def build_groups(self):
        clients = hyprctl('clients', want_json=True) or []
        self.clients_by_addr = {
            norm_addr(c.get('address')): c
            for c in clients if c.get('address')}

        # hide like the Windows taskbar while something is fullscreen
        # on our monitor's *currently visible* workspace. A game left
        # fullscreen on a background workspace must NOT hide the dock —
        # only fullscreen on the workspace we're actually looking at.
        active_ws = {m.get('id'): m.get('activeWorkspace', {}).get('id')
                     for m in hyprctl('monitors', want_json=True) or []}
        for s in self.strips:
            fs = any(c.get('fullscreen') and c.get('monitor') == s.mon_id
                     and c.get('workspace', {}).get('id')
                     == active_ws.get(s.mon_id)
                     and c.get('mapped', True) for c in clients)
            if fs and s.get_visible():
                if self.preview_strip is s:
                    self.close_preview()
                s.hide()
            elif not fs and not s.get_visible():
                s.show()

        if self.active_addr is None:
            aw = hyprctl('activewindow', want_json=True)
            if isinstance(aw, dict):
                self.active_addr = aw.get('address')

        groups = {}
        for pid in self.pinned:
            groups[pid] = {'id': pid, 'info': desktop_info(pid), 'cls': None,
                           'windows': [], 'pinned': True}

        for c in clients:
            cls = c.get('class') or ''
            if not cls or not c.get('mapped', True):
                continue
            info = self.resolver.resolve(cls, c.get('pid'))
            key = info.get_id() if info else cls.lower()
            g = groups.get(key)
            if g is None:
                g = groups[key] = {'id': key, 'info': info, 'cls': cls,
                                   'windows': [], 'pinned': False}
            g['cls'] = cls
            g['pinned'] = g['pinned'] or key in self.pinned
            addr = norm_addr(c.get('address'))
            # Recover minimize bookkeeping if the window is already parked
            if is_minimized_ws(c.get('workspace')) and addr not in self.minimized:
                self.minimized[addr] = {
                    'workspace': 1,
                    'ws_name': '1',
                    'class': cls,
                }
                self.save_minimized()
            g['windows'].append({
                'address': addr,
                'title': c.get('title') or cls,
                'minimized': self.is_addr_minimized(addr),
            })

        # apps tagged "hide to tray" live in the chevron popup, not the bar
        self.tray_groups = {k: g for k, g in groups.items()
                            if k in self.tray_apps and g['windows']}
        for k in self.tray_apps:
            groups.pop(k, None)
        return groups

    def refresh(self):
        self.groups = self.build_groups()

        self.order = [k for k in self.order if k in self.groups]
        for k in self.groups:
            if k not in self.order:
                self.order.append(k)

        if self.pop_key and self.pop_key not in self.groups:
            self.close_preview()
        for s in self.strips:
            self._sync_strip(s)

        # live-update an open preview (signature-guarded, no flicker)
        if (self.pop_key and self.preview and self.preview.get_visible()
                and self.pop_key in self.groups):
            self.fill_preview(self.groups[self.pop_key])

    def _sync_strip(self, s):
        for k in list(s.buttons):
            if k not in self.groups:
                s.box.remove(s.buttons.pop(k))

        for idx, k in enumerate(self.order):
            g = self.groups[k]
            btn = s.buttons.get(k)
            if btn is None:
                btn = s.buttons[k] = self.create_button(k, s)
                s.box.pack_start(btn, False, False, 0)
            self.update_button(btn, g)
            s.box.reorder_child(btn, idx)

        s.box.show_all()
        for btn in s.buttons.values():
            btn._badge.set_visible(btn._n > 1)

    # ---------- icons ----------
    def gicon_for(self, g):
        if g['info']:
            icon = g['info'].get_icon()
            if icon:
                return icon
        icon = self.resolver.fallback_icon(g['cls']) if g['cls'] else None
        return icon or Gio.ThemedIcon.new('application-x-executable')

    def icon_image(self, g, size):
        img = Gtk.Image.new_from_gicon(self.gicon_for(g), Gtk.IconSize.INVALID)
        img.set_pixel_size(size)
        return img

    # ---------- buttons ----------
    def create_button(self, key, strip):
        btn = Gtk.Button()
        btn._strip = strip
        btn.get_style_context().add_class('appbtn')
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_focus_on_click(False)
        btn._key = key
        btn._iconcls = '__unset__'
        btn._n = 0

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        btn._iconslot = Gtk.Box()
        vbox.pack_start(btn._iconslot, False, False, 0)
        btn._ind = Gtk.Box()
        btn._ind.get_style_context().add_class('ind')
        btn._ind.set_halign(Gtk.Align.CENTER)
        vbox.pack_start(btn._ind, False, False, 0)

        over = Gtk.Overlay()
        over.add(vbox)
        btn._badge = Gtk.Label(label='')
        btn._badge.get_style_context().add_class('badge')
        btn._badge.set_halign(Gtk.Align.END)
        btn._badge.set_valign(Gtk.Align.START)
        btn._badge.set_no_show_all(True)
        over.add_overlay(btn._badge)
        over.set_overlay_pass_through(btn._badge, True)
        btn.add(over)

        btn.add_events(Gdk.EventMask.BUTTON1_MOTION_MASK
                       | Gdk.EventMask.BUTTON_RELEASE_MASK)
        btn.connect('clicked', self.on_click)
        btn.connect('button-press-event', self.on_press)
        btn.connect('button-release-event', self.on_release)
        btn.connect('motion-notify-event', self.on_motion)
        btn.connect('enter-notify-event', self.on_btn_enter)
        btn.connect('leave-notify-event', self.on_btn_leave)
        return btn

    def update_button(self, btn, g):
        n = len(g['windows'])
        btn._n = n
        btn._group = g

        gicon = self.gicon_for(g)
        if gicon.to_string() != btn._iconcls:
            btn._iconcls = gicon.to_string()
            for ch in btn._iconslot.get_children():
                btn._iconslot.remove(ch)
            img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.INVALID)
            img.set_pixel_size(ICON_SIZE)
            btn._iconslot.pack_start(img, False, False, 0)

        ctx = btn.get_style_context()
        is_active = any(w['address'] == self.active_addr
                        for w in g['windows'])
        all_min = n > 0 and all(
            self.is_addr_minimized(w['address']) for w in g['windows'])
        if is_active:
            ctx.add_class('active-app')
        else:
            ctx.remove_class('active-app')
        if all_min:
            ctx.add_class('minimized-app')
        else:
            ctx.remove_class('minimized-app')

        ind_ctx = btn._ind.get_style_context()
        ind_ctx.remove_class('running')
        ind_ctx.remove_class('active')
        ind_ctx.remove_class('minimized')
        if n > 0:
            if all_min:
                ind_ctx.add_class('minimized')
            else:
                ind_ctx.add_class('active' if is_active else 'running')
            btn._ind.set_size_request(
                18 if is_active else (14 if n > 1 else 8), 3)
        else:
            btn._ind.set_size_request(8, 3)

        btn._badge.set_label(str(n) if n > 1 else '')

        name = (g['info'].get_display_name() if g['info']
                else (g['cls'] or '?'))
        btn.set_tooltip_text(g['windows'][0]['title'] if n == 1 else name)

    # ---------- manual drag-to-reorder ----------
    # (GTK/Wayland DnD doesn't work from layer-shell surfaces, so we
    #  track the pointer ourselves and shuffle icons live.)
    def on_press(self, btn, event):
        self.close_bar_popups()
        if event.button == 3:
            self.show_context_menu(btn, event)
            return True
        if event.button == 2:      # middle click = open a new window
            self.launch(btn._group)
            return True
        if event.button == 1:
            self.press_key = btn._key
            self.press_x = event.x_root
            self.drag_active = False
        return False

    def on_motion(self, btn, event):
        if self.press_key != btn._key:
            return False
        if not self.drag_active:
            if abs(event.x_root - self.press_x) < DRAG_THRESHOLD:
                return False
            self.drag_active = True
            self.cancel_timers()
            self.close_preview()
            btn.set_opacity(0.55)
        # pointer x in dock-box coordinates (x_root is toplevel-relative
        # on wayland and our toplevel starts at box x=0)
        px = event.x_root
        cur = self.order.index(btn._key)
        target = cur
        for i, k in enumerate(self.order):
            if k == btn._key:
                continue
            a = btn._strip.buttons[k].get_allocation()
            center = a.x + a.width / 2
            if i < cur and px < center:
                target = min(target, i)
            elif i > cur and px > center:
                target = max(target, i)
        if target != cur:
            self.order.remove(btn._key)
            self.order.insert(target, btn._key)
            btn._strip.box.reorder_child(btn, target)
        return True

    def on_release(self, btn, event):
        was_drag = self.drag_active
        self.press_key = None
        self.drag_active = False
        if was_drag:
            btn.set_opacity(1.0)
            pinset = set(self.pinned)
            self.pinned = [k for k in self.order if k in pinset]
            self.save_pinned()
            self.refresh()         # carry the new order to the other strips
            return True     # swallow the click that would follow
        return False

    # ---------- interactions ----------
    def on_click(self, btn):
        g = btn._group
        n = len(g['windows'])
        if n == 0:
            self.launch(g)
            return
        # Anki: always "open here" / stash via anki-toggle (scratchpad + tray)
        if g.get('id') == 'anki.desktop':
            subprocess.Popen(
                [os.path.expanduser('~/.local/bin/anki-toggle'), 'toggle'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        if n == 1:
            addr = g['windows'][0]['address']
            # mid-anim click reverses; otherwise Windows-style min on focused
            if addr in self._anim:
                self._reverse_anim(addr)
            elif (addr == self.active_addr
                    and not self.is_addr_minimized(addr)):
                self.minimize_window(addr)
            else:
                self.focus(addr)
            return
        # multi-window: restore any minimized first, else preview picker
        minimized = [w for w in g['windows']
                     if self.is_addr_minimized(w['address'])]
        if minimized and all(self.is_addr_minimized(w['address'])
                             for w in g['windows']):
            for w in minimized:
                self.restore_window(w['address'])
            return
        if (self.pop_key == btn._key and self.preview
                and self.preview.get_visible()):
            self.close_preview()
        else:
            self.show_preview_for(btn)

    def launch(self, g):
        if g['info']:
            try:
                # feed real launches into rofi recency
                did = g.get('id') or (g['info'].get_id() if g['info'] else None)
                if did:
                    subprocess.Popen(
                        [os.path.expanduser('~/.local/bin/app-recency'),
                         'touch', did],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                g['info'].launch(None, None)
            except Exception:
                pass

    def is_addr_minimized(self, addr):
        addr = norm_addr(addr)
        if not addr:
            return False
        # mid-flight minimize still shows the window — not "parked" yet
        st = self._anim.get(addr)
        if st and st.get('dir') == 'min':
            return False
        if st and st.get('dir') == 'rest':
            return False  # coming back
        if addr in self.minimized:
            # only count as minimized once actually on the special ws
            # (map is also used mid-anim as geometry stash)
            c = self.clients_by_addr.get(addr) or self._client(addr)
            if c and is_minimized_ws(c.get('workspace')):
                return True
            # map entry but still on a real workspace = anim stash only
            if c and not is_minimized_ws(c.get('workspace')):
                return False
            return True
        c = self.clients_by_addr.get(addr)
        if c and is_minimized_ws(c.get('workspace')):
            return True
        return False

    def _client(self, addr):
        addr = norm_addr(addr)
        c = self.clients_by_addr.get(addr)
        if c:
            return c
        for cl in hyprctl('clients', want_json=True) or []:
            if norm_addr(cl.get('address')) == addr:
                return cl
        return None

    def _taskbar_icon_rect(self, addr, cls=None):
        """Screen-space rect (x, y, w, h) of the taskbar icon for this window."""
        addr = norm_addr(addr)
        key = None
        for k, g in (self.groups or {}).items():
            if any(norm_addr(w.get('address')) == addr for w in g.get('windows', [])):
                key = k
                break
            if cls and (g.get('cls') or '').lower() == cls.lower():
                key = k
        c = self.clients_by_addr.get(addr) or {}
        s = next((s for s in self.strips
                  if s.mon_id == c.get('monitor') and s.get_visible()), self)
        btn = s.buttons.get(key) if key else None
        size = MIN_ANIM_SIZE
        if btn is not None:
            a = btn.get_allocation()
            # layer-shell dock: left margin + icon offset, sitting on bottom
            cx = s.mon_x + MARGIN_LEFT + a.x + a.width // 2
            cy = s.mon_y + s.mon_h - BAR_HEIGHT // 2
            return (int(cx - size // 2), int(cy - size // 2), size, size)
        # fallback: center of the taskbar strip
        cx = s.mon_x + s.mon_w // 2
        cy = s.mon_y + s.mon_h - BAR_HEIGHT // 2
        return (int(cx - size // 2), int(cy - size // 2), size, size)

    def _set_geom(self, addr, x, y, w, h, animate=True):
        """Move/resize a window; optionally skip Hyprland's animation."""
        addr = norm_addr(addr)
        if not addr:
            return
        w = max(50, int(w))
        h = max(50, int(h))
        x, y = int(x), int(y)
        try:
            if not animate:
                subprocess.run(
                    ['hyprctl', '--batch',
                     'keyword animations:enabled false;'
                     f'dispatch resizewindowpixel exact {w} {h},'
                     f'address:{addr};'
                     f'dispatch movewindowpixel exact {x} {y},'
                     f'address:{addr};'
                     'keyword animations:enabled true'],
                    capture_output=True, timeout=2)
            else:
                # resize then move so the window both shrinks and flies
                subprocess.run(
                    ['hyprctl', '--batch',
                     f'dispatch resizewindowpixel exact {w} {h},'
                     f'address:{addr};'
                     f'dispatch movewindowpixel exact {x} {y},'
                     f'address:{addr}'],
                    capture_output=True, timeout=2)
        except Exception:
            pass

    def _force_float_at(self, addr, x, y, w, h):
        """Float a window and pin it to exact geometry with no intermediate jump.

        Hyprland's setfloating on a tiled window often resizes/repositions it
        (e.g. near-fullscreen). We immediately re-apply the saved rect so the
        minimize shrink starts from where the window actually was.
        """
        addr = norm_addr(addr)
        if not addr:
            return
        w = max(50, int(w))
        h = max(50, int(h))
        x, y = int(x), int(y)
        try:
            subprocess.run(
                ['hyprctl', '--batch',
                 'keyword animations:enabled false;'
                 f'dispatch setfloating address:{addr};'
                 f'dispatch resizewindowpixel exact {w} {h},address:{addr};'
                 f'dispatch movewindowpixel exact {x} {y},address:{addr};'
                 'keyword animations:enabled true'],
                capture_output=True, timeout=2)
        except Exception:
            pass

    def _settle_tiled(self, addr):
        """Drop back into the tiling layout without a second animated float move."""
        addr = norm_addr(addr)
        if not addr:
            return
        try:
            subprocess.run(
                ['hyprctl', '--batch',
                 'keyword animations:enabled false;'
                 f'dispatch settiled address:{addr};'
                 'keyword animations:enabled true'],
                capture_output=True, timeout=2)
        except Exception:
            pass

    def _begin_no_warp(self):
        """Freeze cursor warps for the duration of a minimize/restore anim.

        Hyprland warps the pointer to a focused window's center on focus, so
        without this the cursor rides the window into the taskbar and back.
        We do NOT snapshot/restore cursor position — if you move the mouse
        during the anim it should stay where you put it.
        """
        if self._warp_guard == 0:
            try:
                subprocess.run(
                    ['hyprctl', 'keyword', 'cursor:no_warps', 'true'],
                    capture_output=True, timeout=1)
            except Exception:
                pass
        self._warp_guard += 1

    def _end_no_warp(self):
        self._warp_guard = max(0, self._warp_guard - 1)
        if self._warp_guard != 0:
            return
        try:
            subprocess.run(
                ['hyprctl', 'keyword', 'cursor:no_warps', 'false'],
                capture_output=True, timeout=1)
        except Exception:
            pass

    def _focus_next_on_ws(self, prev_ws, exclude_addr):
        if prev_ws is None:
            return
        exclude_addr = norm_addr(exclude_addr)
        for cl in hyprctl('clients', want_json=True) or []:
            a = norm_addr(cl.get('address'))
            if (a != exclude_addr
                    and (cl.get('workspace') or {}).get('id') == prev_ws
                    and cl.get('mapped', True)
                    and not is_minimized_ws(cl.get('workspace'))):
                dispatch('focuswindow', f'address:{a}')
                return

    def _anim_add_timer(self, addr, ms, cb):
        """Schedule a GLib timeout and track it so spam can cancel mid-flight."""
        st = self._anim.get(addr)
        if st is None:
            return None

        def _wrap():
            # drop ourselves from the timer list then run
            cur = self._anim.get(addr)
            if cur and tid in cur.get('timers', []):
                cur['timers'].remove(tid)
            return cb()

        tid = GLib.timeout_add(ms, _wrap)
        st.setdefault('timers', []).append(tid)
        return tid

    def _anim_cancel(self, addr):
        """Cancel pending timers for an in-flight min/restore. Keeps warp guard."""
        st = self._anim.pop(addr, None)
        if not st:
            return None
        for tid in st.get('timers', []):
            try:
                GLib.source_remove(tid)
            except Exception:
                pass
        return st

    def _anim_clear(self, addr):
        """Finish an anim: drop state + release warp guard once."""
        st = self._anim_cancel(addr)
        self._end_no_warp()
        if self._last_anim_addr == addr:
            self._last_anim_addr = None
        return st

    def toggle_minimize(self, addr=None):
        """Super+M entry: toggle, or reverse mid-animation if spammed."""
        addr = norm_addr(addr)
        # Prefer reversing whatever we just launched (focus may have moved).
        if addr and addr in self._anim:
            self._reverse_anim(addr)
            return
        if self._last_anim_addr and self._last_anim_addr in self._anim:
            self._reverse_anim(self._last_anim_addr)
            return
        if not addr:
            aw = hyprctl('activewindow', want_json=True) or {}
            addr = norm_addr(aw.get('address'))
        if not addr:
            return
        if self.is_addr_minimized(addr):
            self.restore_window(addr)
        else:
            self.minimize_window(addr)

    def _reverse_anim(self, addr):
        """Cancel mid-flight anim and go the other way from current geometry."""
        addr = norm_addr(addr)
        st = self._anim_cancel(addr)
        if not st:
            return
        meta = st.get('meta') or {}
        direction = st.get('dir')
        # Keep no_warps held across the reverse (begin was called for first leg;
        # cancel doesn't end it — only _anim_clear does. We already popped
        # timers but need warp_guard still up. Re-bookkeep: we cancelled out of
        # _anim without _end_no_warp, so guard still +1. Good — reverse reuses it.
        # Put addr back out of _anim so minimize/restore can start cleanly, but
        # we already popped. warp_guard still elevated — reverse paths must
        # either use _anim without double _begin_no_warp, or we end and re-begin.
        # Simplest: end warp then let minimize/restore begin fresh.
        self._end_no_warp()

        if direction == 'min':
            # Was shrinking → expand back to saved geom (don't park).
            # meta is still in self.minimized; keep it for restore path then
            # restore will pop — actually restore pops. Ensure meta present.
            self.minimized[addr] = dict(meta)
            self.save_minimized()
            # Window is still on real workspace (park happens at end of min).
            # Ensure floating at current size, then restore anim.
            self.restore_window(addr, focus=bool(st.get('focus', True)),
                                _from_reverse=True)
        else:
            # Was expanding → shrink & park again.
            # restore had popped meta; put it back then minimize from here.
            self.minimized[addr] = dict(meta)
            self.save_minimized()
            # Currently on real workspace floating mid-size. Minimize will
            # re-save geom if we aren't careful — pass reverse so it uses meta.
            self.minimize_window(addr, _from_reverse=True)

    def minimize_window(self, addr, _from_reverse=False):
        """Shrink toward the taskbar icon, then park on special:minimized."""
        addr = norm_addr(addr)
        if not addr:
            return
        # Spam / reverse: if already animating this addr, flip direction
        if addr in self._anim:
            self._reverse_anim(addr)
            return
        if self.is_addr_minimized(addr) and not _from_reverse:
            # already parked — treat as restore request
            self.restore_window(addr)
            return

        c = self._client(addr)
        if not c and not _from_reverse:
            return

        if _from_reverse:
            meta = self.minimized.get(addr) or {}
            at = meta.get('at') or [0, 0]
            size = meta.get('size') or [800, 600]
            floating = bool(meta.get('floating'))
            fullscreen = int(meta.get('fullscreen') or 0)
            prev_ws = meta.get('workspace')
            cls = meta.get('class') or ''
            # still floating mid-flight on real workspace — just reverse shrink
        else:
            ws = c.get('workspace') or {}
            if is_minimized_ws(ws):
                return
            cls = (c.get('class') or '').lower()
            if cls.startswith('winbar') or cls in ('rofi',):
                return
            at = c.get('at') or [0, 0]
            size = c.get('size') or [800, 600]
            floating = bool(c.get('floating'))
            fullscreen = int(c.get('fullscreen') or 0)
            prev_ws = ws.get('id')
            meta = {
                'workspace': prev_ws,
                'ws_name': ws.get('name') or str(prev_ws or 1),
                'class': c.get('class') or '',
                'at': list(at),
                'size': list(size),
                'floating': floating,
                'fullscreen': fullscreen,
            }
            self.minimized[addr] = meta
            self.save_minimized()

            if fullscreen:
                dispatch('fullscreenstate', f'0 0,address:{addr}')
            if not floating:
                self._force_float_at(addr, at[0], at[1], size[0], size[1])

        self.close_preview()
        self._begin_no_warp()
        self._last_anim_addr = addr
        self._anim[addr] = {
            'dir': 'min',
            'timers': [],
            'meta': dict(self.minimized.get(addr) or meta),
            'focus': True,
        }

        if not _from_reverse:
            self._focus_next_on_ws(prev_ws, addr)

        tx, ty, tw, th = self._taskbar_icon_rect(
            addr, (c or {}).get('class') if c else cls)
        # from current geometry (mid-flight or full) shrink into the icon
        self._set_geom(addr, tx, ty, tw, th, animate=True)

        def _finish():
            if addr not in self._anim or self._anim[addr].get('dir') != 'min':
                return False
            dispatch('movetoworkspacesilent',
                     f'{MINIMIZED_WS},address:{addr}')
            self._anim_clear(addr)
            self._focus_next_on_ws(prev_ws, addr)
            if self.active_addr == addr:
                self.active_addr = None
            self.schedule_refresh()
            return False

        self._anim_add_timer(addr, MIN_ANIM_MS, _finish)

    def restore_window(self, addr, focus=True, _from_reverse=False):
        """Un-minimize: expand out of the taskbar icon back to saved size."""
        addr = norm_addr(addr)
        if not addr:
            return
        if addr in self._anim:
            self._reverse_anim(addr)
            return

        if _from_reverse:
            meta = dict(self.minimized.get(addr) or {})
        else:
            meta = self.minimized.pop(addr, None) or {}
            self.save_minimized()
            # keep a copy for reverse mid-flight
        if not meta and not _from_reverse:
            # nothing saved — just try to pull off special:minimized
            meta = {
                'workspace': 1, 'ws_name': '1', 'class': '',
                'at': [self.mon_x + 80, self.mon_y + 80],
                'size': [960, 640], 'floating': True, 'fullscreen': 0,
            }

        dest = meta.get('workspace')
        if dest is None:
            dest = meta.get('ws_name') or '1'
        if isinstance(dest, str) and dest.startswith('special:'):
            dest = 1
        target = str(dest)

        at = meta.get('at') or [self.mon_x + 80, self.mon_y + 80]
        size = meta.get('size') or [960, 640]
        was_floating = bool(meta.get('floating'))
        was_fs = int(meta.get('fullscreen') or 0)

        # hold meta for reverse; not parked once restore starts
        if addr in self.minimized and not _from_reverse:
            pass
        elif _from_reverse:
            # canceling a minimize: ensure not considered parked
            self.minimized.pop(addr, None)
            self.save_minimized()

        self.close_preview()
        self._begin_no_warp()
        self._last_anim_addr = addr
        self._anim[addr] = {
            'dir': 'rest',
            'timers': [],
            'meta': dict(meta),
            'focus': focus,
        }

        # From reverse-of-minimize we're already on the real workspace floating.
        if not _from_reverse:
            dispatch('movetoworkspacesilent', f'{target},address:{addr}')
            if focus and str(target).lstrip('-').isdigit():
                dispatch('workspace', str(target))
            tx, ty, tw, th = self._taskbar_icon_rect(addr, meta.get('class'))
            self._force_float_at(addr, tx, ty, tw, th)
        # else: stay at current mid-shrink geom; expand from here

        if focus:
            dispatch('focuswindow', f'address:{addr}')

        def _expand():
            if addr not in self._anim or self._anim[addr].get('dir') != 'rest':
                return False
            self._set_geom(addr, at[0], at[1], size[0], size[1], animate=True)
            return False

        def _finish():
            if addr not in self._anim or self._anim[addr].get('dir') != 'rest':
                return False
            self._anim_clear(addr)
            # ensure not left in minimized map
            self.minimized.pop(addr, None)
            self.save_minimized()
            if not was_floating:
                self._settle_tiled(addr)
            if was_fs:
                dispatch('fullscreen', f'1,address:{addr}')
            if focus:
                dispatch('focuswindow', f'address:{addr}')
            self.schedule_refresh()
            return False

        # reverse path: expand immediately (already mid-size); normal: tiny delay
        self._anim_add_timer(addr, 16 if _from_reverse else 30, _expand)
        self._anim_add_timer(addr, MIN_ANIM_MS + (20 if _from_reverse else 50),
                             _finish)
        self.schedule_refresh()

    def focus(self, addr):
        self.close_preview()
        addr = norm_addr(addr)
        if not addr:
            return
        if addr in self._anim:
            # click during anim → reverse
            self._reverse_anim(addr)
            return
        if self.is_addr_minimized(addr):
            self.restore_window(addr, focus=True)
            return
        dispatch('focuswindow', f'address:{addr}')

    def close_win(self, addr):
        addr = norm_addr(addr)
        if addr:
            self.minimized.pop(addr, None)
            self.save_minimized()
            dispatch('closewindow', f'address:{addr}')

    # ---------- preview window (own layer surface, always above) ----------
    def ensure_preview(self):
        if self.preview:
            return
        LS = GtkLayerShell
        w = Gtk.Window(title='winbar-preview')
        LS.init_for_window(w)
        LS.set_layer(w, LS.Layer.TOP)
        LS.set_anchor(w, LS.Edge.LEFT, True)
        LS.set_anchor(w, LS.Edge.BOTTOM, True)
        LS.set_margin(w, LS.Edge.BOTTOM, BAR_HEIGHT + 8)
        LS.set_exclusive_zone(w, -1)
        LS.set_namespace(w, 'winbar-preview')
        if self.gdk_mon:
            LS.set_monitor(w, self.gdk_mon)
        self.preview_strip = self

        visual = w.get_screen().get_rgba_visual()
        if visual:
            w.set_visual(visual)
        w.set_app_paintable(True)

        outer = Gtk.Box()
        outer.get_style_context().add_class('previewcard')
        self.preview_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for m in ('top', 'bottom', 'start', 'end'):
            getattr(self.preview_box, f'set_margin_{m}')(10)
        outer.add(self.preview_box)
        w.add(outer)

        w.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK
                     | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        w.connect('enter-notify-event', self.on_pop_enter)
        w.connect('leave-notify-event', self.on_pop_leave)
        self.preview = w

    def fill_preview(self, g):
        sig = (g['id'],) + tuple(
            (w['address'], w['title'],
             self.thumb_cache.get(w['address'], (0,))[0]
             if w['address'] in self.thumb_cache else
             (os.path.getmtime(thumb_path(w['address']))
              if os.path.exists(thumb_path(w['address'])) else 0))
            for w in g['windows'])
        if sig == self.fill_sig:
            return
        self.fill_sig = sig
        for ch in self.preview_box.get_children():
            self.preview_box.remove(ch)
        for w in g['windows']:
            self.preview_box.pack_start(
                self.window_card(g, w), False, False, 0)
        self.preview_box.show_all()

    def window_card(self, g, w):
        card = Gtk.Button()
        card.get_style_context().add_class('wincard')
        card.set_relief(Gtk.ReliefStyle.NONE)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        header.pack_start(self.icon_image(g, 16), False, False, 0)
        title = w['title']
        if len(title) > 26:
            title = title[:24] + '…'
        lbl = Gtk.Label(label=title)
        lbl.get_style_context().add_class('cardtitle')
        lbl.set_halign(Gtk.Align.START)
        header.pack_start(lbl, True, True, 0)

        close = Gtk.EventBox()
        xl = Gtk.Label(label='✕')
        xl.get_style_context().add_class('cardclose')
        close.add(xl)
        addr = w['address']
        close.connect('button-press-event',
                      lambda _w, _e, a=addr: self._card_close(a))
        header.pack_start(close, False, False, 0)
        vbox.pack_start(header, False, False, 0)

        frame = Gtk.Box()
        frame.get_style_context().add_class('thumbframe')
        pix = self.thumb_pixbuf(addr)
        if pix is not None:
            img = Gtk.Image.new_from_pixbuf(pix)
        else:
            img = self.icon_image(g, 48)
            img.set_size_request(THUMB_W, THUMB_H)
        img.set_halign(Gtk.Align.CENTER)
        img.set_valign(Gtk.Align.CENTER)
        frame.set_size_request(THUMB_W, THUMB_H)
        frame.pack_start(img, True, True, 0)
        vbox.pack_start(frame, False, False, 0)

        card.add(vbox)
        card.connect('clicked', lambda _b, a=addr: self.focus(a))
        return card

    def _card_close(self, addr):
        self.close_win(addr)
        return True

    def show_preview_for(self, btn):
        g = btn._group
        if not g['windows']:
            return
        self.ensure_preview()
        strip = btn._strip
        if strip is not self.preview_strip:
            # a mapped layer surface can't change outputs: remap it there
            self.preview.hide()
            if strip.gdk_mon:
                GtkLayerShell.set_monitor(self.preview, strip.gdk_mon)
            self.preview_strip = strip
        self.pop_key = btn._key
        self.fill_preview(g)

        # center the preview above the icon
        pw = self.preview.get_preferred_width()[1]
        a = btn.get_allocation()
        left = MARGIN_LEFT + a.x + a.width // 2 - pw // 2
        left = max(8, min(left, strip.mon_w - pw - 8))
        GtkLayerShell.set_margin(self.preview, GtkLayerShell.Edge.LEFT,
                                 int(left))
        self.preview.show_all()

    def close_preview(self):
        self.cancel_timers()
        if self.preview and self.preview.get_visible():
            self.preview.hide()
        self.pop_key = None
        self.fill_sig = None
        self.over_pop = False

    # ----- hover management -----
    def cancel_timers(self):
        for t in ('hover_timer', 'hide_timer'):
            tid = getattr(self, t)
            if tid:
                GLib.source_remove(tid)
                setattr(self, t, None)

    def on_btn_enter(self, btn, _event):
        if self.drag_active:
            return False
        self.over_button = True
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = None
        if self.hover_timer:
            GLib.source_remove(self.hover_timer)
            self.hover_timer = None
        if not btn._group['windows']:
            if self.pop_key:
                self.close_preview()
            return False
        if self.pop_key and self.pop_key != btn._key:
            self.show_preview_for(btn)      # slide preview to this app
        else:
            self.hover_timer = GLib.timeout_add(350, self._hover_show, btn)
        return False

    def _hover_show(self, btn):
        self.hover_timer = None
        if self.over_button and not self.drag_active:
            self.show_preview_for(btn)
        return False

    def on_btn_leave(self, _btn, _event):
        self.over_button = False
        if self.hover_timer:
            GLib.source_remove(self.hover_timer)
            self.hover_timer = None
        self._arm_hide()
        return False

    def on_pop_enter(self, _w, _event):
        self.over_pop = True
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = None
        return False

    def on_pop_leave(self, _w, event):
        if event.detail == Gdk.NotifyType.INFERIOR:
            return False                    # moved onto a card, not out
        self.over_pop = False
        self._arm_hide()
        return False

    def _arm_hide(self):
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
        self.hide_timer = GLib.timeout_add(300, self._maybe_hide)

    def _maybe_hide(self):
        self.hide_timer = None
        if not self.over_button and not self.over_pop:
            self.close_preview()
        return False

    # ----- right-click menu -----
    def show_context_menu(self, btn, event):
        self.close_preview()
        g = btn._group
        menu = Gtk.Menu()

        name = g['info'].get_display_name() if g['info'] else (g['cls'] or '?')
        head = Gtk.MenuItem(label=name)
        head.set_sensitive(False)
        menu.append(head)
        menu.append(Gtk.SeparatorMenuItem())

        if g['info']:
            mi = Gtk.MenuItem(label='Open new window')
            mi.connect('activate', lambda _m: self.launch(g))
            menu.append(mi)

            if g['id'] in self.pinned:
                mi = Gtk.MenuItem(label='Unpin from taskbar')
                mi.connect('activate', lambda _m: self.unpin(g['id']))
            else:
                mi = Gtk.MenuItem(label='Pin to taskbar')
                mi.connect('activate', lambda _m: self.pin(g['id']))
            menu.append(mi)

            shortcut = desktop_shortcut_path(g['info'])
            mi = Gtk.MenuItem(label='Add to desktop')
            if shortcut is None or os.path.exists(shortcut):
                mi.set_sensitive(False)     # no .desktop, or already there
            else:
                mi.connect('activate',
                           lambda _m: add_to_desktop(g['info']))
            menu.append(mi)

            mi = Gtk.MenuItem(label='Hide to tray')
            mi.connect('activate', lambda _m: self.tray_tag(g['id']))
            menu.append(mi)

        if g['windows']:
            menu.append(Gtk.SeparatorMenuItem())
            # Minimize / Restore entries
            any_min = any(self.is_addr_minimized(w['address'])
                          for w in g['windows'])
            any_vis = any(not self.is_addr_minimized(w['address'])
                          for w in g['windows'])
            if any_vis:
                mi = Gtk.MenuItem(
                    label='Minimize' if len(g['windows']) == 1
                    else 'Minimize all')
                mi.connect('activate',
                           lambda _m: self.minimize_group(g))
                menu.append(mi)
            if any_min:
                mi = Gtk.MenuItem(
                    label='Restore' if len(g['windows']) == 1
                    else 'Restore all')
                mi.connect('activate',
                           lambda _m: self.restore_group(g))
                menu.append(mi)

            label = ('Close window' if len(g['windows']) == 1
                     else f"Close all {len(g['windows'])} windows")
            mi = Gtk.MenuItem(label=label)
            mi.connect('activate', lambda _m: self.close_all(g))
            menu.append(mi)

        menu.show_all()
        menu.popup_at_pointer(event)

    def minimize_group(self, g):
        for w in list(g.get('windows') or []):
            if not self.is_addr_minimized(w['address']):
                self.minimize_window(w['address'])

    def restore_group(self, g):
        for w in list(g.get('windows') or []):
            if self.is_addr_minimized(w['address']):
                self.restore_window(w['address'], focus=True)

    def pin(self, app_id):
        if app_id not in self.pinned:
            self.pinned.append(app_id)
            self.save_pinned()
            self.refresh()

    def unpin(self, app_id):
        if app_id in self.pinned:
            self.pinned.remove(app_id)
            self.save_pinned()
            self.refresh()

    def close_all(self, g):
        for w in g['windows']:
            self.close_win(w['address'])


if __name__ == '__main__':
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        sys.exit('winbar-dock: not inside a Hyprland session')
    install_theme_signal_handlers()
    install_theme_file_monitors()
    Dock()
    Gtk.main()
