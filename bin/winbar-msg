#!/usr/bin/env python3
# winbar-msg — send a command to the running winbar-dock.
#   next | prev | commit | cancel   (alt-tab switcher)
#   taskview                        (WIN+TAB overview)
#   quick                           (quick settings panel)
#   tray                            (tray overflow popup)
#   start                           (start menu w/ click-off backdrop)
#   weather                         (weather flyout)
#   weather-location                (weather flyout, location picker open)
#   net | clock                     (internet / calendar flyouts)
# Falls back to plain hyprland cycling if the dock isn't running.
# The start menu lives in winbar-dock; with no dock running, `start`
# opens it standalone via ~/.local/bin/winbar-start instead.
import os
import socket
import subprocess
import sys

cmd = sys.argv[1] if len(sys.argv) > 1 else 'next'
sock_path = os.path.join(
    os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'),
    'winbar-dock.sock')

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.sendto(cmd.encode(), sock_path)
except OSError:
    if cmd == 'next':
        subprocess.run(['hyprctl', 'dispatch', 'cyclenext'])
        subprocess.run(['hyprctl', 'dispatch', 'alterzorder', 'top'])
    elif cmd == 'prev':
        subprocess.run(['hyprctl', 'dispatch', 'cyclenext', 'prev'])
        subprocess.run(['hyprctl', 'dispatch', 'alterzorder', 'top'])
    elif cmd == 'start':
        # No dock (normal mode / bar hidden): the standalone menu. A live
        # one toggles itself closed; otherwise start one.
        try:
            s.sendto(b'start', os.path.join(os.path.dirname(sock_path),
                                            'winbar-start.sock'))
        except OSError:
            subprocess.Popen(
                ['setsid', '-f', os.path.expanduser('~/.local/bin/winbar-start')],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
    elif cmd == 'weather':
        subprocess.Popen(['xdg-open', 'https://wttr.in'])
    # minimize has no sensible fallback outside winmode / dock
